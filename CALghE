      const recommended=Math.round(total*1.3);
      const schemaDiv = document.getElementById(`schema-${this.idp}`);
      const schemaSvg = schemaDiv ? schemaDiv.innerHTML : '';
      const details={name:KIND_LABELS[this.kind], price:total, recommended, schemaSvg};
      if (this.kind==='countertop') {
