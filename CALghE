      [-0.8920,+0.6152],
      [-0.8434,+0.5344],
      [-0.8057,+0.4536],
      [-0.8056,+0.3728],
      [-0.8392,+0.2920],
      [-0.8897,+0.2113],
      [-0.9362,+0.1359],
      [-0.9854,+0.0551],
      [-1.0000,-0.0257],
      [-0.9633,-0.1065],
      [-0.9099,-0.1819],
      [-0.8611,-0.2595],
      [-0.8191,-0.3381],
      [-0.7965,-0.4242],
      [-0.8175,-0.5050],
      [-0.8653,-0.5858],
      [-0.9100,-0.6612],
      [-0.9526,-0.7404],
      [-0.9792,-0.8228],
      [-0.9754,-0.9057],
      [-0.9069,-0.9775],
      [-0.7925,-0.9871]
    ];

  // Генератор пути: масштабирует нормированный контур к (cx, cy, halfW, halfH).
  function buildTwoodWavyPath(cx, cy, halfW, halfH, scale) {
    if (scale === undefined) scale = 1;
    const W = halfW * scale;
    const H = halfH * scale;

    // Преобразуем нормированные координаты к экранным
    const pts = TWOOD_CONTOUR.map(p => [cx + p[0] * W, cy + p[1] * H]);

    // Замкнутый путь через Catmull-Rom-to-Bezier
    const n = pts.length;
    let d = `M ${pts[0][0].toFixed(2)} ${pts[0][1].toFixed(2)}`;
    for (let i = 0; i < n; i++) {
      const p0 = pts[(i - 1 + n) % n];
      const p1 = pts[i];
      const p2 = pts[(i + 1) % n];
      const p3 = pts[(i + 2) % n];
      const cp1x = p1[0] + (p2[0] - p0[0]) / 6;
      const cp1y = p1[1] + (p2[1] - p0[1]) / 6;
      const cp2x = p2[0] - (p3[0] - p1[0]) / 6;
      const cp2y = p2[1] - (p3[1] - p1[1]) / 6;
      d += ` C ${cp1x.toFixed(2)} ${cp1y.toFixed(2)}, ${cp2x.toFixed(2)} ${cp2y.toFixed(2)}, ${p2[0].toFixed(2)} ${p2[1].toFixed(2)}`;
    }
    d += ' Z';
    return d;
  }

  // Палитра LED-подсветки в зависимости от цветовой температуры (Кельвин).
  // Используется в svgMirror для рендера зеркал с включённой LED.
  //   2700K — тёплый белый (янтарный), 4500K — нейтральный, 6000K — холодный (дневной).
  function getMirrorLedPalette(temp) {
    switch (String(temp)) {
      case '4500':
        return {
          haloStops: ['#FFF6D8', '#F5E8B8', '#E8D890'],   // нейтральный белый с лёгкой кремовостью
          ledStops:  ['#FFFEF4', '#FFF6D0', '#F5E090'],
          fill:      '#FFFAE0',
          edge:      '#FFFCEC',
          reflStroke:'#FFF2C8',
          glowStop:  '#FFF2C0'
        };
      case '6000':
        return {
          haloStops: ['#E8F2FC', '#BFD8F2', '#9CC0E8'],   // холодный белый с голубым оттенком
          ledStops:  ['#F4FAFF', '#D8EAFC', '#9EC8F2'],
          fill:      '#EAF4FF',
          edge:      '#F5FAFF',
          reflStroke:'#C8DEF4',
          glowStop:  '#D4E8FF'
        };
      case '2700':
      default:
        return {
          haloStops: ['#FFE39E', '#FFD06E', '#FFC560'],   // тёплый янтарный
          ledStops:  ['#FFFBE6', '#FFE39E', '#FFC560'],
          fill:      '#FFF1B8',
          edge:      '#FFF4C8',
          reflStroke:'#FFE9A8',
          glowStop:  '#FFE9A8'
        };
    }
  }

  function svgMirror(shape, hasLight, w_mm, h_mm, opts) {
    // opts: { collection: 'coll1'|..., bodyColor: '#hex', isGlossy, isVeneer, trimColor, lightTemp }
    const collection = (opts && opts.collection) || '';
    const renderStyle = COLLECTION_RENDER_STYLES[collection] || 'default';
    const bodyColor = (opts && opts.bodyColor) || '#E8DDC8';
    const lightTemp = (opts && opts.lightTemp) || '2700';
    // Палитра LED: меняется в зависимости от выбранной цветовой температуры в Кельвинах
    const led = getMirrorLedPalette(lightTemp);

    const mirW = scaleDim(w_mm, 90, 220, 300, 2000);
    const mirH = scaleDim(h_mm, 90, 220, 300, 2000);
    const padX = 20, padY = 20;
    const totalW = Math.max(mirW, mirH) + padX*2 + 30;
    const totalH = Math.max(mirW, mirH) + padY*2 + 30;
    const cx = totalW/2, cy = totalH/2 - 8;

    let svg = `<svg viewBox="0 0 ${totalW} ${totalH}" xmlns="http://www.w3.org/2000/svg" style="width:auto;max-width:240px;max-height:240px;display:block;margin:0 auto;">`;
    svg += `<defs>
      <linearGradient id="mirGlass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#e8f1f5"/>
        <stop offset="50%" stop-color="#c8dde6"/>
        <stop offset="100%" stop-color="#a5c2cf"/>
      </linearGradient>
      <radialGradient id="mirGlow" cx="0.5" cy="0.5" r="0.6">
        <stop offset="0%" stop-color="${led.glowStop}" stop-opacity="0.7"/>
        <stop offset="100%" stop-color="${led.glowStop}" stop-opacity="0"/>
      </radialGradient>
      <!-- Яркая LED-полоса для зеркала "Элемент" (видна в зазоре между рамой и зеркалом) -->
      <radialGradient id="elemLed" cx="0.5" cy="0.5" r="0.75">
        <stop offset="0%"   stop-color="${led.ledStops[0]}" stop-opacity="1"/>
        <stop offset="55%"  stop-color="${led.ledStops[1]}" stop-opacity="1"/>
        <stop offset="100%" stop-color="${led.ledStops[2]}" stop-opacity="0.9"/>
      </radialGradient>
      <!-- Halo вокруг рамы (свет, разливающийся за её пределы) -->
      <radialGradient id="elemHalo" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0%"   stop-color="${led.haloStops[0]}" stop-opacity="0.85"/>
        <stop offset="55%"  stop-color="${led.haloStops[1]}" stop-opacity="0.45"/>
        <stop offset="100%" stop-color="${led.haloStops[2]}" stop-opacity="0"/>
      </radialGradient>
    </defs>`;

    // ==================== БЛАНКА: рама из 4 филёнок (45° запил) + зеркало с бликом ====================
    if (renderStyle === 'blanka' && shape === 'rect') {
      const frameW = Math.max(14, Math.min(mirW, mirH) * 0.10);
      const x1 = cx - mirW/2, y1 = cy - mirH/2;
      const w = mirW, h = mirH;
      const x2 = x1 + w, y2 = y1 + h;

      // Зона зеркала (отступ frameW от внешних краёв)
      const mx = x1 + frameW;
      const my = y1 + frameW;
      const mwid = w - frameW * 2;
      const mhei = h - frameW * 2;
      const mx2 = mx + mwid, my2 = my + mhei;

      // 1) Внешняя рама
      svg += `<rect x="${x1}" y="${y1}" width="${w}" height="${h}" rx="3"
        fill="${bodyColor}" stroke="#9a9a9a" stroke-width="0.8"/>`;

      // 2) ЧЕТЫРЕ ДИАГОНАЛИ 45° ЗАПИЛА — делят раму на 4 филёнки (верх/низ/лево/право)
      const mitreColor = 'rgba(0,0,0,0.55)';
      const mitreHi    = 'rgba(255,255,255,0.55)';
      svg += `<line x1="${x1}" y1="${y1}" x2="${mx}" y2="${my}"   stroke="${mitreColor}" stroke-width="0.9"/>`;
      svg += `<line x1="${x2}" y1="${y1}" x2="${mx2}" y2="${my}"  stroke="${mitreColor}" stroke-width="0.9"/>`;
      svg += `<line x1="${x2}" y1="${y2}" x2="${mx2}" y2="${my2}" stroke="${mitreColor}" stroke-width="0.9"/>`;
      svg += `<line x1="${x1}" y1="${y2}" x2="${mx}" y2="${my2}"  stroke="${mitreColor}" stroke-width="0.9"/>`;
      // Светлый блик вдоль верхне-левой диагонали (имитация фаски)
      svg += `<line x1="${x1+0.6}" y1="${y1+0.6}" x2="${mx-0.4}" y2="${my-0.4}" stroke="${mitreHi}" stroke-width="0.5"/>`;

      // 3) ФИЛЁНОЧНАЯ ФРЕЗЕРОВКА — только в центральной части каждой панели,
      // линии НЕ заходят в угол (там только митра должна быть видна).
      // Концы отступают от углов зеркала на 2*frameW — иначе кончики линий филёнок
      // создавали бы дополнительные «палочки» рядом с центральной диагональю.
      const filIns = Math.max(2.5, frameW * 0.22);
      const filGap = frameW * 2;  // отступ концов линий от углов зеркала
      const grooveColor = 'rgba(0,0,0,0.42)';
      const grooveHi    = 'rgba(255,255,255,0.50)';
      // Верхняя филёнка — две горизонтальные линии
      svg += `<line x1="${(mx+filGap).toFixed(1)}" y1="${(y1+filIns).toFixed(1)}" x2="${(mx2-filGap).toFixed(1)}" y2="${(y1+filIns).toFixed(1)}" stroke="${grooveColor}" stroke-width="0.8"/>`;
      svg += `<line x1="${(mx+filGap).toFixed(1)}" y1="${(my-filIns).toFixed(1)}" x2="${(mx2-filGap).toFixed(1)}" y2="${(my-filIns).toFixed(1)}" stroke="${grooveColor}" stroke-width="0.8"/>`;
      // Правая филёнка — две вертикальные линии
      svg += `<line x1="${(x2-filIns).toFixed(1)}" y1="${(my+filGap).toFixed(1)}" x2="${(x2-filIns).toFixed(1)}" y2="${(my2-filGap).toFixed(1)}" stroke="${grooveColor}" stroke-width="0.8"/>`;
      svg += `<line x1="${(mx2+filIns).toFixed(1)}" y1="${(my+filGap).toFixed(1)}" x2="${(mx2+filIns).toFixed(1)}" y2="${(my2-filGap).toFixed(1)}" stroke="${grooveColor}" stroke-width="0.8"/>`;
      // Нижняя филёнка
      svg += `<line x1="${(mx+filGap).toFixed(1)}" y1="${(y2-filIns).toFixed(1)}" x2="${(mx2-filGap).toFixed(1)}" y2="${(y2-filIns).toFixed(1)}" stroke="${grooveColor}" stroke-width="0.8"/>`;
      svg += `<line x1="${(mx+filGap).toFixed(1)}" y1="${(my2+filIns).toFixed(1)}" x2="${(mx2-filGap).toFixed(1)}" y2="${(my2+filIns).toFixed(1)}" stroke="${grooveColor}" stroke-width="0.8"/>`;
      // Левая филёнка
      svg += `<line x1="${(x1+filIns).toFixed(1)}" y1="${(my+filGap).toFixed(1)}" x2="${(x1+filIns).toFixed(1)}" y2="${(my2-filGap).toFixed(1)}" stroke="${grooveColor}" stroke-width="0.8"/>`;
      svg += `<line x1="${(mx-filIns).toFixed(1)}" y1="${(my+filGap).toFixed(1)}" x2="${(mx-filIns).toFixed(1)}" y2="${(my2-filGap).toFixed(1)}" stroke="${grooveColor}" stroke-width="0.8"/>`;
      // Светлый блик (тоже укорочен — только в центральной части)
      svg += `<line x1="${(mx+filGap+1).toFixed(1)}" y1="${(y1+filIns+0.5).toFixed(1)}" x2="${(mx2-filGap-1).toFixed(1)}" y2="${(y1+filIns+0.5).toFixed(1)}" stroke="${grooveHi}" stroke-width="0.5"/>`;
      svg += `<line x1="${(x1+filIns+0.5).toFixed(1)}" y1="${(my+filGap+1).toFixed(1)}" x2="${(x1+filIns+0.5).toFixed(1)}" y2="${(my2-filGap-1).toFixed(1)}" stroke="${grooveHi}" stroke-width="0.5"/>`;

      // 4) ЗЕРКАЛЬНОЕ ПОЛОТНО внутри рамы
      if (mwid > 8 && mhei > 8) {
        svg += `<rect x="${mx}" y="${my}" width="${mwid}" height="${mhei}" rx="1.5"
          fill="url(#mirGlass)" stroke="${STROKE}" stroke-width="0.6"/>`;
        // Блик-«палочка» в верхне-левом углу зеркала (как у Элемента, такой же параллелограмм)
        svg += `<polygon points="
          ${mx + mwid*0.10},${my + mhei*0.08}
          ${mx + mwid*0.42},${my + mhei*0.08}
          ${mx + mwid*0.55},${my + mhei*0.42}
          ${mx + mwid*0.20},${my + mhei*0.42}
        " fill="white" opacity="0.42"/>`;
      }

      svg += `</svg>`;
      return svg;
    }

    // ==================== ЭЛЕМЕНТ: узкая рама с 45° запилом + утопленное зеркало + LED ====================
    if (renderStyle === 'element' && shape === 'rect') {
      // Цвет рамы: единый дефолт всех коллекций (#E8DDC8) либо выбранный материал
      const frameColor = bodyColor;
      const isGlossy = !!(opts && opts.isGlossy);
      const isVeneer = !!(opts && opts.isVeneer);

      const x1 = cx - mirW/2, y1 = cy - mirH/2;
      const w = mirW, h = mirH;
      const minSide = Math.min(w, h);

      // Узкая рама (~4% от меньшей стороны — тоньше прежнего)
      const frameW = Math.max(6, minSide * 0.04);
      // Зазор между рамой и зеркалом — с подсветкой тоньше прежнего (LED-полоса узкая)
      const ledGap = hasLight ? Math.max(4, frameW * 0.5) : Math.max(2, frameW * 0.18);

      // 0) HALO — мягкое свечение, выходящее за пределы рамы (только при включённом LED)
      // Рисуется ПЕРВЫМ, чтобы рама легла поверх и halo остался виден только по краям.
      if (hasLight) {
        const haloPad = Math.max(7, minSide * 0.07);
        svg += `<rect x="${x1 - haloPad}" y="${y1 - haloPad}"
          width="${w + haloPad*2}" height="${h + haloPad*2}"
          rx="${haloPad*0.6}"
          fill="url(#elemHalo)" opacity="0.9"/>`;
      }

      // 1) Внешняя рама (заливка по всей площади — углы рисуем поверх)
      svg += `<rect x="${x1}" y="${y1}" width="${w}" height="${h}" rx="1.5"
        fill="${frameColor}" stroke="rgba(0,0,0,0.30)" stroke-width="0.6"/>`;

      // 2) Текстура: для шпона — горизонтальные волокна; для глянца — мягкий блик сверху
      if (isVeneer) {
        const grainCount = 5;
        for (let i = 1; i <= grainCount; i++) {
          const gy = y1 + (h / (grainCount + 1)) * i;
          svg += `<line x1="${x1+1}" y1="${gy}" x2="${x1+w-1}" y2="${gy}"
            stroke="rgba(0,0,0,0.10)" stroke-width="0.6"/>`;
        }
      } else if (isGlossy) {
        svg += `<rect x="${x1}" y="${y1}" width="${w}" height="${h*0.30}" fill="white" opacity="0.12"/>`;
      }

      // 3) Координаты внутреннего проёма (где сидит зеркало)
      const recX = x1 + frameW;
      const recY = y1 + frameW;
      const recW = w - frameW * 2;
      const recH = h - frameW * 2;

      // 4) Линии 45° запила в углах (от внешних углов к внутренним)
      svg += `<line x1="${x1}"   y1="${y1}"   x2="${recX}"      y2="${recY}"      stroke="rgba(0,0,0,0.45)" stroke-width="0.7"/>`;
      svg += `<line x1="${x1+w}" y1="${y1}"   x2="${recX+recW}" y2="${recY}"      stroke="rgba(0,0,0,0.45)" stroke-width="0.7"/>`;
      svg += `<line x1="${x1+w}" y1="${y1+h}" x2="${recX+recW}" y2="${recY+recH}" stroke="rgba(0,0,0,0.45)" stroke-width="0.7"/>`;
      svg += `<line x1="${x1}"   y1="${y1+h}" x2="${recX}"      y2="${recY+recH}" stroke="rgba(0,0,0,0.45)" stroke-width="0.7"/>`;

      // 5) Дно проёма
      if (hasLight && recW > 6 && recH > 6) {
        // Яркая LED-заливка — будет видна через зазор как светящаяся полоса вокруг зеркала
        // Цвет берётся из палитры в зависимости от выбранной температуры (К)
        svg += `<rect x="${recX}" y="${recY}" width="${recW}" height="${recH}"
          fill="${led.fill}"/>`;
        svg += `<rect x="${recX}" y="${recY}" width="${recW}" height="${recH}"
          fill="url(#elemLed)" opacity="0.95"/>`;
        // Чёткая яркая кромка по периметру recess (граница LED-ленты)
        svg += `<rect x="${recX+0.4}" y="${recY+0.4}" width="${recW-0.8}" height="${recH-0.8}"
          fill="none" stroke="${led.edge}" stroke-width="1.4" opacity="1"/>`;
      } else {
        // Без LED — тёмная утопленная плоскость
        svg += `<rect x="${recX}" y="${recY}" width="${recW}" height="${recH}"
          fill="rgba(0,0,0,0.42)" stroke="rgba(0,0,0,0.35)" stroke-width="0.5"/>`;
      }

      // 6) Зеркало (отступает от рамы на ledGap — в этом зазоре светится LED)
      const mx = recX + ledGap;
      const my = recY + ledGap;
      const mwid = recW - ledGap * 2;
      const mhei = recH - ledGap * 2;
      if (mwid > 4 && mhei > 4) {
        svg += `<rect x="${mx}" y="${my}" width="${mwid}" height="${mhei}"
          fill="url(#mirGlass)" stroke="${STROKE}" stroke-width="0.5"/>`;
        // Мягкое отражение света на краях зеркала (только при LED) — цвет тоже зависит от температуры
        if (hasLight) {
          svg += `<rect x="${mx + 0.5}" y="${my + 0.5}" width="${mwid - 1}" height="${mhei - 1}"
            fill="none" stroke="${led.reflStroke}" stroke-width="${Math.max(1, ledGap*0.35)}" opacity="0.45"/>`;
        }
        // Блик
        svg += `<polygon points="
          ${mx + mwid*0.10},${my + mhei*0.08}
          ${mx + mwid*0.42},${my + mhei*0.08}
          ${mx + mwid*0.55},${my + mhei*0.42}
          ${mx + mwid*0.20},${my + mhei*0.42}
        " fill="white" opacity="0.30"/>`;
      }

      svg += `</svg>`;
      return svg;
    }

    // ==================== АТЛАС: капсульная (pill/stadium) форма с КВАРЦЕВОЙ рамой ====================
    if (renderStyle === 'atlas') {
      const isQuartz = !!(opts && opts.isQuartz);
      const frameColor = bodyColor;

      // Рама ~14% от меньшей стороны
      const frameW = Math.max(20, Math.min(mirW, mirH) * 0.14);
      const x1 = cx - mirW/2, y1 = cy - mirH/2;
      const w = mirW, h = mirH;
      // Радиус скругления капсулы — половина меньшей стороны (классическая stadium-форма)
      const Router = Math.min(w, h) / 2;
      // Внутренние размеры (зеркало)
      const ix = x1 + frameW, iy = y1 + frameW;
      const iw = w - frameW * 2, ih = h - frameW * 2;
      const Rinner = Math.min(iw, ih) / 2;

      const uid = `at${cx.toFixed(0)}_${cy.toFixed(0)}`;

      // Подложка для кварцевой текстуры — generates marble veining via gradient + noise paths
      svg += `<defs>
        <linearGradient id="${uid}_base" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="${frameColor}"/>
          <stop offset="50%" stop-color="${frameColor}" stop-opacity="0.95"/>
          <stop offset="100%" stop-color="${frameColor}" stop-opacity="0.85"/>
        </linearGradient>
        <radialGradient id="${uid}_sheen" cx="0.3" cy="0.2" r="0.7">
          <stop offset="0%" stop-color="white" stop-opacity="0.20"/>
          <stop offset="100%" stop-color="white" stop-opacity="0"/>
        </radialGradient>
        <clipPath id="${uid}_clip">
          <rect x="${x1}" y="${y1}" width="${w}" height="${h}" rx="${Router}" ry="${Router}"/>
        </clipPath>
      </defs>`;

      // 1) Внешний контур рамы (капсула)
      svg += `<rect x="${x1}" y="${y1}" width="${w}" height="${h}" rx="${Router}" ry="${Router}"
        fill="url(#${uid}_base)" stroke="rgba(0,0,0,0.32)" stroke-width="0.7"/>`;

      // 2) Кварцевая текстура — мраморные прожилки + зернистость
      if (isQuartz) {
        svg += `<g clip-path="url(#${uid}_clip)" opacity="0.55">`;
        // Случайные «прожилки» — серые плавные линии
        const veinSeed = (cx + cy) % 100;
        const veinCount = 14;
        for (let i = 0; i < veinCount; i++) {
          const phase = (i * 31.7 + veinSeed) * 0.1;
          const startX = x1 + ((Math.sin(phase) + 1) / 2) * w;
          const startY = y1 + ((Math.cos(phase * 1.3) + 1) / 2) * h;
          const endX = x1 + ((Math.sin(phase * 0.8 + 1.5) + 1) / 2) * w;
          const endY = y1 + ((Math.cos(phase * 0.7 + 0.7) + 1) / 2) * h;
          const ctrl1X = (startX + endX) / 2 + Math.sin(phase * 2) * 25;
          const ctrl1Y = (startY + endY) / 2 + Math.cos(phase * 2.5) * 25;
          const opacity = 0.15 + (i % 3) * 0.10;
          const thickness = 0.4 + (i % 3) * 0.4;
          svg += `<path d="M ${startX.toFixed(1)} ${startY.toFixed(1)} Q ${ctrl1X.toFixed(1)} ${ctrl1Y.toFixed(1)}, ${endX.toFixed(1)} ${endY.toFixed(1)}"
            fill="none" stroke="rgba(70,70,70,${opacity.toFixed(2)})" stroke-width="${thickness}"/>`;
        }
        // Мелкие пятна-крапинки
        for (let i = 0; i < 25; i++) {
          const phase = (i * 17.3 + veinSeed) * 0.1;
          const sx = x1 + ((Math.sin(phase * 2) + 1) / 2) * w;
          const sy = y1 + ((Math.cos(phase * 1.7) + 1) / 2) * h;
          const r = 0.8 + (i % 4) * 0.5;
          svg += `<circle cx="${sx.toFixed(1)}" cy="${sy.toFixed(1)}" r="${r.toFixed(1)}" fill="rgba(50,50,50,0.18)"/>`;
        }
        svg += `</g>`;
      }

      // 3) Глянцевая поверхность кварца (radial gradient)
      svg += `<rect x="${x1}" y="${y1}" width="${w}" height="${h}" rx="${Router}" ry="${Router}" fill="url(#${uid}_sheen)"/>`;

      // 4) Внутренний край рамы (тёмная тонкая обводка проёма)
      svg += `<rect x="${ix}" y="${iy}" width="${iw}" height="${ih}" rx="${Rinner}" ry="${Rinner}"
        fill="none" stroke="rgba(0,0,0,0.40)" stroke-width="0.8"/>`;

      // 5) Зеркало
      svg += `<rect x="${ix}" y="${iy}" width="${iw}" height="${ih}" rx="${Rinner}" ry="${Rinner}"
        fill="url(#mirGlass)" stroke="${STROKE}" stroke-width="0.6"/>`;
      // Блик на зеркале
      svg += `<polygon points="
        ${ix + iw*0.15},${iy + ih*0.10}
        ${ix + iw*0.50},${iy + ih*0.10}
        ${ix + iw*0.60},${iy + ih*0.30}
        ${ix + iw*0.25},${iy + ih*0.30}
      " fill="white" opacity="0.30"/>`;

      svg += `</svg>`;
      return svg;
    }

    // ==================== ВЕРТЕКС: асимметричное «трёхугольное» зеркало с LED ====================
    if (renderStyle === 'vertex') {
      const isGlossy = !!(opts && opts.isGlossy);
      const frameColor = bodyColor;

      // Контур — 3 скруглённых угла, нормировано к [-1, +1] × [-1, +1].
      // Углы и контрольные точки подобраны по фото: верхний-левый, верхний-правый, нижний (чуть правее центра).
      // Каждая пара (anchor, control1, control2, anchor) — кубическая Безье-кривая.
      // Используется тот же путь для рамы и зеркала: фрейм рисуется ОБВОДКОЙ, LED-гало — увеличенной копией.
      const halfW = mirW / 2, halfH = mirH / 2;
      const SX = halfW, SY = halfH;
      // Нормированный путь (clockwise: top-left → top-right → bottom → top-left)
      const buildVertexPath = (sx, sy) => {
        // 3 опорных угла:
        const A = [-1.00 * sx + cx, -0.55 * sy + cy];   // top-left
        const B = [ 1.00 * sx + cx, -0.95 * sy + cy];   // top-right
        const C = [ 0.10 * sx + cx,  1.00 * sy + cy];   // bottom
        // Контрольные точки для каждой стороны (выпуклость наружу относительно центроида):
        // AB (верх): чуть выгибается вверх-вправо
        const cAB1 = [-0.45 * sx + cx, -0.85 * sy + cy];
        const cAB2 = [ 0.50 * sx + cx, -1.10 * sy + cy];
        // BC (правый бок + низ): сильно выгибается вправо
        const cBC1 = [ 1.20 * sx + cx, -0.30 * sy + cy];
        const cBC2 = [ 0.80 * sx + cx,  0.55 * sy + cy];
        // CA (левый бок): выгибается влево
        const cCA1 = [-0.35 * sx + cx,  0.85 * sy + cy];
        const cCA2 = [-0.95 * sx + cx,  0.25 * sy + cy];
        return `M ${A[0].toFixed(2)} ${A[1].toFixed(2)} ` +
               `C ${cAB1[0].toFixed(2)} ${cAB1[1].toFixed(2)}, ${cAB2[0].toFixed(2)} ${cAB2[1].toFixed(2)}, ${B[0].toFixed(2)} ${B[1].toFixed(2)} ` +
               `C ${cBC1[0].toFixed(2)} ${cBC1[1].toFixed(2)}, ${cBC2[0].toFixed(2)} ${cBC2[1].toFixed(2)}, ${C[0].toFixed(2)} ${C[1].toFixed(2)} ` +
               `C ${cCA1[0].toFixed(2)} ${cCA1[1].toFixed(2)}, ${cCA2[0].toFixed(2)} ${cCA2[1].toFixed(2)}, ${A[0].toFixed(2)} ${A[1].toFixed(2)} ` +
               `Z`;
      };

      const mirrorPath = buildVertexPath(SX * 0.92, SY * 0.92);  // зеркало (рама ~8% по периметру)
      const frameOuterPath = buildVertexPath(SX, SY);            // внешний край рамы

      // Палитра LED по температуре (используется уже существующий хелпер)
      const led = getMirrorLedPalette(opts && opts.lightTemp);
      const uid = `vx${cx.toFixed(0)}_${cy.toFixed(0)}`;

      // 1) LED-гало вокруг зеркала (если включён)
      if (hasLight) {
        // Внешнее свечение: заполненный путь, увеличенный, размытый
        svg += `<defs>
          <radialGradient id="${uid}_glow" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0%" stop-color="${led.haloStops[0]}" stop-opacity="0.9"/>
            <stop offset="60%" stop-color="${led.haloStops[1]}" stop-opacity="0.5"/>
            <stop offset="100%" stop-color="${led.haloStops[2]}" stop-opacity="0"/>
          </radialGradient>
          <filter id="${uid}_blur" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="6"/></filter>
        </defs>`;
        // Размытое свечение (увеличенный контур наружу)
        svg += `<path d="${buildVertexPath(SX * 1.06, SY * 1.06)}" fill="${led.haloStops[1]}" opacity="0.7" filter="url(#${uid}_blur)"/>`;
        svg += `<path d="${buildVertexPath(SX * 1.03, SY * 1.03)}" fill="${led.fill}" opacity="0.8" filter="url(#${uid}_blur)"/>`;
      }

      // 2) Внешний контур рамы (тонкая крашеная окантовка)
      const frameStroke = isGlossy ? 8 : 7;
      svg += `<path d="${frameOuterPath}" fill="${frameColor}" stroke="${frameColor}" stroke-width="0.5"/>`;

      // 3) Зеркало
      svg += `<path d="${mirrorPath}" fill="url(#mirGlass)" stroke="${STROKE}" stroke-width="0.5"/>`;

      // 4) Внутренний светящийся ободок при включённой подсветке (между рамой и зеркалом)
      if (hasLight) {
        svg += `<path d="${buildVertexPath(SX * 0.94, SY * 0.94)}" fill="none" stroke="${led.reflStroke}" stroke-width="2.5" opacity="0.95"/>`;
      }

      // 5) Глянец на раме (если выбран глянцевый материал)
      if (isGlossy) {
        const glossId = `${uid}_gloss`;
        svg += `<defs><linearGradient id="${glossId}" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="white" stop-opacity="0.20"/><stop offset="100%" stop-color="white" stop-opacity="0"/></linearGradient></defs>`;
        svg += `<path d="${frameOuterPath}" fill="url(#${glossId})"/>`;
      }

      // 6) Блик на зеркале (полигон в верхне-левой четверти, в пределах формы)
      svg += `<polygon points="
        ${cx - SX*0.55},${cy - SY*0.40}
        ${cx + SX*0.05},${cy - SY*0.55}
        ${cx + SX*0.10},${cy - SY*0.20}
        ${cx - SX*0.45},${cy - SY*0.10}
      " fill="white" opacity="0.30"/>`;

      svg += `</svg>`;
      return svg;
    }

    // ==================== ЭРИАДОР: круглое зеркало с радиальной фрезеровкой по раме ====================
    if (renderStyle === 'eridator') {
      const isGlossy = !!(opts && opts.isGlossy);
      const isVeneer = !!(opts && opts.isVeneer);
      const frameColor = bodyColor;
      // Используем меньшую сторону как диаметр — зеркало круглое
      const D = Math.min(mirW, mirH);
      const Router = D / 2;                 // внешний радиус рамы
      const Rinner = Router * 0.72;         // внутренний радиус (край зеркала) — рама ~28% радиуса
      const RfluteOut = Router * 0.985;     // внешний край канавок (чуть отступ от края)
      const RfluteIn  = Rinner * 1.02;      // внутренний край канавок (чуть отступ от зеркала)

      // 1) Внешний круг рамы
      svg += `<circle cx="${cx}" cy="${cy}" r="${Router}" fill="${frameColor}" stroke="rgba(0,0,0,0.30)" stroke-width="0.7"/>`;

      // 2) Радиальные канавки (фрезеровка) — частые тонкие линии по всему периметру
      // Количество пропорционально окружности, чтобы плотность не зависела от размера
      const fluteCount = 96;  // ~3.75° между канавками
      svg += `<g opacity="${isVeneer ? 0.45 : 0.55}">`;
      for (let i = 0; i < fluteCount; i++) {
        const angle = (i / fluteCount) * Math.PI * 2;
        const ca = Math.cos(angle), sa = Math.sin(angle);
        const x1 = cx + ca * RfluteIn;
        const y1 = cy + sa * RfluteIn;
        const x2 = cx + ca * RfluteOut;
        const y2 = cy + sa * RfluteOut;
        // Тёмная линия — тень канавки
        svg += `<line x1="${x1.toFixed(2)}" y1="${y1.toFixed(2)}" x2="${x2.toFixed(2)}" y2="${y2.toFixed(2)}" stroke="rgba(0,0,0,0.35)" stroke-width="0.7"/>`;
        // Светлая параллельная линия со сдвигом — блик ребра
        const ox = -sa * 1.2, oy = ca * 1.2;
        svg += `<line x1="${(x1+ox).toFixed(2)}" y1="${(y1+oy).toFixed(2)}" x2="${(x2+ox).toFixed(2)}" y2="${(y2+oy).toFixed(2)}" stroke="rgba(255,255,255,0.45)" stroke-width="0.5"/>`;
      }
      svg += `</g>`;

      // 3) Шпон (если выбран) — поверх канавок добавляются концентрические годовые кольца
      if (isVeneer) {
        const ringCount = 6;
        for (let i = 1; i <= ringCount; i++) {
          const r = Rinner + (Router - Rinner) * (i / (ringCount + 1));
          svg += `<circle cx="${cx}" cy="${cy}" r="${r.toFixed(2)}" fill="none" stroke="rgba(0,0,0,0.10)" stroke-width="0.4"/>`;
        }
      }
      // 3b) Глянец — лёгкий блик в верхней четверти рамы
      if (isGlossy) {
        const glossId = `eridGloss${cx.toFixed(0)}_${cy.toFixed(0)}`;
        svg += `<defs><radialGradient id="${glossId}" cx="0.35" cy="0.20" r="0.6"><stop offset="0%" stop-color="white" stop-opacity="0.35"/><stop offset="100%" stop-color="white" stop-opacity="0"/></radialGradient></defs>`;
        svg += `<circle cx="${cx}" cy="${cy}" r="${Router}" fill="url(#${glossId})"/>`;
      }

      // 4) Внутренний край рамы (ободок около зеркала, тёмная тонкая линия)
      svg += `<circle cx="${cx}" cy="${cy}" r="${Rinner}" fill="none" stroke="rgba(0,0,0,0.35)" stroke-width="0.8"/>`;

      // 5) Зеркало
      svg += `<circle cx="${cx}" cy="${cy}" r="${Rinner}" fill="url(#mirGlass)" stroke="${STROKE}" stroke-width="0.6"/>`;
      // Блик на зеркале (полигон в верхне-левой четверти)
      svg += `<polygon points="
        ${cx - Rinner*0.55},${cy - Rinner*0.50}
        ${cx + Rinner*0.05},${cy - Rinner*0.50}
        ${cx + Rinner*0.20},${cy - Rinner*0.10}
        ${cx - Rinner*0.40},${cy - Rinner*0.10}
      " fill="white" opacity="0.30"/>`;

      svg += `</svg>`;
      return svg;
    }

    // ==================== Т-ВУД: волнистая форма, два слоя (внешний + внутренний) ====================
    if (renderStyle === 'twood') {
      // Цвета и материалы двух слоёв (берутся из opts; если не заданы — единый дефолт)
      const outerColor = (opts && opts.twoodOuterColor) || bodyColor;
      const innerColor = (opts && opts.twoodInnerColor) || bodyColor;
      const outerVeneer = !!(opts && opts.twoodOuterVeneer);
      const innerVeneer = !!(opts && opts.twoodInnerVeneer);
      const outerGlossy = !!(opts && opts.twoodOuterGlossy);
      const innerGlossy = !!(opts && opts.twoodInnerGlossy);

      const halfW = mirW / 2;
      const halfH = mirH / 2;

      // Три вложенных волнистых контура (одна и та же фаза → выглядят как уменьшенные копии)
      const outerPath  = buildTwoodWavyPath(cx, cy, halfW, halfH, 1.00, 0);
      const innerPath  = buildTwoodWavyPath(cx, cy, halfW, halfH, 0.86, 0);
      const mirrorPath = buildTwoodWavyPath(cx, cy, halfW, halfH, 0.72, 0);

      // Уникальные ID для clip-path внутри SVG (для текстуры шпона по форме слоя)
      const uid = `tw${Math.floor(cx)}${Math.floor(cy)}`;

      // 1) Внешний слой
      svg += `<path d="${outerPath}" fill="${outerColor}" stroke="rgba(0,0,0,0.32)" stroke-width="0.7"/>`;
      if (outerVeneer) {
        // Текстура шпона — горизонтальные волокна, обрезанные внешним контуром
        svg += `<clipPath id="${uid}_o"><path d="${outerPath}"/></clipPath>`;
        svg += `<g clip-path="url(#${uid}_o)">`;
        const grainCount = 9;
        for (let i = 1; i <= grainCount; i++) {
          const gy = cy - halfH + (mirH / (grainCount + 1)) * i;
          svg += `<line x1="${cx-halfW-15}" y1="${gy}" x2="${cx+halfW+15}" y2="${gy}"
            stroke="rgba(0,0,0,0.14)" stroke-width="0.7"/>`;
        }
        svg += `</g>`;
      } else if (outerGlossy) {
        // Лёгкий блик на крашеном глянцевом внешнем слое
        svg += `<clipPath id="${uid}_og"><path d="${outerPath}"/></clipPath>`;
        svg += `<rect x="${cx-halfW}" y="${cy-halfH}" width="${mirW}" height="${mirH*0.30}"
          fill="white" opacity="0.13" clip-path="url(#${uid}_og)"/>`;
      }

      // 2) Внутренний слой (рамка вокруг зеркала)
      svg += `<path d="${innerPath}" fill="${innerColor}" stroke="rgba(0,0,0,0.20)" stroke-width="0.5"/>`;
      if (innerVeneer) {
        svg += `<clipPath id="${uid}_i"><path d="${innerPath}"/></clipPath>`;
        svg += `<g clip-path="url(#${uid}_i)">`;
        const grainCount = 7;
        for (let i = 1; i <= grainCount; i++) {
          const gy = cy - halfH*0.86 + (mirH*0.86 / (grainCount + 1)) * i;
          svg += `<line x1="${cx-halfW-15}" y1="${gy}" x2="${cx+halfW+15}" y2="${gy}"
            stroke="rgba(0,0,0,0.12)" stroke-width="0.55"/>`;
        }
        svg += `</g>`;
      } else if (innerGlossy) {
        svg += `<clipPath id="${uid}_ig"><path d="${innerPath}"/></clipPath>`;
        svg += `<rect x="${cx-halfW*0.86}" y="${cy-halfH*0.86}" width="${mirW*0.86}" height="${mirH*0.86*0.30}"
          fill="white" opacity="0.13" clip-path="url(#${uid}_ig)"/>`;
      }

      // 3) Зеркало (волнистая форма)
      svg += `<path d="${mirrorPath}" fill="url(#mirGlass)" stroke="${STROKE}" stroke-width="0.6"/>`;
      // Блик на зеркале (компактный полигон в верхне-левой части)
      svg += `<polygon points="
        ${cx - mirW*0.28},${cy - mirH*0.30}
        ${cx + mirW*0.04},${cy - mirH*0.30}
        ${cx + mirW*0.13},${cy - mirH*0.05}
        ${cx - mirW*0.20},${cy - mirH*0.05}
      " fill="white" opacity="0.30"/>`;

      svg += `</svg>`;
      return svg;
    }

    // ==================== АВАЛОН: металлическая рама + крашеный МДФ + зеркало ====================
    if (renderStyle === 'avalon' && shape === 'rect') {
      const trimKey = (opts && opts.trimColor) || 'gold';
      const trim = (typeof TRIM_COLORS !== 'undefined' && TRIM_COLORS[trimKey]) ? TRIM_COLORS[trimKey] : '#C6A43B';
      // МДФ-вставка: единый дефолт всех коллекций (#E8DDC8) либо выбранный материал
      const mdfColor = bodyColor;

      const x1 = cx - mirW/2, y1 = cy - mirH/2;
      const w = mirW, h = mirH;
      const minSide = Math.min(w, h);

      // Толщины (пропорциональны меньшей стороне зеркала)
      const outerTrim = Math.max(2.5, minSide * 0.013);   // внешняя металлическая рамка
      const mdfBand  = Math.max(14,  minSide * 0.14);     // ширина МДФ-вставки
      const innerTrim = Math.max(2,  minSide * 0.011);    // внутренняя металлическая рамка вокруг зеркала

      // 1) Базовая пластина — золото/серебро (служит и внешней рамкой)
      svg += `<rect x="${x1}" y="${y1}" width="${w}" height="${h}" rx="2"
        fill="${trim}" stroke="rgba(0,0,0,0.32)" stroke-width="0.6"/>`;
      // Лёгкий блик сверху на металле
      svg += `<rect x="${x1}" y="${y1}" width="${w}" height="${Math.max(2, h*0.04)}"
        fill="white" opacity="0.18"/>`;

      // 2) МДФ-вставка (крашеная)
      const mdfX = x1 + outerTrim;
      const mdfY = y1 + outerTrim;
      const mdfW = w - outerTrim * 2;
      const mdfH = h - outerTrim * 2;
      svg += `<rect x="${mdfX}" y="${mdfY}" width="${mdfW}" height="${mdfH}"
        fill="${mdfColor}" stroke="rgba(0,0,0,0.18)" stroke-width="0.4"/>`;

      // 3) Внутренняя металлическая рамка вокруг зеркала
      const inX = x1 + outerTrim + (mdfBand - innerTrim);
      const inY = y1 + outerTrim + (mdfBand - innerTrim);
      const inW = w - 2 * (outerTrim + mdfBand - innerTrim);
      const inH = h - 2 * (outerTrim + mdfBand - innerTrim);

      if (inW > 8 && inH > 8) {
        svg += `<rect x="${inX}" y="${inY}" width="${inW}" height="${inH}" fill="${trim}"/>`;

        // Зеркальное полотно
        const mx = inX + innerTrim;
        const my = inY + innerTrim;
        const mwid = inW - innerTrim * 2;
        const mhei = inH - innerTrim * 2;
        if (mwid > 4 && mhei > 4) {
          svg += `<rect x="${mx}" y="${my}" width="${mwid}" height="${mhei}"
            fill="url(#mirGlass)" stroke="${STROKE}" stroke-width="0.6"/>`;
          // Блик
          svg += `<polygon points="
            ${mx + mwid*0.10},${my + mhei*0.08}
            ${mx + mwid*0.42},${my + mhei*0.08}
            ${mx + mwid*0.55},${my + mhei*0.42}
            ${mx + mwid*0.20},${my + mhei*0.42}
          " fill="white" opacity="0.30"/>`;
        }

        // 4) Декоративные перемычки на МДФ-вставке — крестом сверху/снизу/слева/справа (как на референсе)
        const midX = x1 + w/2;
        const midY = y1 + h/2;
        const barW = innerTrim;
        // Верхняя перемычка (вертикальная: от верха МДФ до верха внутренней рамки)
        if (inY - mdfY > 2) {
          svg += `<rect x="${midX - barW/2}" y="${mdfY}" width="${barW}" height="${inY - mdfY}" fill="${trim}"/>`;
        }
        // Нижняя перемычка (вертикальная)
        const inBottomY = inY + inH;
        const mdfBottomY = mdfY + mdfH;
        if (mdfBottomY - inBottomY > 2) {
          svg += `<rect x="${midX - barW/2}" y="${inBottomY}" width="${barW}" height="${mdfBottomY - inBottomY}" fill="${trim}"/>`;
        }
        // Левая перемычка (горизонтальная: от левого края МДФ до левого края внутренней рамки)
        if (inX - mdfX > 2) {
          svg += `<rect x="${mdfX}" y="${midY - barW/2}" width="${inX - mdfX}" height="${barW}" fill="${trim}"/>`;
        }
        // Правая перемычка (горизонтальная)
        const inRightX = inX + inW;
        const mdfRightX = mdfX + mdfW;
        if (mdfRightX - inRightX > 2) {
          svg += `<rect x="${inRightX}" y="${midY - barW/2}" width="${mdfRightX - inRightX}" height="${barW}" fill="${trim}"/>`;
        }
      }

      svg += `</svg>`;
      return svg;
    }

    // ==================== СТАНДАРТНЫЙ РЕНДЕР (все остальные коллекции) ====================
    if (shape === 'circle') {
      const r = Math.min(mirW, mirH) / 2;
      if (hasLight) {
        // Halo побольше + ярче (3-стоповый градиент elemHalo вместо плоского mirGlow)
        svg += `<circle cx="${cx}" cy="${cy}" r="${r+24}" fill="url(#elemHalo)"/>`;
        svg += `<circle cx="${cx}" cy="${cy}" r="${r+7}" fill="none" stroke="${led.reflStroke}" stroke-width="3" opacity="0.95"/>`;
      }
      svg += `<circle cx="${cx}" cy="${cy}" r="${r+2}" fill="none" stroke="#888" stroke-width="2"/>`;
      svg += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="url(#mirGlass)" stroke="${STROKE}" stroke-width="0.8"/>`;
      svg += `<ellipse cx="${cx-r*0.35}" cy="${cy-r*0.35}" rx="${r*0.5}" ry="${r*0.18}" fill="white" opacity="0.4" transform="rotate(-30 ${cx-r*0.35} ${cy-r*0.35})"/>`;
    } else if (shape === 'oval') {
      const rx = mirW/2, ry = mirH/2;
      if (hasLight) {
        svg += `<ellipse cx="${cx}" cy="${cy}" rx="${rx+20}" ry="${ry+20}" fill="url(#elemHalo)"/>`;
        svg += `<ellipse cx="${cx}" cy="${cy}" rx="${rx+7}" ry="${ry+7}" fill="none" stroke="${led.reflStroke}" stroke-width="3" opacity="0.95"/>`;
      }
      svg += `<ellipse cx="${cx}" cy="${cy}" rx="${rx+2}" ry="${ry+2}" fill="none" stroke="#888" stroke-width="2"/>`;
      svg += `<ellipse cx="${cx}" cy="${cy}" rx="${rx}" ry="${ry}" fill="url(#mirGlass)" stroke="${STROKE}" stroke-width="0.8"/>`;
      svg += `<ellipse cx="${cx-rx*0.3}" cy="${cy-ry*0.4}" rx="${rx*0.4}" ry="${ry*0.12}" fill="white" opacity="0.4" transform="rotate(-30 ${cx-rx*0.3} ${cy-ry*0.4})"/>`;
    } else {
      const x1 = cx - mirW/2, y1 = cy - mirH/2;
      const w = mirW, h = mirH;
      if (hasLight) {
        svg += `<rect x="${x1-18}" y="${y1-18}" width="${w+36}" height="${h+36}" rx="14" fill="url(#elemHalo)"/>`;
        svg += `<rect x="${x1-6}" y="${y1-6}" width="${w+12}" height="${h+12}" rx="7" fill="none" stroke="${led.reflStroke}" stroke-width="3" opacity="0.95"/>`;
      }
      svg += `<rect x="${x1-2}" y="${y1-2}" width="${w+4}" height="${h+4}" rx="5" fill="none" stroke="#888" stroke-width="2"/>`;
      svg += `<rect x="${x1}" y="${y1}" width="${w}" height="${h}" rx="4" fill="url(#mirGlass)" stroke="${STROKE}" stroke-width="0.8"/>`;
      svg += `<polygon points="${x1+10},${y1+8} ${x1+w*0.4},${y1+8} ${x1+w*0.6},${y1+h*0.5} ${x1+w*0.2},${y1+h*0.5}" fill="white" opacity="0.3"/>`;
    }

    svg += `</svg>`;
    return svg;
  }

  function showSchema(containerId, svgContent) {
    const el = document.getElementById(containerId);
    if (!el) return;
    el.innerHTML = svgContent;
    el.style.display = 'block';
  }
  function hideSchema(containerId) {
    const el = document.getElementById(containerId);
    if (el) { el.innerHTML = ''; el.style.display = 'none'; }
  }

