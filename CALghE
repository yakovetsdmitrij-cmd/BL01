        if (tapHoleSel) details.tapHole = tapHoleSel.value === 'yes' ? 'С отверстием' : 'Без отверстия';
        const sinkPosSel = document.getElementById(`${this.idp}-sink-pos`);
        if (sinkPosSel && sinkType) {
