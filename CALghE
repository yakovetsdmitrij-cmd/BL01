    getBasePrice() {
      if (!this.currentModel) return null;
      const w=parseFloat(this.widthInput.value), d=parseFloat(this.depthInput.value), h=parseFloat(this.heightInput.value);
      if (isNaN(w)||isNaN(d)||isNaN(h)) return null;
      if (!isInRanges(w,this.currentModel.width)||!isInRanges(d,this.currentModel.depth)||!isInRanges(h,this.currentModel.height)) return null;

      // Для коллекций, скрывающих стандартный finishType (Элемент, Эриадор, Авалон, Вертекс, Атлас),
      // цена должна реагировать на их собственные селекторы материала корпуса.
      // Берём активный коллекционный селект, иначе fallback на this.finishType.
      let materialKey = this.finishType ? this.finishType.value : '';
      let collectionMatRequired = false;  // флаг "виден коллекционный селект, но материал пуст"

      if (this.elBlock && this.elBlock.style.display !== 'none' && this.elBodyMatSelect) {
        if (this.elBodyMatSelect.value) materialKey = this.elBodyMatSelect.value;
        else collectionMatRequired = true;
      }
      if (this.erBlock && this.erBlock.style.display !== 'none' && this.erMatSelect) {
        if (this.erMatSelect.value) materialKey = this.erMatSelect.value;
        else collectionMatRequired = true;
      }
      if (this.avBlock && this.avBlock.style.display !== 'none' && this.avMatSelect) {
        if (this.avMatSelect.value) materialKey = this.avMatSelect.value;
        else collectionMatRequired = true;
      }
      if (this.vxBlock && this.vxBlock.style.display !== 'none' && this.vxMatSelect) {
        if (this.vxMatSelect.value) materialKey = this.vxMatSelect.value;
        else collectionMatRequired = true;
      }
      if (this.atBlock && this.atBlock.style.display !== 'none') {
        const atBodyMatH = document.getElementById(`at-body-mat-${this.idp}`);
        if (atBodyMatH && atBodyMatH.value) materialKey = atBodyMatH.value;
        else collectionMatRequired = true;
      }

      // Если активен коллекционный селект, но материал не выбран — цены нет
      if (collectionMatRequired) return null;
      // Стандартная отделка (Бланка и др.) — если поле видимо и пусто, тоже null
      if (this.finishType && this.finishType.parentNode &&
          this.finishType.parentNode.style.display !== 'none' &&
          !materialKey) return null;
      // Свой цвет (paint_custom) требует ввода артикула RAL/NCS
      if (materialKey === 'paint_custom') {
        const customNameEl = document.getElementById(`finish-custom-name-${this.idp}`);
        if (!customNameEl || !customNameEl.value.trim()) return null;
      }

      // 'paint_custom' использует коэффициент глянца (доплата +5000 в getTotalPrice)
      const effectiveKey = (materialKey === 'paint_custom') ? 'paint_glossy' : materialKey;
      const coeff = finishCoeffs[effectiveKey] || 0.0005905;
      return coeff * w * d * h;
    }
    getTotalPrice() {
      const base=this.getBasePrice(); if (base===null) return null;
      let extra=0;
      const finishColorVal = this.finishColorDD ? this.finishColorDD.getValue() : '';
      extra+=(parseFloat(finishColorVal)||0);
      extra+=(lightPrices[this.lightSelect.value]||0);
      // Надбавка за подбор своего цвета покраски (RAL/NCS):
      // 1. Стандартная отделка — finishType = 'paint_custom'
      // 2. Корпус Элемента — elBodyMatSelect = 'paint_custom'
      if (this.finishType && this.finishType.value === 'paint_custom') {
        extra += 5000;
      }
      if (this.elBlock && this.elBlock.style.display !== 'none' &&
          this.elBodyMatSelect && this.elBodyMatSelect.value === 'paint_custom') {
        extra += 5000;
      }
      // Эриадор: свой цвет покраски
      if (this.erBlock && this.erBlock.style.display !== 'none' &&
          this.erMatSelect && this.erMatSelect.value === 'paint_custom') {
        extra += 5000;
      }
      // Авалон: свой цвет покраски
      if (this.avBlock && this.avBlock.style.display !== 'none' &&
          this.avMatSelect && this.avMatSelect.value === 'paint_custom') {
        extra += 5000;
      }
      // Вертекс: свой цвет покраски
      if (this.vxBlock && this.vxBlock.style.display !== 'none' &&
          this.vxMatSelect && this.vxMatSelect.value === 'paint_custom') {
        extra += 5000;
      }
      // Атлас: свой цвет покраски (корпус ИЛИ фасад) +5000 за каждый
      if (this.atBlock && this.atBlock.style.display !== 'none') {
        const bodyMatH = document.getElementById(`at-body-mat-${this.idp}`);
        const facMatH = document.getElementById(`at-fac-mat-${this.idp}`);
        if (bodyMatH && bodyMatH.value === 'paint_custom') extra += 5000;
        if (facMatH && facMatH.value === 'paint_custom') extra += 5000;
      }
      // Фурнитура:
      //  - Тумбы (ящики): направляющие — 1 комплект на фасад × SLIDE_SET_PRICE.
      //  - Пеналы (распашные): петли — по высоте КАЖДОГО фасада.
      //    2 петли базово; от 1300 мм — 3 петли; от 1500 мм — 4 петли. Петля = HINGE_PRICE.
      const fasadesCount = (this.currentModel && this.currentModel.fasades) || 0;
      if (this.kind === 'penal') {
        extra += this.getHingePrice();
      } else {
        extra += fasadesCount * SLIDE_SET_PRICE;
      }
      return base+extra;
    }
    // Цена петель для пенала: считаем по высоте каждого отдельного фасада.
    getHingePrice() {
      const m = this.currentModel;
      if (!m) return 0;
      const fasades = m.fasades || 1;
      const h = parseFloat(this.heightInput && this.heightInput.value);
      if (isNaN(h) || h <= 0) return 0;
      // высота одного фасада: сетка делит по рядам, ось height — по числу фасадов
      let rows = 1;
      if (m.fasadeAxis === 'grid') rows = m.gridRows || 1;
      else if (m.fasadeAxis === 'height') rows = fasades;
      const facadeH = h / rows;
      // петель на один фасад по его высоте
      let hingesPer = 2;
      if (facadeH >= 1500) hingesPer = 4;
      else if (facadeH >= 1300) hingesPer = 3;
      return fasades * hingesPer * HINGE_PRICE;
    }
    // Возвращает количество полок для пенала (1 полка на каждые 375 мм высоты, минимум 1).
    // Для тумб возвращает null.
    getShelvesCount() {
      if (this.kind !== 'penal') return null;
      const h = parseFloat(this.heightInput?.value);
      if (isNaN(h) || h <= 0) return null;
      return Math.max(1, Math.round(h / 375));
    }
    // Обновляет блок отображения количества полок в форме пенала.
    updateShelvesDisplay() {
      if (!this.shelvesDisplay) return;
      const n = this.getShelvesCount();
      if (n === null) {
        this.shelvesDisplay.textContent = '— введите высоту —';
