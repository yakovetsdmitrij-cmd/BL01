  // Хелпер: создать массив цветов с кодами вида G01..G28 или M01..M28
  function paintColors(prefix, count) {
    const arr = [];
    for (let i = 1; i <= count; i++) {
      const code = prefix + String(i).padStart(2, '0');
      arr.push({ name: code, value: code, price: 0 });
    }
    return arr;
  }

  // HEX-значения для номеров покраски 01..28 (одинаковые для G и M, отличие — наличие блика)
  // Источник: RAL — точные, NCS — близкое приближение (NCS не имеет точного RGB-перевода)
  const PAINT_COLOR_HEX = {
    '01': '#F1F0EA', // RAL 9016 Транспортный белый
    '02': '#F4F4F4', // RAL 9003 Сигнальный белый
    '03': '#F1ECE0', // RAL 9010 Белый чистый
