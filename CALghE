          if (cn && !cn.value.trim()) miss.push('Код цвета корпуса');
        } else if (empty(this.elBodyColorDD)) miss.push('Цвет корпуса');
        if (empty(this.elFacadeColorDD)) miss.push('Цвет фасада');
