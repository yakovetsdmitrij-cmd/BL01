        if (bodyMatH && !bodyMatH.value) miss.push('Материал корпуса');
        else if (this.atBodyColorDD && empty(this.atBodyColorDD) && bodyMatH && bodyMatH.value!=='paint_custom') miss.push('Цвет корпуса');
        if (facMatH && !facMatH.value) miss.push('Материал фасада');
        else if (this.atFacColorDD && empty(this.atFacColorDD) && facMatH && facMatH.value!=='paint_custom') miss.push('Цвет фасада');
      }
      return miss;
    }
