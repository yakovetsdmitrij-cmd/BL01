    '08': '#DBC9B3', // NCS S 1505-Y50R
    '09': '#918177', // NCS S 4010-Y30R
    '10': '#948A7E', // NCS S 4005-Y50R
    '11': '#7C7367', // NCS S 5005-Y50R
    '12': '#4F4942', // NCS S 7005-Y20R
