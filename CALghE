  // Конвертирует SVG-строку в PNG dataURL (так html2canvas всегда рендерит схему правильно)
  async function svgToPngDataUrl(svgString, scale = 3) {
    return new Promise((resolve) => {
      try {
        if (!svgString) return resolve('');
        // Парсим viewBox чтобы получить размеры
        const m = svgString.match(/viewBox=["']([\d.\s-]+)["']/i);
        let vw = 300, vh = 200;
        if (m) {
          const parts = m[1].trim().split(/\s+/).map(Number);
          vw = parts[2] || vw; vh = parts[3] || vh;
        }
        // Кодируем SVG в data URI
        const svgBlob = new Blob([svgString], {type: 'image/svg+xml;charset=utf-8'});
        const url = URL.createObjectURL(svgBlob);
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          canvas.width = vw * scale;
          canvas.height = vh * scale;
          const ctx = canvas.getContext('2d');
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          URL.revokeObjectURL(url);
          resolve(canvas.toDataURL('image/png'));
        };
        img.onerror = () => { URL.revokeObjectURL(url); resolve(''); };
        img.src = url;
      } catch (e) { resolve(''); }
    });
  }

  async function generatePDF(items,totalDealer,type,clientPrice,markupPercent=30) {
    // Сохраняем расчёт на сервере (для админ-статистики) — с РЕАЛЬНОЙ выбранной наценкой.
    try {
      // Один заказ = один orderId. Если ещё не создан для текущего состава — создаём.
      // Несколько PDF (фабрика/покупатель/дилер) одного состава пойдут с тем же orderId.
      if (!currentOrderId) currentOrderId = genOrderId();
      const slim = items.map(buildSlimItem).map(it => (it && it.price != null) ? {...it, price: applyVat(it.price)} : it);
      if (typeof window.__track === 'function') {
        window.__track('pdf');
        window.__track('calc', {
          items: slim,
          totalDealer: applyVat(totalDealer),
          totalClient: applyVat(clientPrice),
          markupPercent: markupPercent,
          pdfType: type,
          orderId: currentOrderId
        });
      }
    } catch(e) {}
    const date=new Date().toLocaleDateString('ru-RU',{day:'numeric',month:'long',year:'numeric'});

    // Конвертируем все SVG-схемы в PNG заранее
    for (const item of items) {
      if (item.schemaSvg) {
        item.schemaPng = await svgToPngDataUrl(item.schemaSvg, 3);
      }
    }

    // === Рендеринг блоков ===
    // Каждый "блок" — это отдельный HTML-элемент. Рендерим его в canvas
    // и собираем многостраничный PDF вручную, с контролем переноса.

    // 1) Создаём скрытый контейнер для рендеринга
    const renderContainer = document.createElement('div');
    renderContainer.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:190mm;background:white;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a;';
    document.body.appendChild(renderContainer);

    // 2) HTML-фабрики блоков
    const headerHtml = `
      <table style="width:100%;border-collapse:collapse;margin-bottom:8px;border-bottom:2px solid #1a1a1a;">
        <tr>
          <td style="padding-bottom:8px;font-size:20px;font-weight:700;letter-spacing:4px;color:#1a1a1a;">CERSA</td>
          <td style="padding-bottom:8px;text-align:right;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#444;line-height:1.5;">${type==='client'?'КОММЕРЧЕСКОЕ ПРЕДЛОЖЕНИЕ':type==='cersa'?'СПЕЦИФИКАЦИЯ CERSA':'СПЕЦИФИКАЦИЯ ДЛЯ ДИЛЕРА'}<br><span style="color:#888;">${date}</span></td>
        </tr>
      </table>`;

    function buildItemCard(item) {
      const displayPriceRaw = type==='dealer'
        ? item.recommended
        : type==='cersa'
          ? item.price
          : (totalDealer > 0
              ? Math.round(clientPrice * (item.price / totalDealer))
              : item.price);
      const displayPrice = applyVat(displayPriceRaw);
      let name=''; let specs=[];
      if (item.type==='cabinet'||item.type==='penal'){
        name=item.type==='cabinet'?'ТУМБА':'ПЕНАЛ';
        if (item.article) specs.push({l:'АРТИКУЛ',v:item.article});
        specs.push({l:'КОЛЛЕКЦИЯ',v:item.collection||'—'});
        specs.push({l:'МОДЕЛЬ',v:item.model||'—'});
        specs.push({l:'УСТАНОВКА',v:item.mount||'—'});
        specs.push({l:'РАЗМЕРЫ (Ш×Г×В)',v:`${item.width||'—'} × ${item.depth||'—'} × ${item.height||'—'} мм`});
        if (item.cokol && item.cokol > 0) specs.push({l:'ЦОКОЛЬ',v:`${item.cokol} мм`});
        // Для grid-тумбы: ширины столбцов + высоты фасадов
        if (item.fasadeAxis === 'grid') {
          if (item.gridColWidths) specs.push({l:'ШИРИНЫ СТОЛБЦОВ',v:item.gridColWidths+' мм'});
          if (item.fasades) specs.push({l:'ВЫСОТЫ ФАСАДОВ',v:item.fasades+' мм'});
        } else if (item.fasadeAxis === 'mixed_1plus2' || item.fasadeAxis === 'mixed_2plus1') {
          // Смешанная компоновка: ширина одиночной колонки + 2 высоты широких фасадов
          if (item.mixedSingleColW) specs.push({l: item.fasadeAxis === 'mixed_1plus2' ? 'ШИРИНА ЛЕВОЙ КОЛОНКИ' : 'ШИРИНА ПРАВОЙ КОЛОНКИ', v: item.mixedSingleColW+' мм'});
          if (item.mixedTopH) specs.push({l:'ВЫСОТА ВЕРХНЕГО ФАСАДА',v:item.mixedTopH+' мм'});
          if (item.mixedBottomH) specs.push({l:'ВЫСОТА НИЖНЕГО ФАСАДА',v:item.mixedBottomH+' мм'});
        } else if (item.fasadeAxis === 'mixed_1plus2plus1') {
          // 1+2+1: левая + центр (верх+низ) + правая
          if (item.mixedLeftW) specs.push({l:'ШИРИНА ЛЕВОЙ КОЛОНКИ', v: item.mixedLeftW+' мм'});
          if (item.mixedTopH) specs.push({l:'ВЫСОТА ВЕРХНЕГО ЦЕНТРА', v: item.mixedTopH+' мм'});
          if (item.mixedBottomH) specs.push({l:'ВЫСОТА НИЖНЕГО ЦЕНТРА', v: item.mixedBottomH+' мм'});
          if (item.mixedRightW) specs.push({l:'ШИРИНА ПРАВОЙ КОЛОНКИ', v: item.mixedRightW+' мм'});
        } else if (item.fasades) {
          specs.push({l:item.fasadeAxis==='height'?'ВЫСОТЫ ФАСАДОВ':'ШИРИНЫ ФАСАДОВ',v:item.fasades+' мм'});
        }
        if (item.hingeSide) specs.push({l:'СТОРОНА ОТКРЫВАНИЯ',v:item.hingeSide});
        if (item.shelvesCount !== null && item.shelvesCount !== undefined) {
          specs.push({l:'ПОЛКИ',v:`${item.shelvesCount} шт (стекло)`});
        }
        if (item.trim) specs.push({l:'ОКАНТОВКА',v:item.trim});
        // Поля коллекции "Элемент"
        if (item.elBodyMaterial) specs.push({l:'МАТЕРИАЛ КОРПУСА',v:item.elBodyMaterial});
        if (item.elBodyColor) specs.push({l:'ЦВЕТ КОРПУСА',v:item.elBodyColor});
        if (item.elFacadeColor) {
          const facLabel = item.elFacadeColor;
          specs.push({l:'ЦВЕТ ФАСАДА (КЕРАМОГРАНИТ)',v:facLabel});
        }
        // Поля коллекции "Эриадор"
        if (item.erMaterial) specs.push({l:'МАТЕРИАЛ',v:item.erMaterial});
        if (item.erColor) specs.push({l:'ЦВЕТ',v:item.erColor});
        if (item.erFacadePattern) specs.push({l:'ТИП ФАСАДА',v:item.erFacadePattern});
        // Поля коллекции "Авалон"
        if (item.avMaterial) specs.push({l:'МАТЕРИАЛ',v:item.avMaterial});
        if (item.avColor) specs.push({l:'ЦВЕТ',v:item.avColor});
        if (item.avTrim) specs.push({l:'ОКАНТОВКА / ФУРНИТУРА',v:item.avTrim});
        // Поля коллекции "Вертекс"
        if (item.vxMaterial) specs.push({l:'МАТЕРИАЛ',v:item.vxMaterial});
        if (item.vxColor) specs.push({l:'ЦВЕТ',v:item.vxColor});
        if (item.vxFacadePattern) specs.push({l:'ТИП ФАСАДА',v:item.vxFacadePattern});
        // Поля коллекции "Т-Вуд"
        if (item.twColor) {
          specs.push({l:'МАТЕРИАЛ',v:'Термоясень'});
          specs.push({l:'ЦВЕТ (ОТТЕНОК)',v:item.twColor});
        }
        // Поля коллекции "Атлас"
        if (item.atBodyMaterial) specs.push({l:'МАТЕРИАЛ КОРПУСА', v:item.atBodyMaterial});
        if (item.atBodyColor) specs.push({l:'ЦВЕТ КОРПУСА', v:item.atBodyColor});
        if (item.atFacMaterial) specs.push({l:'МАТЕРИАЛ ФАСАДОВ', v:item.atFacMaterial});
        if (item.atFacColor) specs.push({l:'ЦВЕТ ФАСАДОВ', v:item.atFacColor});
        if (item.atFrameColor) specs.push({l:'ЦВЕТ МЕТАЛЛИЧЕСКОЙ РАМКИ', v:item.atFrameColor});
        if (item.finish && item.finish.trim() !== '-' && item.finish.trim() !== '') {
          specs.push({l:'ОТДЕЛКА',v:item.finish});
        }
        specs.push({l:'ПОДСВЕТКА',v:item.light||'Нет'});
      } else if (item.type==='countertop'){
        name='СТОЛЕШНИЦА';
        if (item.article) specs.push({l:'АРТИКУЛ',v:item.article});
        specs.push({l:'МАТЕРИАЛ',v:item.material||'—'});
        if (item.color) specs.push({l:'ЦВЕТ',v:item.color});
        specs.push({l:'ТОЛЩИНА',v:item.thickness||'—'});
        specs.push({l:'РАЗМЕРЫ (Д×Г)',v:`${item.width||'—'} × ${item.depth||'—'} мм`});
        if (item.tapHole) specs.push({l:'ОТВЕРСТИЕ ПОД СМЕСИТЕЛЬ',v:item.tapHole});
        if (item.sinkLabel) specs.push({l:'РАКОВИНА',v:item.sinkLabel});
        if (item.sinkPosition) specs.push({l:'РАСПОЛОЖЕНИЕ РАКОВИНЫ',v:item.sinkPosition});
        if (item.isClientSink && item.clientSinkArticle) specs.push({l:'АРТИКУЛ РАКОВИНЫ',v:item.clientSinkArticle});
      } else if (item.type==='sink'){
        name='РАКОВИНА';
        if (item.article) specs.push({l:'АРТИКУЛ',v:item.article});
        specs.push({l:'ТИП МОНТАЖА',v:item.mountType||'—'});
        specs.push({l:'МАТЕРИАЛ',v:item.material||'—'});
        specs.push({l:'РАЗМЕРЫ (Ш×Г)',v:`${item.width||'—'} × ${item.depth||'—'} мм`});
      } else if (item.type==='mirror'){
        name='ЗЕРКАЛО';
        if (item.collection) specs.push({l:'КОЛЛЕКЦИЯ',v:item.collection});
        if (item.article) specs.push({l:'АРТИКУЛ',v:item.article});
        specs.push({l:'ФОРМА',v:item.shape||'—'});
        if (item.finish) specs.push({l:'ОТДЕЛКА',v:item.finish});
        specs.push({l:'РАЗМЕРЫ (Ш×В)',v:`${item.width||'—'} × ${item.height||'—'} мм`});
        specs.push({l:'ПОДСВЕТКА',v:item.light||'—'});
      } else if (item.type==='dops'){
        name='ДОПЫ';
        if(item.options) specs=[{l:'ОПЦИИ',v:item.options}];
      }

      let card = `<div style="border:1px solid #c0c0c0;padding:12px 14px;background:#ffffff;">`;
      card += `<table style="width:100%;border-collapse:collapse;margin-bottom:10px;"><tr>`;
      card += `<td style="padding-bottom:8px;border-bottom:1px solid #d8d8d8;font-size:14px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:#1a1a1a;">${name}</td>`;
      card += `<td style="padding-bottom:8px;border-bottom:1px solid #d8d8d8;text-align:right;font-size:16px;font-weight:600;letter-spacing:1.5px;color:#1a1a1a;">${displayPrice.toLocaleString()} ₽</td>`;
      card += `</tr></table>`;
      card += `<table style="width:100%;border-collapse:collapse;"><tr>`;
      if (item.schemaPng) {
        card += `<td style="width:160px;vertical-align:middle;padding-right:12px;">`;
        card += `<div style="background:#ffffff;border:1px solid #ececec;padding:5px;text-align:center;height:140px;display:table-cell;vertical-align:middle;width:150px;">`;
        card += `<img src="${item.schemaPng}" style="max-width:100%;max-height:130px;width:auto;height:auto;display:inline-block;"/>`;
        card += `</div></td>`;
      }
      card += `<td style="vertical-align:top;">`;
      card += `<table style="width:100%;border-collapse:collapse;">`;
      specs.forEach(s=>{
        card += `<tr>`;
        card += `<td style="padding:5px 8px 5px 0;font-size:9px;letter-spacing:1px;color:#666;text-transform:uppercase;border-bottom:1px solid #ececec;width:46%;vertical-align:top;font-weight:600;">${s.l}</td>`;
        card += `<td style="padding:5px 0;font-size:11px;letter-spacing:0.2px;border-bottom:1px solid #ececec;vertical-align:top;color:#1a1a1a;font-weight:500;">${s.v||'—'}</td>`;
        card += `</tr>`;
      });
      if (type==='dealer') {
        card += `<tr><td style="padding:5px 8px 5px 0;font-size:9px;letter-spacing:1px;color:#A88B30;text-transform:uppercase;width:46%;font-weight:700;">ВАША ЦЕНА</td>`;
        card += `<td style="padding:5px 0;font-size:11px;color:#A88B30;font-weight:700;">${item.price.toFixed(2)} ₽</td></tr>`;
      }
      card += `</table></td></tr></table>`;
      card += `</div>`;
      return card;
    }

    function buildTotal() {
      let h = `<div style="margin-top:14px;padding-top:12px;border-top:2px solid #1a1a1a;">`;
      h += `<table style="width:100%;border-collapse:collapse;"><tr>`;
      if (type==='cersa') {
        h += `<td style="font-size:13px;letter-spacing:2.5px;text-transform:uppercase;font-weight:700;color:#1a1a1a;">ЗАКУПОЧНАЯ ЦЕНА (${VAT_LABEL})</td>`;
        h += `<td style="text-align:right;font-size:20px;font-weight:600;letter-spacing:1.5px;color:#1a1a1a;">${applyVat(totalDealer).toLocaleString()} ₽</td>`;
      } else {
        h += `<td style="font-size:13px;letter-spacing:2.5px;text-transform:uppercase;font-weight:700;color:#1a1a1a;">ОБЩАЯ СТОИМОСТЬ (${VAT_LABEL})</td>`;
        h += `<td style="text-align:right;font-size:20px;font-weight:600;letter-spacing:1.5px;color:#1a1a1a;">${applyVat(clientPrice).toLocaleString()} ₽</td>`;
      }
      h += `</tr></table>`;
      if (type==='dealer') {
        h += `<div style="font-size:10px;color:#A88B30;text-align:right;letter-spacing:1px;margin-top:6px;font-weight:600;">ВАША ЗАКУПОЧНАЯ ЦЕНА: ${applyVat(totalDealer).toLocaleString()} ₽ (${VAT_LABEL})</div>`;
        h += `<div style="font-size:10px;color:#666;text-align:right;letter-spacing:1px;margin-top:3px;font-weight:500;">ВАША ПРИБЫЛЬ: ${applyVat(clientPrice-totalDealer).toLocaleString()} ₽ (${markupPercent}%)</div>`;
      }
      h += `</div>`;
      h += `<div style="margin-top:14px;padding-top:8px;border-top:1px solid #d8d8d8;font-size:8px;color:#888;letter-spacing:1.2px;text-align:center;line-height:1.6;text-transform:uppercase;">© ${new Date().getFullYear()} CERSA PREMIUM DESIGN. ВСЕ ПРАВА ЗАЩИЩЕНЫ.<br>ДАННАЯ СПЕЦИФИКАЦИЯ ЯВЛЯЕТСЯ ПРЕДВАРИТЕЛЬНОЙ.</div>`;
      return h;
    }

    // === Превью оверлей ===
    const previewHtml = `<div style="padding:14mm 12mm;background:white;width:210mm;box-sizing:border-box;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a;">${headerHtml}${items.map(it => '<div style="margin-bottom:8px;">'+buildItemCard(it)+'</div>').join('')}${buildTotal()}</div>`;

    const overlay=document.createElement('div'); overlay.className='pdf-overlay';
    overlay.innerHTML=`<div class="pdf-content" style="width:auto;padding:0;background:transparent;box-shadow:0 0 20px rgba(0,0,0,0.15);">${previewHtml}</div>`;
    const closeBtn=document.createElement('button'); closeBtn.className='pdf-close-btn'; closeBtn.textContent='✕ ЗАКРЫТЬ'; overlay.appendChild(closeBtn);
    const saveBtn=document.createElement('button'); saveBtn.className='pdf-save-btn'; saveBtn.textContent='💾 СОХРАНИТЬ PDF'; overlay.appendChild(saveBtn);
    document.body.appendChild(overlay);
    closeBtn.onclick=()=>{
      try {
        if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
        if (renderContainer.parentNode) renderContainer.parentNode.removeChild(renderContainer);
      } catch(e) { console.error('PDF close cleanup error:', e); }
      // Возвращаемся к окну выбора типа PDF (а не к карточкам). Делаем через setTimeout,
      // чтобы DOM успел обновиться после удаления overlay.
      setTimeout(() => {
        try { showPDFTypeModal(); } catch(e) { console.error('showPDFTypeModal error:', e); }
      }, 50);
    };

    saveBtn.onclick=async()=>{
      saveBtn.disabled = true;
      saveBtn.textContent = '⏳ СОЗДАЁТСЯ...';

      try {
        // jsPDF UMD bundle экспортирует на window.jspdf.jsPDF
        let pdfLib = null;
        if (window.jspdf && window.jspdf.jsPDF) pdfLib = window.jspdf.jsPDF;
        else if (window.jsPDF) pdfLib = window.jsPDF;
        if (!pdfLib) throw new Error('jsPDF не найден. Проверьте подключение скрипта.');

        const pdf = new pdfLib({ unit:'mm', format:'a4', orientation:'portrait', compress:true });
        const pageW = 210, pageH = 297;
        const marginX = 10, marginTop = 10, marginBottom = 10;
        const contentW = pageW - marginX*2;       // 190mm
        const contentH = pageH - marginTop - marginBottom; // 277mm
        let cursorY = marginTop;

        // Функция: рендерит HTML-фрагмент в canvas, возвращает {dataUrl, widthMm, heightMm}
        async function renderToImage(html) {
          renderContainer.innerHTML = html;
          // ждём пока картинки внутри загрузятся
          const imgs = renderContainer.querySelectorAll('img');
          await Promise.all(Array.from(imgs).map(img => {
            if (img.complete) return Promise.resolve();
            return new Promise(res => { img.onload = res; img.onerror = res; });
          }));
          await new Promise(r => setTimeout(r, 50));
          const canvas = await html2canvas(renderContainer, {
            scale: 2,
            useCORS: true,
            allowTaint: true,
            backgroundColor: '#ffffff',
            logging: false
          });
          const widthMm = contentW;
          const heightMm = (canvas.height / canvas.width) * widthMm;
          return { dataUrl: canvas.toDataURL('image/jpeg', 0.95), widthMm, heightMm };
        }

        // 1) Шапка
        const headerImg = await renderToImage(headerHtml);
        pdf.addImage(headerImg.dataUrl, 'JPEG', marginX, cursorY, headerImg.widthMm, headerImg.heightMm);
        cursorY += headerImg.heightMm + 4;

        // 2) Каждая карточка
        for (let i = 0; i < items.length; i++) {
          const cardImg = await renderToImage(buildItemCard(items[i]));
          // Если не помещается на текущей странице — новая страница
          if (cursorY + cardImg.heightMm > pageH - marginBottom) {
            pdf.addPage();
            cursorY = marginTop;
          }
          pdf.addImage(cardImg.dataUrl, 'JPEG', marginX, cursorY, cardImg.widthMm, cardImg.heightMm);
          cursorY += cardImg.heightMm + 3;
        }

        // 3) Итог + футер
        const totalImg = await renderToImage(buildTotal());
        if (cursorY + totalImg.heightMm > pageH - marginBottom) {
          pdf.addPage();
          cursorY = marginTop;
        }
        pdf.addImage(totalImg.dataUrl, 'JPEG', marginX, cursorY, totalImg.widthMm, totalImg.heightMm);

        const filename = type==='client' ? 'КП-CERSA.pdf' : type==='cersa' ? 'CERSA-закупка.pdf' : 'Дилер-CERSA.pdf';
        pdf.save(filename);

        if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
        if (renderContainer.parentNode) renderContainer.parentNode.removeChild(renderContainer);
      } catch(e) {
        console.error(e);
        alert('Ошибка при создании PDF: '+e.message);
        saveBtn.disabled = false;
        saveBtn.textContent = '💾 СОХРАНИТЬ PDF';
      }
    };
  }
  document.getElementById('download-pdf').addEventListener('click',showPDFTypeModal);
  // Глобальный обработчик — закрытие любого atlas-dd при клике вне него
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.atlas-dd')) {
      document.querySelectorAll('.atlas-dd.open').forEach(d => d.classList.remove('open'));
    }
  });
  updateAll();
})();
</script>
<script>
// Трекинг активности + сохранение содержимого расчёта на сервере (для админ-статистики).
(function(){
  window.__track = function(ev, payload){
    try{
      fetch('/track', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify(Object.assign({event:ev}, payload||{}))
      });
    }catch(e){}
  };
  // Отметка простой активности (расчёт), не чаще раза в 15 сек — для счётчика «расчётов»
  var lastCalc = 0;
  window.__trackActivity = function(){ var now=Date.now(); if(now-lastCalc>15000){ lastCalc=now; window.__track('calc_ping'); } };
})();
</script>
</body>
</html>
