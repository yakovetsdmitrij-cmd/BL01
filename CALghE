    // Проверка полей размеров: подсветка + тряска ячейки при значении вне диапазона.
    // Вызывается на каждый ввод. Возвращает true если все поля валидны.
    validateDimFields() {
      if (!this.currentModel) return true;
      const checks = [
        { input: this.widthInput,  ranges: this.currentModel.width,  label: 'Ширина'  },
        { input: this.depthInput,  ranges: this.currentModel.depth,  label: 'Глубина' },
        { input: this.heightInput, ranges: this.currentModel.height, label: 'Высота'  }
      ];
      let allOk = true;
      for (const { input, ranges, label } of checks) {
        if (!input || !ranges) continue;
        const wrap = input.parentNode;
        // Удаляем прежнее сообщение об ошибке
        const oldMsg = wrap.querySelector('.dim-error-msg');
        if (oldMsg) oldMsg.remove();
        const raw = input.value.trim();
        const val = parseFloat(raw);
        // Пустое поле — не ошибка (ещё не заполнено), просто снимаем подсветку
        if (raw === '' || isNaN(val)) {
          input.classList.remove('dim-error');
          continue;
        }
        let lo = Infinity, hi = -Infinity;
        for (const r of ranges) { if (r[0] < lo) lo = r[0]; if (r[1] > hi) hi = r[1]; }
        if (val < lo || val > hi) {
          allOk = false;
          // Подсветка
          if (!input.classList.contains('dim-error')) {
            input.classList.add('dim-error');
          }
          // Тряска (перезапуск анимации)
          input.classList.remove('dim-shake');
          void input.offsetWidth; // форсируем reflow чтобы анимация перезапустилась
          input.classList.add('dim-shake');
          // Сообщение под полем
          const msg = document.createElement('span');
          msg.className = 'dim-error-msg';
          msg.textContent = `Недопустимый размер. Диапазон: ${lo}–${hi} мм`;
          wrap.appendChild(msg);
        } else {
          input.classList.remove('dim-error', 'dim-shake');
        }
      }
      return allOk;
    }
    refreshSchema() {
      if (!this.currentModel || !this.schemaDiv) return;
