    onMirrorFinishTypeChange() {
      // Заполнение цветов на основе выбранной отделки + поле "Свой цвет" для paint_custom
      const cKey = this.collectionSelect ? this.collectionSelect.value : '';
      const fKey = this.finishType ? this.finishType.value : '';
      const finishColorRoot = document.getElementById(`${this.idp}-finish-color-dd`);
      const colorCol = finishColorRoot ? finishColorRoot.closest('.col') : null;

      if (fKey === 'paint_custom') {
        if (colorCol) colorCol.style.display = 'none';
        if (this.finishCustomRow) this.finishCustomRow.style.display = 'flex';
        if (this.finishColorDD) this.finishColorDD.reset();
        return;
      }
      if (this.finishCustomRow) this.finishCustomRow.style.display = 'none';
      if (this.finishCustomName) this.finishCustomName.value = '';
      if (colorCol) colorCol.style.display = '';
      if (!cKey || !fKey) {
        if (this.finishColorDD) this.finishColorDD.setOptions([{value:'', label:'сначала отделку —'}], 'сначала отделку —', true);
        return;
      }
      // Используем универсальный buildColorOptions — он правильно строит swatch-опции
      // и для покраски (G01..M28), и для шпона (по имени), с уникальными value у каждого цвета.
      if (this.finishColorDD && typeof buildColorOptions === 'function') {
        const opts = buildColorOptions(fKey);
        this.finishColorDD.setOptions(opts, '— выберите —', false);
      }
    }
