  function renderAtlasFacade(x, y, w, h, color, frameColor) {
    if (w <= 0 || h <= 0) return '';
    let s = '';
    s += `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${color}" stroke="rgba(0,0,0,0.30)" stroke-width="0.5"/>`;
    const frameW = Math.max(5, Math.min(w, h) * 0.075);
    const innerX = x + frameW;
    const innerY = y + frameW;
    const innerW = Math.max(0, w - frameW * 2);
    const innerH = Math.max(0, h - frameW * 2);
    if (innerW > 0 && innerH > 0) {
      s += `<rect x="${innerX}" y="${innerY}" width="${innerW}" height="${innerH}" fill="${color}"/>`;
      s += `<line x1="${innerX}" y1="${innerY + 0.5}" x2="${innerX + innerW}" y2="${innerY + 0.5}" stroke="rgba(0,0,0,0.18)" stroke-width="0.5"/>`;
      s += `<line x1="${innerX + 0.5}" y1="${innerY}" x2="${innerX + 0.5}" y2="${innerY + innerH}" stroke="rgba(0,0,0,0.18)" stroke-width="0.5"/>`;
    }
    s += `<rect x="${x}" y="${y}" width="${w}" height="${frameW}" fill="${frameColor}"/>`;
    s += `<rect x="${x}" y="${y + h - frameW}" width="${w}" height="${frameW}" fill="${frameColor}"/>`;
    s += `<rect x="${x}" y="${y}" width="${frameW}" height="${h}" fill="${frameColor}"/>`;
    s += `<rect x="${x + w - frameW}" y="${y}" width="${frameW}" height="${h}" fill="${frameColor}"/>`;
    s += `<rect x="${x}" y="${y}" width="${w}" height="${Math.max(0.5, frameW * 0.35)}" fill="rgba(255,255,255,0.30)"/>`;
    s += `<rect x="${x}" y="${y + h - Math.max(0.5, frameW * 0.35)}" width="${w}" height="${Math.max(0.5, frameW * 0.35)}" fill="rgba(0,0,0,0.20)"/>`;
    return s;
  }

  function svgCabinetAtlas(params) {
