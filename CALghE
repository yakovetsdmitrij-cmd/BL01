      else if (this.kind==='sink') {
        details.mountType=this.typeSelect.options[this.typeSelect.selectedIndex]?.text;
        details.material=this.materialSelect.options[this.materialSelect.selectedIndex]?.text;
        details.width=this.widthInput.value;
        details.depth=this.depthInput.value;
