      const models = col.models?.[this.type];
      if (models) for (let m in models) this.modelSelect.add(new Option(m+' — '+models[m].name, m));
      const finishes = col.finishes;
      if (finishes) {
        for (let f in finishes) this.finishType.add(new Option(finishes[f].name, f));
        // Если в коллекции есть крашеные отделки — добавляем опцию "Свой цвет покраски (RAL/NCS)"
        if (finishes.paint_glossy || finishes.paint_matte) {
          this.finishType.add(new Option('Свой цвет покраски (RAL/NCS)', 'paint_custom'));
        }
      }
      updateAll();
    }
    onFinishTypeChange() {
      const cKey = this.colSelect.value; const fKey = this.finishType.value;
      // Поле артикула RAL/NCS — показываем только при выборе "Свой цвет покраски"
      const customRow = document.getElementById(`finish-custom-row-${this.idp}`);
      const customName = document.getElementById(`finish-custom-name-${this.idp}`);
      const finishColorRoot = document.getElementById(`finish-color-dd-${this.idp}`);
      const colorCol = finishColorRoot ? finishColorRoot.closest('.col') : null;

      if (fKey === 'paint_custom') {
        // Свой цвет: скрываем выбор цвета из палитры, показываем поле артикула
        if (colorCol) colorCol.style.display = 'none';
        if (customRow) customRow.style.display = 'flex';
        if (this.finishColorDD) this.finishColorDD.reset();
        updateAll();
        return;
      }
      // Любой другой выбор (или сброс) — скрываем поле артикула, очищаем его
      if (customRow) customRow.style.display = 'none';
      if (customName) customName.value = '';
      if (colorCol) colorCol.style.display = '';
      if (!cKey || !fKey) {
        if (this.finishColorDD) this.finishColorDD.setOptions([{value:'', label:'сначала отделку —'}], 'сначала отделку —', true);
        updateAll();
        return;
      }
      // Собираем опции с swatches (для покраски — берём hex по последним 2 цифрам кода в значении value)
      const colors = collections[cKey].finishes[fKey].colors;
      const opts = [{value:'', label:'— выберите —'}];
      colors.forEach(c => {
        const optValue = (c.value !== undefined) ? String(c.value) : String(c.price);
        // Hex для swatch: для G##/M## — из PAINT_COLOR_HEX, для шпона — match по name из VENEER_COLORS, для керамогранита — из PORCELAIN_COLORS, иначе нет
        let hex = null;
        if (/^[GM]\d{2}$/.test(c.name)) {
          const num = c.name.slice(-2);
          if (typeof PAINT_COLOR_HEX !== 'undefined' && PAINT_COLOR_HEX[num]) hex = PAINT_COLOR_HEX[num];
        } else if (typeof VENEER_COLORS !== 'undefined') {
          const v = VENEER_COLORS.find(x => x.name === c.name);
          if (v) hex = v.hex;
        }
        if (!hex && typeof PORCELAIN_COLORS !== 'undefined') {
          const p = PORCELAIN_COLORS.find(x => x.name === c.name);
          if (p) hex = p.hex;
        }
        if (!hex && typeof QUARTZ_COLORS !== 'undefined') {
          const q = QUARTZ_COLORS.find(x => x.name === c.name);
          if (q) hex = q.hex;
        }
        opts.push({value: optValue, label: c.name, hex});
      });
      if (this.finishColorDD) this.finishColorDD.setOptions(opts, '— выберите —', false);
      updateAll();
    }
    // Хелпер: понятная подпись фасада по индексу
    facadeLabel(i, count, axis, isPenal) {
      // Горизонтальные фасады (по ширине) — лево/центр/право
      if (axis === 'width') {
        if (count === 1) return 'Ширина фасада, мм';
        if (count === 2) return `Фасад ${i===0?'левый':'правый'} (ширина), мм`;
        if (count === 3) return `Фасад ${i===0?'левый':i===1?'центр':'правый'} (ширина), мм`;
        return `Фасад ${i+1} (ширина), мм`;
      }
      // Вертикальные фасады (по высоте) — верх/центр/низ
      if (axis === 'height') {
        if (count === 1) return 'Высота фасада, мм';
        if (count === 2) return `Фасад ${i===0?'верхний':'нижний'} (высота), мм`;
        if (count === 3) return `Фасад ${i===0?'верхний':i===1?'средний':'нижний'} (высота), мм`;
        return `Фасад ${i+1} (высота), мм`;
      }
      return `Фасад ${i+1}, мм`;
    }

    createFasadeInputs(count) {
      this.fasadyContainer.innerHTML = '';
      this.fasadeTouched = new Array(count).fill(false);
      const isGrid = this.fasadeAxis==='grid';
      const isMixed = this.fasadeAxis==='mixed_1plus2' || this.fasadeAxis==='mixed_2plus1';
      const isMixed3 = this.fasadeAxis==='mixed_1plus2plus1';
      // Класс mixed-layout активирует жёсткую 3-колоночную сетку CSS
      if (isMixed || isMixed3) this.fasadyContainer.classList.add('mixed-layout');
      else this.fasadyContainer.classList.remove('mixed-layout');
      const cols = (this.currentModel && this.currentModel.gridCols) || 2;
      const rows = (this.currentModel && this.currentModel.gridRows) || 2;

      if (isMixed3) {
        // === Тумба 1+2+1: левая колонка + центр (2 фасада по высоте) + правая колонка ===
        // 5 полей по data-mxidx:
        //   0=ширина левой, 1=верхний центральный, 2=нижний центральный, 3=ширина правой, 4=ширина центра
        // Layout:
        //   Ряд 1: [Лев. ширина] [Центр. ширина] [Прав. ширина]   ← 3 grid-ячейки
        //   Ряд 2: [пусто]       [Верх+Низ парой ] [пусто]         ← пара высот в центральной ячейке
        const divL = document.createElement('div'); divL.className='col';
        divL.innerHTML = `<span class="label">Ширина лев. колонки, мм</span><input type="number" class="mixed-col-input" data-mxidx="0" step="any" min="100">`;
        const divC = document.createElement('div'); divC.className='col';
        divC.innerHTML = `<span class="label">Ширина центр. колонки, мм</span><input type="number" class="mixed-col-input" data-mxidx="4" step="any" min="100">`;
        const divR = document.createElement('div'); divR.className='col';
        divR.innerHTML = `<span class="label">Ширина прав. колонки, мм</span><input type="number" class="mixed-col-input" data-mxidx="3" step="any" min="100">`;
        // Пара "Верх + Низ" в одной центральной grid-ячейке (под центром)
        const divEmptyL = document.createElement('div'); divEmptyL.className='col';
        const divCenterPair = document.createElement('div'); divCenterPair.className='col mixed-pair';
        divCenterPair.innerHTML = `
          <div class="mixed-pair-item">
            <span class="label">Верх. фасад центра, мм</span>
            <input type="number" class="mixed-col-input" data-mxidx="1" step="any" min="100">
          </div>
          <div class="mixed-pair-item">
            <span class="label">Ниж. фасад центра, мм</span>
            <input type="number" class="mixed-col-input" data-mxidx="2" step="any" min="100">
          </div>`;
        const divEmptyR = document.createElement('div'); divEmptyR.className='col';
        // Ряд 1: ширины (3 поля по 1 grid-ячейке)
        this.fasadyContainer.appendChild(divL);
        this.fasadyContainer.appendChild(divC);
        this.fasadyContainer.appendChild(divR);
        // Ряд 2: пустая | пара высот (центрирована под центром) | пустая
        this.fasadyContainer.appendChild(divEmptyL);
        this.fasadyContainer.appendChild(divCenterPair);
        this.fasadyContainer.appendChild(divEmptyR);

        this.mixedTouched = [false, false, false, false, false];
        this.fasadyContainer.querySelectorAll('.mixed-col-input').forEach(inp => {
          inp.addEventListener('input', () => {
            const idx = parseInt(inp.dataset.mxidx);
            this.mixedTouched[idx] = true;
            // Авто-перерасчёт нетронутой высоты центрального фасада при изменении другой
            if (idx === 1 || idx === 2) {
              const effH = this.getEffectiveHeight();
              const otherIdx = idx === 1 ? 2 : 1;
              if (!isNaN(effH) && !this.mixedTouched[otherIdx]) {
                const thisVal = parseFloat(inp.value);
                if (!isNaN(thisVal) && thisVal >= 0 && thisVal <= effH) {
                  const others = this.fasadyContainer.querySelectorAll('.mixed-col-input');
                  others.forEach(o => {
                    if (parseInt(o.dataset.mxidx) === otherIdx) {
                      o.value = (effH - thisVal).toFixed(1);
                    }
                  });
                }
              }
            }
            // Авто-перерасчёт ширин (1+2+1, три значения).
            // ПРОСТАЯ ЛОГИКА:
            //   - Меняешь центр (4) → левая и правая ВСЕГДА пересчитываются как (total-центр)/2 каждая
            //   - Меняешь левую (0) → правая остаётся, центр = total - левая - правая
            //   - Меняешь правую (3) → левая остаётся, центр = total - левая - правая
            // Если правая пересчитывается отрицательной — центр получает остаток.
            if (idx === 0 || idx === 3 || idx === 4) {
              const wMm = parseFloat(this.widthInput.value);
              if (!isNaN(wMm) && wMm > 0) {
                const inputs = this.fasadyContainer.querySelectorAll('.mixed-col-input');
                const getVal = (i) => {
                  let v = NaN;
                  inputs.forEach(o => { if (parseInt(o.dataset.mxidx) === i) v = parseFloat(o.value); });
                  return v;
                };
                const setVal = (i, val) => {
                  inputs.forEach(o => { if (parseInt(o.dataset.mxidx) === i) o.value = val.toFixed(1); });
                };
                if (idx === 4) {
                  // Меняем ЦЕНТР → левая и правая = (total - центр) / 2
                  const cVal = getVal(4);
                  if (!isNaN(cVal) && cVal >= 0 && cVal <= wMm) {
                    const sideW = (wMm - cVal) / 2;
                    if (sideW >= 0) {
                      setVal(0, sideW);
                      setVal(3, sideW);
                    }
                  }
                } else if (idx === 0) {
                  // Меняем ЛЕВУЮ → центр пересчитывается = total - левая - правая
                  const lVal = getVal(0), rVal = getVal(3);
                  if (!isNaN(lVal) && !isNaN(rVal)) {
                    const newC = wMm - lVal - rVal;
                    if (newC >= 0) {
                      setVal(4, newC);
                    } else {
                      // Если правая слишком большая — уменьшаем её, центр оставляем минимум 50
                      const minC = 50;
                      const newR = wMm - lVal - minC;
                      if (newR >= 0) { setVal(3, newR); setVal(4, minC); }
                    }
                  }
                } else if (idx === 3) {
                  // Меняем ПРАВУЮ → центр пересчитывается = total - левая - правая
                  const lVal = getVal(0), rVal = getVal(3);
                  if (!isNaN(lVal) && !isNaN(rVal)) {
                    const newC = wMm - lVal - rVal;
                    if (newC >= 0) {
                      setVal(4, newC);
                    } else {
                      const minC = 50;
                      const newL = wMm - rVal - minC;
                      if (newL >= 0) { setVal(0, newL); setVal(4, minC); }
                    }
                  }
                }
              }
            }
            this.checkSum();
            this.refreshSchema(); updateAll();
          });
        });
        this.updateMixedDefaults(false);
        this.checkSum();
        return;
      }

      if (isMixed) {
        // === Смешанная компоновка: 1 колонка-фасад на всю высоту + 2 фасада по высоте в широкой части ===
        // 4 поля по data-mxidx:
        //   0=ширина "одиночной" колонки (= левая для 1+2, правая для 2+1)
        //   1=верхний фасад широкой колонки, 2=нижний фасад широкой колонки
        //   5=ширина "широкой" колонки (= правая для 1+2, левая для 2+1) — авто-расчёт как (total - одиночная)
        // Layout (как в 1+2+1):
        //   1+2: Ряд 1: [Лев. ширина] [Прав. ширина] / Ряд 2: [пусто] [Верх. высота] [Низ. высота]
        //   2+1: Ряд 1: [Лев. ширина] [Прав. ширина] / Ряд 2: [Верх. высота] [Низ. высота] [пусто]
        const isLeftCol = this.fasadeAxis==='mixed_1plus2'; // одиночная колонка слева
        const divLeftW = document.createElement('div'); divLeftW.className='col';
        const divRightW = document.createElement('div'); divRightW.className='col';
        if (isLeftCol) {
          // 1+2: одиночная (mxidx=0) — слева в 1 grid-колонке, широкая (mxidx=5) — справа на 2 grid-колонках
          divLeftW.innerHTML = `<span class="label">Ширина лев. колонки, мм</span><input type="number" class="mixed-col-input" data-mxidx="0" step="any" min="100">`;
          divRightW.innerHTML = `<span class="label">Ширина прав. колонки, мм</span><input type="number" class="mixed-col-input" data-mxidx="5" step="any" min="100">`;
          divRightW.style.gridColumn = 'span 2';
        } else {
          // 2+1: широкая (mxidx=5) — слева на 2 grid-колонках, одиночная (mxidx=0) — справа в 1
          divLeftW.innerHTML = `<span class="label">Ширина лев. колонки, мм</span><input type="number" class="mixed-col-input" data-mxidx="5" step="any" min="100">`;
          divRightW.innerHTML = `<span class="label">Ширина прав. колонки, мм</span><input type="number" class="mixed-col-input" data-mxidx="0" step="any" min="100">`;
          divLeftW.style.gridColumn = 'span 2';
        }
        // Пара "Верх + Низ" в одной span-2 grid-ячейке под широкой колонкой
        const divPair = document.createElement('div'); divPair.className='col mixed-pair';
        divPair.style.gridColumn = 'span 2';
        divPair.innerHTML = `
          <div class="mixed-pair-item">
            <span class="label">Верх. фасад, мм</span>
            <input type="number" class="mixed-col-input" data-mxidx="1" step="any" min="100">
          </div>
          <div class="mixed-pair-item">
            <span class="label">Ниж. фасад, мм</span>
            <input type="number" class="mixed-col-input" data-mxidx="2" step="any" min="100">
          </div>`;
        const divEmpty = document.createElement('div'); divEmpty.className='col';
        // Ряд 1: ширины обеих колонок
        this.fasadyContainer.appendChild(divLeftW);
        this.fasadyContainer.appendChild(divRightW);
        // Ряд 2: высоты под колонкой с двумя фасадами (span 2 — точно совпадает с шириной широкой колонки сверху)
        if (isLeftCol) {
          // 1+2: пустая | пара (под правой широкой)
          this.fasadyContainer.appendChild(divEmpty);
          this.fasadyContainer.appendChild(divPair);
        } else {
          // 2+1: пара (под левой широкой) | пустая
          this.fasadyContainer.appendChild(divPair);
          this.fasadyContainer.appendChild(divEmpty);
        }

        this.mixedTouched = [false, false, false, false, false, false]; // индексы 0,1,2,5 используются
        this.fasadyContainer.querySelectorAll('.mixed-col-input').forEach(inp => {
          inp.addEventListener('input', () => {
            const idx = parseInt(inp.dataset.mxidx);
            this.mixedTouched[idx] = true;
            // Авто-перерасчёт нетронутой высоты при изменении одной
            if (idx === 1 || idx === 2) {
              const effH = this.getEffectiveHeight();
              const otherIdx = idx === 1 ? 2 : 1;
              if (!isNaN(effH) && !this.mixedTouched[otherIdx]) {
                const thisVal = parseFloat(inp.value);
                if (!isNaN(thisVal) && thisVal >= 0 && thisVal <= effH) {
                  const others = this.fasadyContainer.querySelectorAll('.mixed-col-input');
                  others.forEach(o => {
                    if (parseInt(o.dataset.mxidx) === otherIdx) {
                      o.value = (effH - thisVal).toFixed(1);
                    }
                  });
                }
              }
            }
            // Авто-перерасчёт второй ширины: меняешь одну → другая ВСЕГДА пересчитывается
            // (последняя тронутая = главная)
            if (idx === 0 || idx === 5) {
              const wMm = parseFloat(this.widthInput.value);
              if (!isNaN(wMm) && wMm > 0) {
                const otherIdx = idx === 0 ? 5 : 0;
                const thisVal = parseFloat(inp.value);
                if (!isNaN(thisVal) && thisVal >= 0 && thisVal <= wMm) {
                  const others = this.fasadyContainer.querySelectorAll('.mixed-col-input');
                  others.forEach(o => {
                    if (parseInt(o.dataset.mxidx) === otherIdx) {
                      o.value = (wMm - thisVal).toFixed(1);
                    }
                  });
                  // Помечаем пересчитанную как тронутую
                  this.mixedTouched[otherIdx] = true;
                }
              }
            }
            this.checkSum();
            this.refreshSchema(); updateAll();
          });
        });
        // Дефолты при заполненной геометрии тумбы
        this.updateMixedDefaults(false);
        this.checkSum();
        return;
      }

      if (isGrid) {
        // === ШИРИНЫ СТОЛБЦОВ ===
        this.gridColTouched = new Array(cols).fill(false);
        for (let c = 0; c < cols; c++) {
          const div = document.createElement('div'); div.className='col';
          const colName = cols===2 ? (c===0?'левого':'правого') : `${c+1}-го`;
          div.innerHTML = `<span class="label">Ширина ${colName} столбца, мм</span><input type="number" class="grid-col-input" data-col="${c}" step="any" min="100">`;
          this.fasadyContainer.appendChild(div);
        }
        // === ВЫСОТЫ РЯДОВ === (одна высота на весь ряд, применяется к обоим столбцам)
        for (let row = 0; row < rows; row++) {
          const div = document.createElement('div'); div.className='col';
          const rowName = rows===2 ? (row===0?'верхних':'нижних') : (row===0?'верхних':row===rows-1?'нижних':'средних');
          div.innerHTML = `<span class="label">Высота ${rowName} фасадов, мм</span><input type="number" class="fasad-input" data-row="${row}" step="any" min="100">`;
          this.fasadyContainer.appendChild(div);
        }
        // Для grid: this.fasadeTouched теперь длиной rows (по числу полей)
        this.fasadeTouched = new Array(rows).fill(false);

        // Обработчики ширин столбцов
        this.fasadyContainer.querySelectorAll('.grid-col-input').forEach((inp) => {
          inp.addEventListener('input', () => {
            const c = parseInt(inp.dataset.col);
            this.gridColTouched[c] = true;
            this.updateGridColumnWidths(false);
            this.refreshSchema(); updateAll();
          });
        });
        // Обработчики высот рядов
        this.fasadyContainer.querySelectorAll('.fasad-input').forEach((inp,idx) => {
          inp.addEventListener('input', () => { this.fasadeTouched[idx]=true; this.recalcFasades(); this.refreshSchema(); updateAll(); });
        });

        // Заполняем дефолты, если введены размеры тумбы
        const widthVal = parseFloat(this.widthInput.value);
        if (!isNaN(widthVal) && widthVal > 0) this.updateGridColumnWidths(false);
        const heightVal = parseFloat(this.heightInput.value);
        if (!isNaN(heightVal) && heightVal > 0) this.updateFasadeValues(false);
        return;
      }

      // === Обычные модели (не сетка) ===
      const axisVal = this.fasadeAxis==='height' ? parseFloat(this.heightInput.value) : parseFloat(this.widthInput.value);
      const isPenal = this.kind === 'penal';
      for (let i=0; i<count; i++) {
        const div = document.createElement('div'); div.className='col';
        const readonly = (count===1);
        const label = this.facadeLabel(i, count, this.fasadeAxis, isPenal);
        div.innerHTML = `<span class="label">${label}</span><input type="number" class="fasad-input" step="any" min="100" ${readonly?'readonly':''}>`;
        this.fasadyContainer.appendChild(div);
      }
      this.fasadyContainer.querySelectorAll('.fasad-input').forEach((inp,idx) => {
        inp.addEventListener('input', () => { this.fasadeTouched[idx]=true; this.recalcFasades(); this.refreshSchema(); updateAll(); });
      });
      if (!isNaN(axisVal)&&axisVal>0) this.updateFasadeValues(false);
    }

    updateGridColumnWidths(force) {
      // Распределяет ширину тумбы по столбцам
      const colInputs = this.fasadyContainer.querySelectorAll('.grid-col-input');
      if (!colInputs.length) return;
      const totalW = parseFloat(this.widthInput.value);
      if (isNaN(totalW)||totalW<=0) return;
      if (force) this.gridColTouched = new Array(colInputs.length).fill(false);
      // Если ничего не тронуто — равномерно
      if (this.gridColTouched.every(t=>!t)) {
        const each = totalW / colInputs.length;
        colInputs.forEach(inp => inp.value = each.toFixed(1));
        return;
      }
      // Иначе нетронутые получают остаток
      let sum=0, untouched=[];
      colInputs.forEach((inp, i) => {
        if (this.gridColTouched[i]) { const v=parseFloat(inp.value); sum += isNaN(v)?0:v; }
        else untouched.push(i);
      });
      if (untouched.length===0) return;
      const each = (totalW - sum) / untouched.length;
      untouched.forEach(i => colInputs[i].value = each.toFixed(1));
    }
    // Дефолты для смешанной компоновки (BL06 / BL07): ширина одной колонки = 1/3 от общей,
    // высоты двух фасадов в широкой части — 50/50 от эффективной высоты.
    updateMixedDefaults(force) {
      const inputs = this.fasadyContainer.querySelectorAll('.mixed-col-input');
      // Возможные размеры: 4 поля (mixed_1plus2/2plus1) или 5 полей (1+2+1)
      if (inputs.length !== 4 && inputs.length !== 5) return;
      const totalW = parseFloat(this.widthInput.value);
      const effH = this.getEffectiveHeight();
      const N = inputs.length;
      if (force) this.mixedTouched = new Array(6).fill(false);
      if (!this.mixedTouched || this.mixedTouched.length < 6) this.mixedTouched = new Array(6).fill(false);
      // Маппинг data-mxidx → DOM-элемент
      const inpByIdx = {};
      inputs.forEach(inp => {
        const idx = parseInt(inp.dataset.mxidx);
        inpByIdx[idx] = inp;
      });
      if (N === 4) {
        // mixed_1plus2 / mixed_2plus1: idx 0 = одиночная колонка, 5 = широкая колонка, 1 = верх, 2 = низ
        if (!isNaN(totalW) && totalW > 0) {
          if (!this.mixedTouched[0] && inpByIdx[0]) inpByIdx[0].value = (totalW / 3).toFixed(1);
          if (!this.mixedTouched[5] && inpByIdx[5]) inpByIdx[5].value = (totalW * 2 / 3).toFixed(1);
        }
        if (!isNaN(effH) && effH > 0) {
          if (!this.mixedTouched[1] && inpByIdx[1]) inpByIdx[1].value = (effH / 2).toFixed(1);
          if (!this.mixedTouched[2] && inpByIdx[2]) inpByIdx[2].value = (effH / 2).toFixed(1);
        }
      } else if (N === 5) {
        // mixed_1plus2plus1: idx 0 = левая, 1 = верх центр, 2 = низ центр, 3 = правая, 4 = центр-ширина
        // Дефолт: левая = правая = 1/4 ширины тумбы (боковины по 25%, центр 50%)
        if (!isNaN(totalW) && totalW > 0) {
          if (!this.mixedTouched[0] && inpByIdx[0]) inpByIdx[0].value = (totalW / 4).toFixed(1);
          if (!this.mixedTouched[3] && inpByIdx[3]) inpByIdx[3].value = (totalW / 4).toFixed(1);
          if (!this.mixedTouched[4] && inpByIdx[4]) inpByIdx[4].value = (totalW / 2).toFixed(1);
        }
        if (!isNaN(effH) && effH > 0) {
          if (!this.mixedTouched[1] && inpByIdx[1]) inpByIdx[1].value = (effH / 2).toFixed(1);
          if (!this.mixedTouched[2] && inpByIdx[2]) inpByIdx[2].value = (effH / 2).toFixed(1);
        }
      }
    }
    // Цоколь занимает 50 мм при «Напольная без ножек» — отнимается от высоты для фасадов
    getCokolHeight() {
      return (this.mountSelect && this.mountSelect.value === 'floor') ? COKOL_HEIGHT_MM : 0;
    }
    // Доступная высота для фасадов (внутренняя)
    getEffectiveHeight() {
      const h = parseFloat(this.heightInput.value);
      if (isNaN(h)) return NaN;
      return h - this.getCokolHeight();
    }
    // Обновить подсказку про цоколь под полями фасадов
    updateCokolHint() {
      const hint = document.getElementById(`cokol-hint-${this.idp}`);
      const heightHint = document.getElementById(`height-hint-${this.idp}`);
      const cokol = this.getCokolHeight();
      // Подсказка под полем "Высота" — реальная высота тела (без цоколя)
      if (heightHint) {
        const fullH = parseFloat(this.heightInput?.value);
        if (cokol > 0 && !isNaN(fullH) && fullH > 0) {
          const bodyH = fullH - cokol;
          heightHint.textContent = `тело ${bodyH} + цоколь ${cokol} мм`;
          heightHint.style.display = 'block';
        } else {
          heightHint.style.display = 'none';
        }
      }
      // Старая подсказка под фасадами (только для моделей с фасадами по высоте)
      if (!hint) return;
      if (cokol > 0 && this.currentModel && (this.fasadeAxis === 'height' || this.fasadeAxis === 'grid')) {
        const eff = this.getEffectiveHeight();
        if (!isNaN(eff) && eff > 0) {
          hint.textContent = `Цоколь: ${cokol} мм • Высота для фасадов: ${eff.toFixed(0)} мм`;
          hint.style.display = 'block';
        } else {
          hint.style.display = 'none';
        }
      } else {
        hint.style.display = 'none';
      }
    }

    updateFasadeValues(force) {
      const inputs = this.fasadyContainer.querySelectorAll('.fasad-input');
      if (inputs.length===0) return;
      if (force) this.fasadeTouched = new Array(inputs.length).fill(false);

      // GRID: одно поле на ряд, сумма = высота − цоколь
      if (this.fasadeAxis === 'grid') {
        const totalH = this.getEffectiveHeight();
        if (isNaN(totalH)||totalH<=0) return;
        const rows = (this.currentModel && this.currentModel.gridRows) || 2;
        if (inputs.length !== rows) return;
        if (this.fasadeTouched.every(t=>!t)) {
          const each = totalH / rows;
          inputs.forEach(inp => inp.value = each.toFixed(1));
          return;
        }
        let sum = 0, untouched = [];
        for (let i = 0; i < inputs.length; i++) {
          if (this.fasadeTouched[i]) { const v=parseFloat(inputs[i].value); sum += isNaN(v)?0:v; }
          else untouched.push(i);
        }
        if (untouched.length === 0) return;
        const each = (totalH - sum) / untouched.length;
        untouched.forEach(i => inputs[i].value = each.toFixed(1));
        return;
      }

      // HEIGHT: сумма фасадов = высота − цоколь. WIDTH: сумма = ширина (цоколь не влияет)
      const total = this.fasadeAxis==='height' ? this.getEffectiveHeight() : parseFloat(this.widthInput.value);
      if (isNaN(total)||total<=0) return;
      if (inputs.length===1) { inputs[0].value=total.toFixed(1); return; }
      if (this.fasadeTouched.every(t=>!t)) { const each=total/inputs.length; inputs.forEach(inp=>inp.value=each.toFixed(1)); return; }
      let sum=0, untouched=[];
      for (let i=0;i<inputs.length;i++) {
        if (this.fasadeTouched[i]) { const v=parseFloat(inputs[i].value); sum+=isNaN(v)?0:v; } else untouched.push(i);
      }
      if (untouched.length===0) return;
      const each=(total-sum)/untouched.length;
      untouched.forEach(i=>inputs[i].value=each.toFixed(1));
    }
    recalcFasades() { this.updateFasadeValues(false); this.checkSum(); }
    checkSum() {
      // MIXED 1+2+1 (5 полей): левая + центр-ширина + правая + верх центр + низ центр
      if (this.fasadeAxis === 'mixed_1plus2plus1') {
        const mixedInputs = this.fasadyContainer.querySelectorAll('.mixed-col-input');
        if (!mixedInputs.length || !this.fasadyError) return;
        const valByIdx = {};
        mixedInputs.forEach(inp => {
          const idx = parseInt(inp.dataset.mxidx);
          valByIdx[idx] = parseFloat(inp.value);
        });
        const leftW = valByIdx[0];
        const topH = valByIdx[1];
        const botH = valByIdx[2];
        const rightW = valByIdx[3];
        const centerW = valByIdx[4];
        const totalW = parseFloat(this.widthInput.value);
        const effH = this.getEffectiveHeight();
        const errs = [];
        // Сумма ширин трёх колонок = общая ширина
        if (!isNaN(totalW) && !isNaN(leftW) && !isNaN(centerW) && !isNaN(rightW)) {
          const sumW = leftW + centerW + rightW;
          if (Math.abs(sumW - totalW) >= 0.5) {
            errs.push(`Сумма ширин трёх колонок (${sumW.toFixed(0)} мм) должна равняться ширине тумбы (${totalW.toFixed(0)} мм).`);
          }
        }
        if (!isNaN(centerW) && centerW < 50) {
          errs.push(`Центральная колонка должна быть минимум 50 мм.`);
        }
        if (!isNaN(effH) && !isNaN(topH) && !isNaN(botH)) {
          const sum = topH + botH;
          if (Math.abs(sum - effH) >= 0.01) {
            const cokol = this.getCokolHeight();
            errs.push(cokol > 0
              ? `Сумма высот центральных фасадов должна равняться ${effH.toFixed(0)} мм (высота минус цоколь ${cokol} мм). Сейчас: ${sum.toFixed(0)} мм.`
              : `Сумма высот центральных фасадов должна равняться высоте тумбы (${effH.toFixed(0)} мм). Сейчас: ${sum.toFixed(0)} мм.`);
          }
        }
        this.fasadyError.style.display = errs.length ? 'block' : 'none';
        this.fasadyError.textContent = errs.join(' ');
        return;
      }
      // MIXED: 4 поля — одиночная колонка + широкая колонка + 2 высоты широкой части (читаем по data-mxidx)
      if (this.fasadeAxis === 'mixed_1plus2' || this.fasadeAxis === 'mixed_2plus1') {
        const mixedInputs = this.fasadyContainer.querySelectorAll('.mixed-col-input');
        if (!mixedInputs.length || !this.fasadyError) return;
        const valByIdx = {};
        mixedInputs.forEach(inp => {
          const idx = parseInt(inp.dataset.mxidx);
          valByIdx[idx] = parseFloat(inp.value);
        });
        const colW = valByIdx[0]; // одиночная колонка
        const wideW = valByIdx[5]; // широкая колонка
        const topH = valByIdx[1];
        const botH = valByIdx[2];
        const totalW = parseFloat(this.widthInput.value);
        const effH = this.getEffectiveHeight();
        const errs = [];
        // Сумма ширин = общая
        if (!isNaN(totalW) && !isNaN(colW) && !isNaN(wideW)) {
          const sumW = colW + wideW;
          if (Math.abs(sumW - totalW) >= 0.5) {
            errs.push(`Сумма ширин двух колонок (${sumW.toFixed(0)} мм) должна равняться ширине тумбы (${totalW.toFixed(0)} мм).`);
          }
        }
        if (!isNaN(colW) && colW < 50) {
          errs.push(`Ширина одиночной колонки минимум 50 мм.`);
        }
        if (!isNaN(wideW) && wideW < 100) {
          errs.push(`Ширина широкой колонки минимум 100 мм.`);
        }
        if (!isNaN(effH) && !isNaN(topH) && !isNaN(botH)) {
          const sum = topH + botH;
          if (Math.abs(sum - effH) >= 0.01) {
            const cokol = this.getCokolHeight();
            errs.push(cokol > 0
              ? `Сумма высот двух фасадов должна равняться ${effH.toFixed(0)} мм (высота минус цоколь ${cokol} мм). Сейчас: ${sum.toFixed(0)} мм.`
              : `Сумма высот двух фасадов должна равняться высоте тумбы (${effH.toFixed(0)} мм). Сейчас: ${sum.toFixed(0)} мм.`);
          }
        }
        this.fasadyError.style.display = errs.length ? 'block' : 'none';
        this.fasadyError.textContent = errs.join(' ');
        return;
      }
      const inputs = this.fasadyContainer.querySelectorAll('.fasad-input'); if (!inputs.length) return;
      // GRID: сумма высот рядов = высота − цоколь
      if (this.fasadeAxis === 'grid') {
        const totalH = this.getEffectiveHeight();
        if (isNaN(totalH)) { this.fasadyError.style.display='none'; return; }
        const sum = Array.from(inputs).reduce((s,el)=>s+(parseFloat(el.value)||0),0);
        const mismatch = Math.abs(sum - totalH) >= 0.01;
        this.fasadyError.style.display = mismatch ? 'block' : 'none';
        if (mismatch) {
          const cokol = this.getCokolHeight();
          this.fasadyError.textContent = cokol > 0
            ? `Сумма высот рядов должна равняться ${totalH.toFixed(0)} мм (высота тумбы минус цоколь ${cokol} мм).`
            : 'Сумма высот рядов должна равняться высоте тумбы.';
        }
        return;
      }
      const total = this.fasadeAxis==='height' ? this.getEffectiveHeight() : parseFloat(this.widthInput.value);
      if (isNaN(total)) return;
      const sum = Array.from(inputs).reduce((s,el)=>s+(parseFloat(el.value)||0),0);
      this.fasadyError.style.display = Math.abs(sum-total)<0.01?'none':'block';
      if (this.fasadyError.style.display!=='none') {
        const cokol = this.getCokolHeight();
        if (this.fasadeAxis==='height') {
          this.fasadyError.textContent = cokol > 0
            ? `Сумма высот фасадов должна равняться ${total.toFixed(0)} мм (высота минус цоколь ${cokol} мм).`
            : `Сумма высот фасадов должна равняться высоте ${this.kind==='penal'?'пенала':'тумбы'}.`;
        } else {
          this.fasadyError.textContent = 'Сумма ширин фасадов должна равняться ширине тумбы.';
        }
      }
    }
    // axis: 'width' | 'depth' | 'height' — какая ось была изменена (опционально)
    handleAxisChange(axis) {
      if (!this.currentModel) return;
      if (this.currentModel.fasades>0 && this.currentModel.fasades===this.currentFasadeCount) {
        const fAxis = this.fasadeAxis;
        const isAnyMixed = (fAxis === 'mixed_1plus2' || fAxis === 'mixed_2plus1' || fAxis === 'mixed_1plus2plus1');
        if (axis !== undefined) {
          if (fAxis === 'height' && axis === 'height') {
            this.updateFasadeValues(true);
          } else if (fAxis === 'width' && axis === 'width') {
            this.updateFasadeValues(true);
          } else if (fAxis === 'grid') {
            if (axis === 'height') this.updateFasadeValues(true);
            if (axis === 'width') this.updateGridColumnWidths(true);
          } else if (isAnyMixed) {
            this.updateMixedDefaults(true);
            this.checkSum();
          }
        } else {
          this.updateFasadeValues(true);
          if (fAxis === 'grid') this.updateGridColumnWidths(true);
          if (isAnyMixed) this.updateMixedDefaults(true);
        }
      }
    }
    loadModel(mKey) {
      const cKey = this.colSelect.value;
      if (!cKey||!mKey) { this.clearModel(); return; }
      const models = collections[cKey].models?.[this.type];
      if (!models||!models[mKey]) { this.clearModel(); return; }
      this.currentModel = models[mKey];
      const prevAxis = this.fasadeAxis;
      this.fasadeAxis = this.currentModel.fasadeAxis||'width';
      const count = this.currentModel.fasades;
      // Пересоздаём поля если: изменилось количество фасадов ИЛИ изменился тип компоновки (axis)
      const axisChanged = (prevAxis !== this.fasadeAxis);
      if (count!==this.currentFasadeCount || axisChanged) {
        this.currentFasadeCount = count;
        if (count>0) { this.fasadyBlock.style.display='block'; this.createFasadeInputs(count); }
        else this.fasadyBlock.style.display='none';
      } else if (count>0) { this.updateFasadeValues(true); }
      this.refreshSchema();
      this.updateCokolHint();
      this.updateHingeVisibility();
      this.updateSizePlaceholders();
    }
    // Обновляет подсказки (placeholder) полей размеров под диапазоны текущей модели
    updateSizePlaceholders() {
      if (!this.currentModel) return;
      const fmt = (ranges) => ranges.map(r => `${r[0]}–${r[1]}`).join(', ');
      if (this.widthInput && this.currentModel.width)  this.widthInput.placeholder  = fmt(this.currentModel.width);
      if (this.depthInput && this.currentModel.depth)  this.depthInput.placeholder  = fmt(this.currentModel.depth);
      if (this.heightInput && this.currentModel.height) this.heightInput.placeholder = fmt(this.currentModel.height);
    }
    // Сторона открывания (петли) — только для пеналов с одним столбцом фасадов
    updateHingeVisibility() {
      const block = document.getElementById(`hinge-block-${this.idp}`);
      if (!block) return;
      const isSingleColumnPenal = this.kind === 'penal' && this.fasadeAxis === 'height' && this.currentModel;
      block.style.display = isSingleColumnPenal ? 'flex' : 'none';
    }
    clearModel() {
      hideSchema(`schema-${this.idp}`);
      if (this.fasadyBlock) this.fasadyBlock.style.display='none';
      const hingeBlock = document.getElementById(`hinge-block-${this.idp}`);
      if (hingeBlock) hingeBlock.style.display = 'none';
      this.currentModel = null;
    }
    resetDimensions() {
