    const padL = 14, padT = 22;
    const totalW = W + dx + padL * 2;
    const totalH = H + dy + padT + legH + 12;
    const x0 = padL, y0 = padT + dy;

    const corpusColor = bodyColor || '#F1ECE0';
    const strokeColor = '#5a4f56';
    const trim = TRIM_COLORS[trimColor] || TRIM_COLORS.gold;
    const refH_mm = (h_mm && !isNaN(h_mm) && h_mm > 0) ? h_mm : 1500;
    // Опорный размер для рамок и колец-ручек: единый для всех фасадов на пенале.
    // Для пенала ширина мала, фасадов по высоте обычно 2-3 — берём среднее значение.
    const avalonScaleRef = Math.min(W * 0.85, H * 0.30);

    let svg = `<svg viewBox="0 0 ${totalW} ${totalH}" xmlns="http://www.w3.org/2000/svg" style="width:auto;max-width:240px;max-height:240px;display:block;margin:0 auto;">`;

    if (onFloor || hasLegs) {
      const fy = y0 + H + legH - dy;
      svg += `<line x1="${padL - 6}" y1="${fy}" x2="${totalW - 4}" y2="${fy}" stroke="#888" stroke-width="1.4"/>`;
    }
    if (isWall) {
      const shadowY = y0 + H + 4;
      svg += `<ellipse cx="${x0 + W/2 + dx/2}" cy="${shadowY}" rx="${W/1.6}" ry="5" fill="rgba(0,0,0,0.14)"/>`;
    }

    const fasadeRender = (fX, fY, fW, fH, cargaH) => {
      let s = '';
      const gap = Math.max(2, Math.min(fW, fH) * 0.012);
      if (isGrid) {
        const cols = gridCols || 2;
        const rows = gridRows || 2;
        const totalCarga = cargaH * (rows - 1);
        const usableH = fH - totalCarga;
        let rowHs = [];
        if (fasadeHeights && fasadeHeights.length === rows) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) rowHs = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (rowHs.length === 0) rowHs = new Array(rows).fill(usableH / rows);
        let colWs = [];
        if (gridColWidths && gridColWidths.length === cols) {
          const sumW = gridColWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumW > 0) colWs = gridColWidths.map(v => (parseFloat(v)||0) / sumW * fW);
        }
        if (colWs.length === 0) colWs = new Array(cols).fill(fW / cols);
        let cy = fY;
        for (let row = 0; row < rows; row++) {
          let cx = fX;
          for (let col = 0; col < cols; col++) {
            const fw = colWs[col] - (col < cols - 1 ? gap : 0);
            s += renderAvalonFacade(cx, cy, fw, rowHs[row], corpusColor, trim, avalonScaleRef);
            cx += colWs[col];
          }
          cy += rowHs[row];
          if (row < rows - 1) {
            s += `<rect x="${fX}" y="${cy}" width="${fW}" height="${cargaH}"
              fill="${corpusColor}" stroke="rgba(0,0,0,0.10)" stroke-width="0.5"/>`;
            cy += cargaH;
          }
        }
      } else {
        const totalCarga = cargaH * (fasades - 1);
        const usableH = fH - totalCarga;
        let heights = [];
        if (fasadeHeights && fasadeHeights.length === fasades) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) heights = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (heights.length === 0) heights = new Array(fasades).fill(usableH / fasades);
        let cy = fY;
        for (let i = 0; i < fasades; i++) {
          s += renderAvalonFacade(fX, cy, fW, heights[i], corpusColor, trim, avalonScaleRef);
          cy += heights[i];
          if (i < fasades - 1) {
            s += `<rect x="${fX}" y="${cy}" width="${fW}" height="${cargaH}"
              fill="${corpusColor}" stroke="rgba(0,0,0,0.10)" stroke-width="0.5"/>`;
            cy += cargaH;
          }
        }
      }
      return s;
    };

    svg += renderAvalonBody({
      x0, y0, W, H, dx, dy,
      bodyColor: corpusColor,
      trim,
      refH_mm,
      onFloor, hasLegs,
      hasTopCarga: false,  // у пенала нет верхней царги
      fasadeRender,
      strokeColor
    });

    if (hasLegs) {
      const legInset = (W / (w_mm || 600)) * 50;
      const legW = Math.max(6, W * 0.04);
      [x0 + legInset, x0 + W - legInset - legW].forEach(lx => {
        svg += renderAvalonLeg(lx, y0 + H, legW, legH, trim);
      });
    }

    svg += `</svg>`;
    return svg;
  }

  // ============================================================================
  // SVG ТУМБЫ И ПЕНАЛА — стиль "Вертекс"
  //  - Корпус-коробка как у Элемента (фасад заподлицо с боковинами)
  //  - НЕТ ручек: открывание через скос 45° между фасадами
  //  - На схеме скос показан диагональной тёмной линией ~45° в каждом стыке
  //  - Поддерживает те же фрезеровки что у Эриадора
  //  - Без верхней царги (тумба и пенал)
  //  - Без столешницы (она добавляется отдельной категорией)
  // ============================================================================

  // Хелпер: одна диагональная щель-скос 45° между двумя соседними фасадами.
  // dir = 'h' для горизонтальной щели (между верхним и нижним фасадом)
  // dir = 'v' для вертикальной щели (между левым и правым фасадом)
  // Координаты (x, y) — левый-верхний угол щели; w/h — её размеры (узкая полоса).
  // Вертекс: горизонтальный V-образный скос-ручка 45°.
  // Это "ручка коллекции" — захват для открывания, идёт между фасадами по высоте,
  // между крышкой корпуса и верхним фасадом, и снизу одиночного фасада в пенале.
  function renderVertexBevel(x, y, w, h) {
    const dark = 'rgba(0,0,0,0.50)';
    const darker = 'rgba(0,0,0,0.68)';
    const light = 'rgba(255,255,255,0.28)';
    const seam = 'rgba(0,0,0,0.85)';
    let s = '';
    const yMid = y + h / 2;
    // Верхняя половина — диагональная грань уходит вниз-внутрь (тень)
    s += `<polygon points="${x},${y} ${x + w},${y} ${x + w},${yMid} ${x},${yMid}" fill="${darker}"/>`;
    // Нижняя половина — диагональная грань возвращается наружу (свет слева сверху)
    s += `<polygon points="${x},${yMid} ${x + w},${yMid} ${x + w},${y + h} ${x},${y + h}" fill="${dark}"/>`;
    // Светлый блик на границе нижней грани
    s += `<line x1="${x}" y1="${yMid + 0.5}" x2="${x + w}" y2="${yMid + 0.5}" stroke="${light}" stroke-width="0.5"/>`;
    // Глубокий шов в середине V
    s += `<line x1="${x}" y1="${yMid}" x2="${x + w}" y2="${yMid}" stroke="${seam}" stroke-width="0.7"/>`;
    return s;
  }

  // Хелпер: один фасад Вертекса с возможной фрезеровкой (использует ту же логику что Эриадор).
  function renderVertexFacade(x, y, w, h, color, pattern) {
    if (w <= 0 || h <= 0) return '';
    let s = '';
    s += `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${color}" stroke="rgba(0,0,0,0.22)" stroke-width="0.5"/>`;
    if (pattern && pattern !== 'flat') {
      s += renderFacadePattern(x, y, w, h, pattern);
    }
    return s;
  }

  function svgCabinetVertex(params) {
    const {
      fasades, mountType, w_mm, d_mm, h_mm,
      fasadeWidths, fasadeHeights, fasadeAxis,
      gridCols, gridRows, gridColWidths,
      mixedSingleColW, mixedTopH, mixedBottomH, mixedLeftW, mixedRightW, mixedCenterW,
      bodyColor, isBodyGlossy,
      facadePattern
    } = params;
    const isWall = mountType === 'wall' || !mountType;
    const hasLegs = mountType === 'floor_legs';
    const onFloor = mountType === 'floor';
    const isVertical = fasadeAxis === 'height';
    const isGridFasades = fasadeAxis === 'grid';
    const isMixed = fasadeAxis === 'mixed_1plus2' || fasadeAxis === 'mixed_2plus1';
    const isMixed3 = fasadeAxis === 'mixed_1plus2plus1';

    const SC = computeSmartScale(w_mm, d_mm, h_mm, {w:1500, d:500, h:600}, 240, 240);
    const W = SC.W_px;
    const H = SC.H_px;
    const D = SC.D_px * DEPTH_VISUAL_FACTOR;
    const dx = D * ISO_DX, dy = D * ISO_DY;
    const legH = hasLegs ? 22 : 0;
    const padL = 14, padT = 22;
    const totalW = W + dx + padL * 2;
    const totalH = H + dy + padT + legH + 12;
    const x0 = padL, y0 = padT + dy;

    const corpusColor = bodyColor || '#F1ECE0';
    const strokeColor = '#5a4f56';
    const refH_mm = (h_mm && !isNaN(h_mm) && h_mm > 0) ? h_mm : 600;
    const cokolH = onFloor ? Math.max(8, (H / refH_mm) * 50) : 0;
    // Высота V-образного скоса-ручки (заметная горизонтальная полоса)
    const bevelH = Math.max(4, Math.min(W, H) * 0.025);
    // Ширина тонкой тёмной щели между фасадами по ширине (без скоса)
    const colGap = Math.max(1.5, W * 0.008);

    let svg = `<svg viewBox="0 0 ${totalW} ${totalH}" xmlns="http://www.w3.org/2000/svg" style="width:auto;max-width:300px;max-height:300px;display:block;margin:0 auto;">`;

    if (onFloor || hasLegs) {
      const fy = y0 + H + legH - dy;
      svg += `<line x1="${padL - 6}" y1="${fy}" x2="${totalW - 4}" y2="${fy}" stroke="#888" stroke-width="1.4"/>`;
    }
    if (isWall) {
      const shadowY = y0 + H + 4;
      svg += `<ellipse cx="${x0 + W/2 + dx/2}" cy="${shadowY}" rx="${W/2.2}" ry="6" fill="rgba(0,0,0,0.14)"/>`;
    }

    // Верхняя грань корпуса (плоская крышка)
    svg += `<polygon points="
      ${x0},${y0}
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + dx},${y0 - dy}
    " fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;

    // Правая боковая глубина
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + H - dy}
      ${x0 + W},${y0 + H}
    " fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + H - dy}
      ${x0 + W},${y0 + H}
    " fill="rgba(0,0,0,0.18)" stroke="none"/>`;

    // Передняя грань — фон (того же цвета что фасады)
    svg += `<rect x="${x0}" y="${y0}" width="${W}" height="${H}"
      fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;

    // === ВЕРХНИЙ СКОС-РУЧКА (всегда, даже при 1 фасаде) ===
    // Это V-образная полоса между крышкой корпуса и верхним фасадом — ручка коллекции
    svg += renderVertexBevel(x0, y0, W, bevelH);

    // Зона фасадов начинается ПОСЛЕ верхнего скоса-ручки
    const fasadeTopY = y0 + bevelH;
    const fasadeBotY = y0 + H - cokolH;
    const fasadeAreaH = fasadeBotY - fasadeTopY;
    const fInnerW = W;

    // Хелпер: рисует тонкую тёмную вертикальную щель между колонками фасадов
    const drawColGap = (cx, cy, ch) => {
      return `<rect x="${cx}" y="${cy}" width="${colGap}" height="${ch}" fill="rgba(0,0,0,0.42)"/>`;
    };

    if (fasadeAreaH > 4 && fInnerW > 4) {
      if (isMixed3) {
        svg += renderTriColumnLayout({
          x0, y0: fasadeTopY, fInnerW, fasadeAreaH,
          w_mm, effH_mm: h_mm,
          leftW_mm: mixedLeftW || 0,
          rightW_mm: mixedRightW || 0,
          centerW_mm: mixedCenterW || 0,
          topH_mm: mixedTopH || 0,
          bottomH_mm: mixedBottomH || 0,
          gap: colGap,
          carga_px: bevelH,
          drawFacade: (fx, fy, fw, fh) => renderVertexFacade(fx, fy, fw, fh, corpusColor, facadePattern),
          drawCarga: (cx, cy, cw, ch) => renderVertexBevel(cx, cy, cw, ch)
        });
      } else if (isMixed) {
        // Смешанная компоновка 1+2 / 2+1: одна колонка одиночная, другая разделена по высоте на 2.
        // У Vertex между двумя широкими фасадами должен быть СКОС-РУЧКА (между фасадами по высоте),
        // а между двумя колонками — обычная тонкая щель.
        svg += renderMixedFasadeLayout({
          x0, y0: fasadeTopY, fInnerW, fasadeAreaH,
          axis: fasadeAxis, w_mm, effH_mm: h_mm,
          singleColW_mm: mixedSingleColW || 0,
          topH_mm: mixedTopH || 0,
          bottomH_mm: mixedBottomH || 0,
          gap: colGap,
          carga_px: bevelH,
          drawFacade: (fx, fy, fw, fh) => renderVertexFacade(fx, fy, fw, fh, corpusColor, facadePattern),
          drawCarga: (cx, cy, cw, ch) => renderVertexBevel(cx, cy, cw, ch)
        });
      } else if (isGridFasades) {
        const cols = gridCols || 2;
        const rows = gridRows || 2;
        // Между рядами — горизонтальный скос-ручка (bevelH)
        const totalBevel = bevelH * (rows - 1);
        const usableH = fasadeAreaH - totalBevel;
        let rowHs = [];
        if (fasadeHeights && fasadeHeights.length === rows) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) rowHs = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (rowHs.length === 0) rowHs = new Array(rows).fill(usableH / rows);
        let colWs = [];
        if (gridColWidths && gridColWidths.length === cols) {
          const sumW = gridColWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumW > 0) colWs = gridColWidths.map(v => (parseFloat(v)||0) / sumW * fInnerW);
        }
        if (colWs.length === 0) colWs = new Array(cols).fill(fInnerW / cols);
        let cy = fasadeTopY;
        for (let row = 0; row < rows; row++) {
          let cx = x0;
          for (let col = 0; col < cols; col++) {
            const fw = colWs[col] - (col < cols - 1 ? colGap : 0);
            svg += renderVertexFacade(cx, cy, fw, rowHs[row], corpusColor, facadePattern);
            // Вертикальная тёмная щель между колонками
            if (col < cols - 1) {
              svg += drawColGap(cx + fw, cy, rowHs[row]);
            }
            cx += colWs[col];
          }
          cy += rowHs[row];
          // Горизонтальный скос-ручка между рядами
          if (row < rows - 1) {
            svg += renderVertexBevel(x0, cy, fInnerW, bevelH);
            cy += bevelH;
          }
        }
      } else if (isVertical) {
        // Несколько фасадов по высоте — между ними скос-ручка
        const totalBevel = bevelH * (fasades - 1);
        const usableH = fasadeAreaH - totalBevel;
        let heights = [];
        if (fasadeHeights && fasadeHeights.length === fasades) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) heights = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (heights.length === 0) heights = new Array(fasades).fill(usableH / fasades);
        let cy = fasadeTopY;
        for (let i = 0; i < fasades; i++) {
          svg += renderVertexFacade(x0, cy, fInnerW, heights[i], corpusColor, facadePattern);
          cy += heights[i];
          if (i < fasades - 1) {
            svg += renderVertexBevel(x0, cy, fInnerW, bevelH);
            cy += bevelH;
          }
        }
      } else {
        // Несколько фасадов по ширине — обычные тонкие щели между ними (без скосов)
        let widths = [];
        if (fasadeWidths && fasadeWidths.length === fasades) {
          const sumW = fasadeWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumW > 0) widths = fasadeWidths.map(v => (parseFloat(v)||0) / sumW * fInnerW);
        }
        if (widths.length === 0) widths = new Array(fasades).fill(fInnerW / fasades);
        let cx = x0;
        for (let i = 0; i < fasades; i++) {
          const fw = widths[i] - (i < fasades - 1 ? colGap : 0);
          svg += renderVertexFacade(cx, fasadeTopY, fw, fasadeAreaH, corpusColor, facadePattern);
          if (i < fasades - 1) {
            svg += drawColGap(cx + fw, fasadeTopY, fasadeAreaH);
          }
          cx += widths[i];
        }
      }
    }

    // Цоколь (только при mountType='floor')
    if (cokolH > 0) {
      svg += `<rect x="${x0}" y="${fasadeBotY}" width="${W}" height="${cokolH}"
        fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.6"/>`;
      svg += `<rect x="${x0}" y="${fasadeBotY - 0.6}" width="${W}" height="1.2"
        fill="rgba(0,0,0,0.40)"/>`;
    }

    // Ножки (опционально)
    if (hasLegs) {
      const legInset = (W / (w_mm || 1500)) * 50;
      const legW = 9;
      [x0 + legInset, x0 + W - legInset - legW].forEach(lx => {
        svg += `<rect x="${lx}" y="${y0 + H}" width="${legW}" height="${legH}" fill="#1a1a1a" opacity="0.92"/>`;
      });
    }

    svg += `</svg>`;
    return svg;
  }

  function svgPenalVertex(params) {
    const {
      fasades, mountType, w_mm, d_mm, h_mm,
      fasadeHeights, fasadeAxis,
      gridCols, gridRows, gridColWidths,
      bodyColor, isBodyGlossy,
      facadePattern
    } = params;
    const isWall = mountType === 'wall' || !mountType;
    const onFloor = mountType === 'floor';
    const hasLegs = mountType === 'floor_legs';
    const isGrid = fasadeAxis === 'grid';

    const SC = computeSmartScale(w_mm, d_mm, h_mm, {w:600, d:400, h:1500}, 240, 240);
    const W = SC.W_px;
    const H = SC.H_px;
    const D = SC.D_px * DEPTH_VISUAL_FACTOR;
    const dx = D * ISO_DX, dy = D * ISO_DY;
    const legH = hasLegs ? 18 : 0;
    const padL = 12, padT = 18;
    const totalW = W + dx + padL * 2;
    const totalH = H + dy + padT + legH + 12;
    const x0 = padL, y0 = padT + dy;

    const corpusColor = bodyColor || '#F1ECE0';
    const strokeColor = '#5a4f56';
    const refH_mm = (h_mm && !isNaN(h_mm) && h_mm > 0) ? h_mm : 1500;
    const cokolH_p = onFloor ? Math.max(6, (H / refH_mm) * 50) : 0;
    // V-образный скос-ручка (горизонтальная полоса)
    const bevelH = Math.max(3, Math.min(W, H) * 0.012);
    const colGap = Math.max(1.5, W * 0.008);

    let svg = `<svg viewBox="0 0 ${totalW} ${totalH}" xmlns="http://www.w3.org/2000/svg" style="width:auto;max-width:240px;max-height:240px;display:block;margin:0 auto;">`;

    if (onFloor || hasLegs) {
      const fy = y0 + H + legH - dy;
      svg += `<line x1="${padL - 6}" y1="${fy}" x2="${totalW - 4}" y2="${fy}" stroke="#888" stroke-width="1.4"/>`;
    }
    if (isWall) {
      const shadowY = y0 + H + 4;
      svg += `<ellipse cx="${x0 + W/2 + dx/2}" cy="${shadowY}" rx="${W/1.6}" ry="5" fill="rgba(0,0,0,0.14)"/>`;
    }

    // Верхняя грань
    svg += `<polygon points="
      ${x0},${y0}
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + dx},${y0 - dy}
    " fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;

    // Правая боковая
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + H - dy}
      ${x0 + W},${y0 + H}
    " fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + H - dy}
      ${x0 + W},${y0 + H}
    " fill="rgba(0,0,0,0.20)" stroke="none"/>`;

    // Передняя грань — фон того же цвета что фасады
    svg += `<rect x="${x0}" y="${y0}" width="${W}" height="${H}"
      fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;

    // === ЛОГИКА СКОСОВ В ПЕНАЛЕ ===
    // - Между фасадами по высоте → скос-ручка (между рядами): открывают верхний фасад снизу,
    //   нижний фасад сверху — оба захвата находятся в среднем стыке.
    // - При одном фасаде → скос-ручка СНИЗУ (открываешь тянув за низ).
    // - Сверху корпуса (между крышкой и фасадом) → НЕТ скоса (обычная тонкая щель).
    const isSingleFasadePenal = !isGrid && fasades === 1;

    // Тонкая тёмная щель сверху между крышкой и верхним фасадом (без скоса)
    const topGapH = Math.max(1, H * 0.004);
    svg += `<rect x="${x0}" y="${y0}" width="${W}" height="${topGapH}"
      fill="rgba(0,0,0,0.42)"/>`;

    const fasadeTopY = y0 + topGapH;
    // При одиночном фасаде снизу — скос-ручка
    const bottomBevelH = isSingleFasadePenal ? bevelH : 0;
    const fasadeBotY = y0 + H - cokolH_p - bottomBevelH;
    const fasadeAreaH = fasadeBotY - fasadeTopY;
    const fInnerW = W;

    const drawColGap = (cx, cy, ch) => {
      return `<rect x="${cx}" y="${cy}" width="${colGap}" height="${ch}" fill="rgba(0,0,0,0.42)"/>`;
    };

    if (fasadeAreaH > 4 && fInnerW > 4) {
      if (isGrid) {
        const cols = gridCols || 2;
        const rows = gridRows || 2;
        const totalBevel = bevelH * (rows - 1);
        const usableH = fasadeAreaH - totalBevel;
        let rowHs = [];
        if (fasadeHeights && fasadeHeights.length === rows) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) rowHs = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (rowHs.length === 0) rowHs = new Array(rows).fill(usableH / rows);
        let colWs = [];
        if (gridColWidths && gridColWidths.length === cols) {
          const sumW = gridColWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumW > 0) colWs = gridColWidths.map(v => (parseFloat(v)||0) / sumW * fInnerW);
        }
        if (colWs.length === 0) colWs = new Array(cols).fill(fInnerW / cols);
        let cy = fasadeTopY;
        for (let row = 0; row < rows; row++) {
          let cx = x0;
          for (let col = 0; col < cols; col++) {
            const fw = colWs[col] - (col < cols - 1 ? colGap : 0);
            svg += renderVertexFacade(cx, cy, fw, rowHs[row], corpusColor, facadePattern);
            if (col < cols - 1) {
              svg += drawColGap(cx + fw, cy, rowHs[row]);
            }
            cx += colWs[col];
          }
          cy += rowHs[row];
          if (row < rows - 1) {
            svg += renderVertexBevel(x0, cy, fInnerW, bevelH);
            cy += bevelH;
          }
        }
      } else {
        // Пенал — фасады по высоте. Между ними скос-ручка.
        const totalBevel = bevelH * (fasades - 1);
        const usableH = fasadeAreaH - totalBevel;
        let heights = [];
        if (fasadeHeights && fasadeHeights.length === fasades) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) heights = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (heights.length === 0) heights = new Array(fasades).fill(usableH / fasades);
        let cy = fasadeTopY;
        for (let i = 0; i < fasades; i++) {
          svg += renderVertexFacade(x0, cy, fInnerW, heights[i], corpusColor, facadePattern);
          cy += heights[i];
          if (i < fasades - 1) {
            svg += renderVertexBevel(x0, cy, fInnerW, bevelH);
            cy += bevelH;
          }
        }
      }
    }

    // Нижний скос-ручка (только при fasades===1 в пенале)
    if (isSingleFasadePenal) {
      svg += renderVertexBevel(x0, fasadeBotY, W, bevelH);
    }

    if (cokolH_p > 0) {
      svg += `<rect x="${x0}" y="${y0 + H - cokolH_p}" width="${W}" height="${cokolH_p}"
        fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.6"/>`;
      svg += `<rect x="${x0}" y="${y0 + H - cokolH_p - 0.6}" width="${W}" height="1.2"
        fill="rgba(0,0,0,0.40)"/>`;
    }

    if (hasLegs) {
      const legInset = (W / (w_mm || 600)) * 50;
      const legW = 11;
      [x0 + legInset, x0 + W - legInset - legW].forEach(lx => {
        svg += `<rect x="${lx}" y="${y0 + H}" width="${legW}" height="${legH}" fill="#1a1a1a" opacity="0.92"/>`;
      });
    }

    svg += `</svg>`;
    return svg;
  }

  // ============================================================================
  // SVG ТУМБЫ И ПЕНАЛА — стиль "Т-Вуд"
  //   Корпус как у Vertex (накладные фасады заподлицо, без боковых щелей).
  //   Материал: ТОЛЬКО термоясень (5 оттенков).
  //   Тумба: ручка-скос 45° СБОКУ фасада (вертикальный V-вырез по правой кромке каждого фасада).
  //   Пенал: ручки как у Vertex (между фасадами по высоте, снизу при 1 фасаде).
  //   Без фрезеровок (плоский фасад с лёгкой текстурой древесины).
  // ============================================================================

  // Лёгкая текстура термоясеня — горизонтальные тёмные тонкие штрихи имитируют волокна
  function renderTwoodFacade(x, y, w, h, color) {
    if (w <= 0 || h <= 0) return '';
    let s = '';
    s += `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${color}" stroke="rgba(0,0,0,0.25)" stroke-width="0.5"/>`;
    // Лёгкие горизонтальные волокна (более тёмные, низкая прозрачность)
    const linesCount = Math.max(2, Math.round(h / 9));
    for (let i = 1; i < linesCount; i++) {
      const ly = y + (h / linesCount) * i + (Math.sin(i * 1.7) * 0.4);
      s += `<line x1="${x + 1}" y1="${ly}" x2="${x + w - 1}" y2="${ly}" stroke="rgba(0,0,0,0.10)" stroke-width="0.5"/>`;
    }
    // Очень мягкий вертикальный градиент — общий тон шпона
    s += `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="rgba(255,255,255,0.04)"/>`;
    return s;
  }

  // Т-Вуд: вертикальный V-образный скос-ручка 45° (для тумб — сбоку фасада)
  function renderTwoodBevelVertical(x, y, w, h) {
    const dark = 'rgba(0,0,0,0.50)';
    const darker = 'rgba(0,0,0,0.68)';
    const light = 'rgba(255,255,255,0.28)';
    const seam = 'rgba(0,0,0,0.85)';
    let s = '';
    const xMid = x + w / 2;
    // Левая половина — диагональная грань уходит внутрь (тень)
    s += `<polygon points="${x},${y} ${xMid},${y} ${xMid},${y + h} ${x},${y + h}" fill="${darker}"/>`;
    // Правая половина — диагональная грань выходит наружу (свет)
    s += `<polygon points="${xMid},${y} ${x + w},${y} ${x + w},${y + h} ${xMid},${y + h}" fill="${dark}"/>`;
    // Светлый блик
    s += `<line x1="${xMid + 0.5}" y1="${y}" x2="${xMid + 0.5}" y2="${y + h}" stroke="${light}" stroke-width="0.5"/>`;
    // Глубокий шов в середине V
    s += `<line x1="${xMid}" y1="${y}" x2="${xMid}" y2="${y + h}" stroke="${seam}" stroke-width="0.7"/>`;
    return s;
  }

  function svgCabinetTwood(params) {
    const {
      fasades, mountType, w_mm, d_mm, h_mm,
      fasadeWidths, fasadeHeights, fasadeAxis,
      gridCols, gridRows, gridColWidths,
      mixedSingleColW, mixedTopH, mixedBottomH, mixedLeftW, mixedRightW, mixedCenterW,
      bodyColor
    } = params;
    const isWall = mountType === 'wall' || !mountType;
    const hasLegs = mountType === 'floor_legs';
    const onFloor = mountType === 'floor';
    const isVertical = fasadeAxis === 'height';
    const isGridFasades = fasadeAxis === 'grid';
    const isMixed = fasadeAxis === 'mixed_1plus2' || fasadeAxis === 'mixed_2plus1';
    const isMixed3 = fasadeAxis === 'mixed_1plus2plus1';

    const SC = computeSmartScale(w_mm, d_mm, h_mm, {w:1500, d:500, h:600}, 240, 240);
    const W = SC.W_px;
    const H = SC.H_px;
    const D = SC.D_px * DEPTH_VISUAL_FACTOR;
    const dx = D * ISO_DX, dy = D * ISO_DY;
    const legH = hasLegs ? 22 : 0;
    const padL = 14, padT = 22;
    const totalW = W + dx + padL * 2;
    const totalH = H + dy + padT + legH + 12;
    const x0 = padL, y0 = padT + dy;

    const corpusColor = bodyColor || TWOOD_COLORS[0].hex;
    const strokeColor = '#3a2a1f';
    const refH_mm = (h_mm && !isNaN(h_mm) && h_mm > 0) ? h_mm : 600;
    const cokolH = onFloor ? Math.max(8, (H / refH_mm) * 50) : 0;
    // Ширина V-образного бокового скоса — заметная вертикальная полоса
    const bevelW = Math.max(4, Math.min(W, H) * 0.022);
    // Тонкая щель между рядами фасадов по высоте (без скоса — у тумбы скос только сбоку)
    const rowGap = Math.max(1.5, H * 0.006);

    let svg = `<svg viewBox="0 0 ${totalW} ${totalH}" xmlns="http://www.w3.org/2000/svg" style="width:auto;max-width:300px;max-height:300px;display:block;margin:0 auto;">`;

    if (onFloor || hasLegs) {
      const fy = y0 + H + legH - dy;
      svg += `<line x1="${padL - 6}" y1="${fy}" x2="${totalW - 4}" y2="${fy}" stroke="#888" stroke-width="1.4"/>`;
    }
    if (isWall) {
      const shadowY = y0 + H + 4;
      svg += `<ellipse cx="${x0 + W/2 + dx/2}" cy="${shadowY}" rx="${W/2.2}" ry="6" fill="rgba(0,0,0,0.14)"/>`;
    }

    // Верхняя крышка (плоская)
    svg += `<polygon points="
      ${x0},${y0}
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + dx},${y0 - dy}
    " fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;

    // Правая боковая глубина
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + H - dy}
      ${x0 + W},${y0 + H}
    " fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + H - dy}
      ${x0 + W},${y0 + H}
    " fill="rgba(0,0,0,0.20)" stroke="none"/>`;

    // Передняя грань (фон — корпус того же цвета что фасады)
    svg += `<rect x="${x0}" y="${y0}" width="${W}" height="${H}"
      fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;

    // Зона фасадов
    const fasadeBotY = y0 + H - cokolH;
    const fasadeAreaH = fasadeBotY - y0;
    const fInnerW = W;

    // Тонкая тёмная щель между рядами фасадов (горизонтальная, обычная — у тумб скоса между рядами по высоте нет)
    const drawRowGap = (rx, ry, rw) => {
      return `<rect x="${rx}" y="${ry}" width="${rw}" height="${rowGap}" fill="rgba(0,0,0,0.42)"/>`;
    };

    // Главная функция: рисует фасад со скосом-ручкой 45° СПРАВА (вертикальной)
    // Возвращает SVG: фасад + скос-ручка справа.
    // Параметр noBevel — если true, рисует только фасад без бокового скоса (для одиночных фасадов сетки/последней колонки если нужно)
    const drawFacadeWithSideHandle = (fx, fy, fw, fh) => {
      let s = '';
      const facWidth = fw - bevelW;
      if (facWidth <= 0) {
        // если совсем мелкий — рисуем без ручки
        s += renderTwoodFacade(fx, fy, fw, fh, corpusColor);
        return s;
      }
      s += renderTwoodFacade(fx, fy, facWidth, fh, corpusColor);
      // Вертикальный скос-ручка справа от фасада
      s += renderTwoodBevelVertical(fx + facWidth, fy, bevelW, fh);
      return s;
    };

    if (fasadeAreaH > 4 && fInnerW > 4) {
      if (isMixed3) {
        // Тумба 1+2+1 в Т-Вуд: 3 колонки с боковыми скосами-ручками у каждой
        const colGap = Math.max(1.5, fInnerW * 0.005);
        const totalW_mm = (w_mm > 0) ? w_mm : 1500;
        // Доступная ширина для трёх колонок (за вычетом 2 щелей)
        const availW = Math.max(60, fInnerW - colGap * 2);
        let leftPx, centerPx, rightPx;
        if (mixedLeftW > 0 && mixedRightW > 0 && mixedCenterW > 0) {
          // Все три заданы — пропорция по их сумме (гарантированно влезут)
          const sumMm = mixedLeftW + mixedCenterW + mixedRightW;
          leftPx   = (mixedLeftW   / sumMm) * availW;
          centerPx = (mixedCenterW / sumMm) * availW;
          rightPx  = (mixedRightW  / sumMm) * availW;
        } else {
          // Дефолтная логика для случая когда что-то не задано
          leftPx = (mixedLeftW > 0) ? Math.max(15, Math.min(availW * 0.45, (mixedLeftW / totalW_mm) * availW)) : availW * 0.25;
          rightPx = (mixedRightW > 0) ? Math.max(15, Math.min(availW * 0.45, (mixedRightW / totalW_mm) * availW)) : availW * 0.25;
          centerPx = (mixedCenterW > 0) ? Math.max(20, Math.min(availW * 0.95, (mixedCenterW / totalW_mm) * availW)) : Math.max(20, availW - leftPx - rightPx);
        }
        // Финальная защита: пропорционально сжимаем если сумма больше availW
        const sumPx = leftPx + centerPx + rightPx;
        if (sumPx > availW + 0.5) {
          const k = availW / sumPx;
          leftPx *= k; centerPx *= k; rightPx *= k;
        }
        const totalH_mm = (mixedTopH + mixedBottomH > 0) ? (mixedTopH + mixedBottomH) : (h_mm > 0 ? h_mm : 1);
        const usableH = fasadeAreaH - rowGap;
        const topH_px = usableH * (mixedTopH > 0 ? (mixedTopH / totalH_mm) : 0.5);
        const botH_px = usableH - topH_px;
        // Левая
        svg += drawFacadeWithSideHandle(x0, y0, leftPx, fasadeAreaH);
        svg += `<rect x="${x0 + leftPx}" y="${y0}" width="${colGap}" height="${fasadeAreaH}" fill="rgba(0,0,0,0.42)"/>`;
        // Центр (2 фасада)
        const centerX = x0 + leftPx + colGap;
        svg += drawFacadeWithSideHandle(centerX, y0, centerPx, topH_px);
        svg += drawRowGap(centerX, y0 + topH_px, centerPx);
        svg += drawFacadeWithSideHandle(centerX, y0 + topH_px + rowGap, centerPx, botH_px);
        svg += `<rect x="${centerX + centerPx}" y="${y0}" width="${colGap}" height="${fasadeAreaH}" fill="rgba(0,0,0,0.42)"/>`;
        // Правая
        svg += drawFacadeWithSideHandle(centerX + centerPx + colGap, y0, rightPx, fasadeAreaH);
      } else if (isMixed) {
        // Смешанная компоновка 1+2 / 2+1: одна одиночная колонка + 2 широких фасада в другой
        const isLeftSingle = fasadeAxis === 'mixed_1plus2';
        const colGap = Math.max(1.5, fInnerW * 0.005);
        const colW_px = (w_mm > 0 && mixedSingleColW > 0)
          ? Math.max(20, Math.min(fInnerW - 20, (mixedSingleColW / w_mm) * fInnerW))
          : fInnerW / 3;
        const wideW_px = fInnerW - colW_px - colGap;
        const totalH_mm = (mixedTopH + mixedBottomH > 0) ? (mixedTopH + mixedBottomH) : (h_mm > 0 ? h_mm : 1);
        const usableH = fasadeAreaH - rowGap;
        const topH_px = usableH * (mixedTopH > 0 ? (mixedTopH / totalH_mm) : 0.5);
        const botH_px = usableH - topH_px;
        const singleX = isLeftSingle ? x0 : (x0 + wideW_px + colGap);
        const wideX   = isLeftSingle ? (x0 + colW_px + colGap) : x0;
        // Одиночная колонка с боковым скосом-ручкой
        svg += drawFacadeWithSideHandle(singleX, y0, colW_px, fasadeAreaH);
        // Два широких фасада с боковыми скосами-ручками
        svg += drawFacadeWithSideHandle(wideX, y0, wideW_px, topH_px);
        svg += drawRowGap(wideX, y0 + topH_px, wideW_px);
        svg += drawFacadeWithSideHandle(wideX, y0 + topH_px + rowGap, wideW_px, botH_px);
        // Тонкая тёмная вертикальная щель между двумя колонками (между skoсoм одной и фасадом другой)
        svg += `<rect x="${isLeftSingle ? (x0 + colW_px) : (x0 + wideW_px)}" y="${y0}" width="${colGap}" height="${fasadeAreaH}" fill="rgba(0,0,0,0.42)"/>`;
      } else if (isGridFasades) {
        const cols = gridCols || 2;
        const rows = gridRows || 2;
        const totalGap = rowGap * (rows - 1);
        const usableH = fasadeAreaH - totalGap;
        let rowHs = [];
        if (fasadeHeights && fasadeHeights.length === rows) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) rowHs = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (rowHs.length === 0) rowHs = new Array(rows).fill(usableH / rows);
        let colWs = [];
        if (gridColWidths && gridColWidths.length === cols) {
          const sumW = gridColWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumW > 0) colWs = gridColWidths.map(v => (parseFloat(v)||0) / sumW * fInnerW);
        }
        if (colWs.length === 0) colWs = new Array(cols).fill(fInnerW / cols);
        let cy = y0;
        for (let row = 0; row < rows; row++) {
          let cx = x0;
          for (let col = 0; col < cols; col++) {
            const fw = colWs[col];
            svg += drawFacadeWithSideHandle(cx, cy, fw, rowHs[row]);
            cx += fw;
          }
          cy += rowHs[row];
          if (row < rows - 1) {
            svg += drawRowGap(x0, cy, fInnerW);
            cy += rowGap;
          }
        }
      } else if (isVertical) {
        // Несколько фасадов по высоте — обычные тонкие щели между ними (без скоса между рядами!)
        const totalGap = rowGap * (fasades - 1);
        const usableH = fasadeAreaH - totalGap;
        let heights = [];
        if (fasadeHeights && fasadeHeights.length === fasades) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) heights = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (heights.length === 0) heights = new Array(fasades).fill(usableH / fasades);
        let cy = y0;
        for (let i = 0; i < fasades; i++) {
          svg += drawFacadeWithSideHandle(x0, cy, fInnerW, heights[i]);
          cy += heights[i];
          if (i < fasades - 1) {
            svg += drawRowGap(x0, cy, fInnerW);
            cy += rowGap;
          }
        }
      } else {
        // Несколько фасадов по ширине
        let widths = [];
        if (fasadeWidths && fasadeWidths.length === fasades) {
          const sumW = fasadeWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumW > 0) widths = fasadeWidths.map(v => (parseFloat(v)||0) / sumW * fInnerW);
        }
        if (widths.length === 0) widths = new Array(fasades).fill(fInnerW / fasades);
        let cx = x0;
        for (let i = 0; i < fasades; i++) {
          const fw = widths[i];
          svg += drawFacadeWithSideHandle(cx, y0, fw, fasadeAreaH);
          cx += fw;
        }
      }
    }

    // Цоколь
    if (cokolH > 0) {
      svg += `<rect x="${x0}" y="${fasadeBotY}" width="${W}" height="${cokolH}"
        fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.6"/>`;
      svg += `<rect x="${x0}" y="${fasadeBotY - 0.6}" width="${W}" height="1.2"
        fill="rgba(0,0,0,0.40)"/>`;
    }

    if (hasLegs) {
      const legInset = (W / (w_mm || 1500)) * 50;
      const legW = 9;
      [x0 + legInset, x0 + W - legInset - legW].forEach(lx => {
        svg += `<rect x="${lx}" y="${y0 + H}" width="${legW}" height="${legH}" fill="#1a1a1a" opacity="0.92"/>`;
      });
    }

    svg += `</svg>`;
    return svg;
  }

  function svgPenalTwood(params) {
    // Пенал Т-Вуд = пенал Вертекс с термоясеневым фасадом и без фрезеровок.
    // Просто делегируем в svgPenalVertex с принудительно "плоской" фрезеровкой,
    // но используем renderTwoodFacade для текстуры — поэтому делаем свой инлайн.
    const {
      fasades, mountType, w_mm, d_mm, h_mm,
      fasadeHeights, fasadeAxis,
      gridCols, gridRows, gridColWidths,
      bodyColor
    } = params;
    const isWall = mountType === 'wall' || !mountType;
    const onFloor = mountType === 'floor';
    const hasLegs = mountType === 'floor_legs';
    const isGrid = fasadeAxis === 'grid';

    const SC = computeSmartScale(w_mm, d_mm, h_mm, {w:600, d:400, h:1500}, 240, 240);
    const W = SC.W_px;
    const H = SC.H_px;
    const D = SC.D_px * DEPTH_VISUAL_FACTOR;
    const dx = D * ISO_DX, dy = D * ISO_DY;
    const legH = hasLegs ? 18 : 0;
    const padL = 12, padT = 18;
    const totalW = W + dx + padL * 2;
    const totalH = H + dy + padT + legH + 12;
    const x0 = padL, y0 = padT + dy;

    const corpusColor = bodyColor || TWOOD_COLORS[0].hex;
    const strokeColor = '#3a2a1f';
    const refH_mm = (h_mm && !isNaN(h_mm) && h_mm > 0) ? h_mm : 1500;
    const cokolH_p = onFloor ? Math.max(6, (H / refH_mm) * 50) : 0;
    const bevelH = Math.max(3, Math.min(W, H) * 0.012);
    const colGap = Math.max(1.5, W * 0.008);

    let svg = `<svg viewBox="0 0 ${totalW} ${totalH}" xmlns="http://www.w3.org/2000/svg" style="width:auto;max-width:240px;max-height:240px;display:block;margin:0 auto;">`;

    if (onFloor || hasLegs) {
      const fy = y0 + H + legH - dy;
      svg += `<line x1="${padL - 6}" y1="${fy}" x2="${totalW - 4}" y2="${fy}" stroke="#888" stroke-width="1.4"/>`;
    }
    if (isWall) {
      const shadowY = y0 + H + 4;
      svg += `<ellipse cx="${x0 + W/2 + dx/2}" cy="${shadowY}" rx="${W/1.6}" ry="5" fill="rgba(0,0,0,0.14)"/>`;
    }

    svg += `<polygon points="
      ${x0},${y0}
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + dx},${y0 - dy}
    " fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;

    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + H - dy}
      ${x0 + W},${y0 + H}
    " fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + H - dy}
      ${x0 + W},${y0 + H}
    " fill="rgba(0,0,0,0.20)" stroke="none"/>`;

    svg += `<rect x="${x0}" y="${y0}" width="${W}" height="${H}"
      fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;

