      // Для РИСУНКА используем значения, ограниченные диапазоном модели (clamp).
      // Так схема обновляется на КАЖДОЕ изменение габарита (в т.ч. когда пользователь
      // передумал и ввёл другое число), но не «дёргается» на промежуточных значениях
      // вроде "1"/"14" при наборе — они мягко прижимаются к минимуму/максимуму.
      // Пустое поле (NaN) → рисуем дефолтным размером модели.
      const clampToRanges = (val, ranges, fallback) => {
        if (isNaN(val)) return fallback;
        let lo = Infinity, hi = -Infinity;
        for (const r of ranges) { if (r[0] < lo) lo = r[0]; if (r[1] > hi) hi = r[1]; }
        if (val < lo) return lo;
        if (val > hi) return hi;
