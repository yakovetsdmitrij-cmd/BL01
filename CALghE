  //   onChange: callback(value)
  // Возвращает объект API: { setOptions, setValue, reset, getValue }
  function makeColorDropdown(root, options, onChange) {
    if (!root) return null;
    const trigger = root.querySelector('.atlas-dd-trigger');
    const optsContainer = root.querySelector('.atlas-dd-options');
    const hiddenInput = root.querySelector('input[type="hidden"]');
    const labelSpan = trigger ? trigger.querySelector('.atlas-dd-label') : null;
    if (!trigger || !optsContainer || !hiddenInput) return null;

    const setOptions = (newOptions, placeholder, disabled) => {
      optsContainer.innerHTML = '';
      newOptions.forEach(opt => {
        const div = document.createElement('div');
        div.className = 'atlas-dd-option';
        div.dataset.value = opt.value;
        const swatch = opt.hex ? `<span class="atlas-dd-swatch" style="background:${opt.hex};"></span>` : '';
        div.innerHTML = `${swatch}${opt.label}`;
        optsContainer.appendChild(div);
      });
      hiddenInput.value = '';
      if (labelSpan) labelSpan.textContent = placeholder || '— выберите —';
      if (disabled) root.classList.add('disabled');
      else root.classList.remove('disabled');
    };

    const setValue = (value) => {
      hiddenInput.value = value;
      const opt = optsContainer.querySelector(`.atlas-dd-option[data-value="${CSS.escape(value)}"]`);
      if (opt && labelSpan) labelSpan.textContent = opt.textContent.trim();
      optsContainer.querySelectorAll('.atlas-dd-option').forEach(o => o.classList.remove('selected'));
      if (opt) opt.classList.add('selected');
    };

    const reset = () => {
      hiddenInput.value = '';
      if (labelSpan) labelSpan.textContent = '— выберите —';
      optsContainer.querySelectorAll('.atlas-dd-option').forEach(o => o.classList.remove('selected'));
    };

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      if (root.classList.contains('disabled')) return;
      const wasOpen = root.classList.contains('open');
      document.querySelectorAll('.atlas-dd.open').forEach(d => d.classList.remove('open'));
      if (!wasOpen) root.classList.add('open');
    });
    optsContainer.addEventListener('click', (e) => {
      const opt = e.target.closest('.atlas-dd-option');
      if (!opt) return;
      const value = opt.dataset.value;
      hiddenInput.value = value;
      if (labelSpan) labelSpan.textContent = opt.textContent.trim();
      optsContainer.querySelectorAll('.atlas-dd-option').forEach(o => o.classList.remove('selected'));
      opt.classList.add('selected');
      root.classList.remove('open');
      if (onChange) onChange(value);
    });

    setOptions(options, '— выберите —', false);

    return { setOptions, setValue, reset, getValue: () => hiddenInput.value };
  }

