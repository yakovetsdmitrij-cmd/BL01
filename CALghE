      if (total===null||total===undefined) { this.resultDiv.innerHTML=''; return; }
      const recommended=Math.round(total*1.3);
      if (this.priceRevealed && this.revealedPrice !== undefined && this.revealedPrice !== total) {
        this.priceRevealed = false;
        resetOrderId();
      }
      if (this.priceRevealed) {
        this.resultDiv.innerHTML=`<div style="font-size:22px;font-weight:700;color:var(--gold);">${applyVat(recommended).toLocaleString()} ₽ <span style="font-size:13px;color:#999;font-weight:400;">${VAT_LABEL}</span></div><div style="font-size:13px;margin-top:6px;color:#999;">Закупочная цена: ${applyVat(total).toLocaleString()} ₽</div>`;
      } else {
        this.resultDiv.innerHTML=`<button class="show-price-btn" style="background:var(--gold);color:#fff;border:1px solid #1a1a1a;padding:13px 30px;font-size:16px;font-weight:600;border-radius:8px;cursor:pointer;font-family:var(--main-font);box-shadow:0 4px 10px rgba(198,164,59,0.4);">Показать цену</button>`;
        const btn = this.resultDiv.querySelector('.show-price-btn');
        const self = this;
        btn.onclick = function(){
          self.priceRevealed = true;
          self.revealedPrice = total;
          self.resultDiv.innerHTML=`<div style="font-size:22px;font-weight:700;color:var(--gold);">${applyVat(recommended).toLocaleString()} ₽ <span style="font-size:13px;color:#999;font-weight:400;">${VAT_LABEL}</span></div><div style="font-size:13px;margin-top:6px;color:#999;">Закупочная цена: ${applyVat(total).toLocaleString()} ₽</div>`;
          try { trackSingleView(self, self.kind); } catch(e) {}
          if (typeof updateTotalSum === 'function') updateTotalSum();
          if (typeof refreshPdfButton === 'function') refreshPdfButton();
        };
      }
    }
    getDetails() {
