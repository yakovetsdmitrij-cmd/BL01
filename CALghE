          let cx = x0;
          for (let col = 0; col < cols; col++) {
            const fw = colWs[col] - (col < cols - 1 ? colGap : 0);
            svg += renderAtlasFacade(cx, cy, fw, rowHs[row], facadeCol, frameCol);
            if (col < cols - 1) svg += drawColGap(cx + fw, cy, rowHs[row]);
            cx += colWs[col];
          }
          cy += rowHs[row];
          if (row < rows - 1) {
            svg += drawRowGap(x0, cy, fInnerW);
            cy += rowGap;
          }
        }
      } else {
        const totalGap = rowGap * (fasades - 1);
        const usableH = fasadeAreaH - totalGap;
        let heights = [];
        if (fasadeHeights && fasadeHeights.length === fasades) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) heights = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (heights.length === 0) heights = new Array(fasades).fill(usableH / fasades);
        let cy = y0;
        for (let i = 0; i < fasades; i++) {
          svg += renderAtlasFacade(x0, cy, fInnerW, heights[i], facadeCol, frameCol);
          cy += heights[i];
          if (i < fasades - 1) {
            svg += drawRowGap(x0, cy, fInnerW);
            cy += rowGap;
          }
        }
      }
    }

    if (cokolH_p > 0) {
      svg += `<rect x="${x0}" y="${y0 + H - cokolH_p}" width="${W}" height="${cokolH_p}" fill="${corpusColor}" stroke="${strokeColor}" stroke-width="0.6"/>`;
      svg += `<rect x="${x0}" y="${y0 + H - cokolH_p - 0.6}" width="${W}" height="1.2" fill="rgba(0,0,0,0.40)"/>`;
    }

    if (hasLegs) {
      const legInset = (W / (w_mm || 600)) * 50;
      const legW = 11;
      [x0 + legInset, x0 + W - legInset - legW].forEach(lx => {
        svg += `<rect x="${lx}" y="${y0 + H}" width="${legW}" height="${legH}" fill="#1a1a1a" opacity="0.92"/>`;
      });
    }

    svg += `</svg>`;
    return svg;
  }

  // Изометрическая столешница — схематичный показ раковин и отверстия под смеситель.
  // params: { sinkType, l_mm, d_mm, thickness_mm, tapHole: 'yes'|'no', sinkPosition: 'left'|'center'|'right' }
  function svgCountertop3D(params) {
    const { sinkType, l_mm, d_mm, thickness_mm, tapHole, sinkPosition } = params;
    const W = scaleDim(l_mm, 180, 340, 600, 3000);
    const D = scaleDim(d_mm, 60, 130, 300, 1200);
    const TH = Math.max(4, scaleDim(thickness_mm, 4, 50, 6, 150));
    const dx = D * ISO_DX, dy = D * ISO_DY;
    const padL = 20, padT = 30;

    // Размеры раковины (на верхней грани, в плоских координатах W×D)
    const sinkW = W * 0.42;
    const sinkD = D * 0.62;
    let sinkCenterFlat;
    if (sinkPosition === 'left')       sinkCenterFlat = sinkW/2 + W * 0.08;
    else if (sinkPosition === 'right') sinkCenterFlat = W - sinkW/2 - W * 0.08;
    else                                sinkCenterFlat = W / 2;
    const sinkDepthCenterFlat = D * 0.5;

    // Высота надстройки накладной раковины над столешницей
    const sinkExtrudeUp = (sinkType === 'overlay') ? Math.max(8, D * 0.10) : 0;

    const totalW = W + dx + padL*2 + 30;
    const totalH = padT + sinkExtrudeUp + dy + TH + 30;
    const x0 = padL;
    const y0 = padT + sinkExtrudeUp + dy;

    let svg = `<svg viewBox="0 0 ${totalW} ${totalH}" xmlns="http://www.w3.org/2000/svg" style="width:auto;max-width:280px;max-height:280px;display:block;margin:0 auto;">`;
    svg += `<defs>
      <linearGradient id="ctTop" x1="0" y1="0" x2="1" y2="0.3">
        <stop offset="0%" stop-color="#fdfcfa"/><stop offset="100%" stop-color="#e0dcd2"/>
      </linearGradient>
      <linearGradient id="ctFront" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#cfcbc0"/><stop offset="100%" stop-color="#a8a499"/>
      </linearGradient>
      <linearGradient id="ctSide" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#bcb8ad"/><stop offset="100%" stop-color="#8e8a80"/>
      </linearGradient>
    </defs>`;

    // Тень под столешницей
    const shadowY = y0 + TH + 10;
    svg += `<ellipse cx="${x0 + W/2 + dx/2}" cy="${shadowY}" rx="${W/2.2}" ry="5" fill="rgba(0,0,0,0.12)"/>`;

    // Проекция плоской точки (x_flat: 0..W, depth_flat: 0..D) на верхнюю грань изометрии.
    const projectTop = (x_flat, depth_flat) => {
      const t = depth_flat / D;
      return { x: x0 + x_flat + dx * t, y: y0 - dy * t };
    };

    // === ВЕРХНЯЯ ГРАНЬ столешницы (всегда сплошная — для всех типов) ===
    svg += `<polygon points="
      ${x0},${y0}
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + dx},${y0 - dy}
    " fill="url(#ctTop)" stroke="${STROKE}" stroke-width="1.2"/>`;

    // === Передняя грань ===
    svg += `<polygon points="
      ${x0},${y0}
      ${x0 + W},${y0}
      ${x0 + W},${y0 + TH}
      ${x0},${y0 + TH}
    " fill="url(#ctFront)" stroke="${STROKE}" stroke-width="1.2"/>`;
    // === Правая боковая грань ===
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 - dy + TH}
      ${x0 + W},${y0 + TH}
    " fill="url(#ctSide)" stroke="${STROKE}" stroke-width="1.2"/>`;

    // === Координаты выреза/раковины (общие для overlay и integrated) ===
    const sx0 = sinkCenterFlat - sinkW/2;
    const sx1 = sinkCenterFlat + sinkW/2;
    const sd0 = sinkDepthCenterFlat - sinkD/2;
    const sd1 = sinkDepthCenterFlat + sinkD/2;
    const cFL = projectTop(sx0, sd0);
    const cFR = projectTop(sx1, sd0);
    const cBR = projectTop(sx1, sd1);
    const cBL = projectTop(sx0, sd1);

    // === ИНТЕГРИРОВАННАЯ — схематичный «вырез» на верхней плоскости ===
    if (sinkType === 'integrated') {
      // Контур пунктиром (показывает что это вырез в столешнице)
      svg += `<polygon points="
        ${cFL.x},${cFL.y}
        ${cFR.x},${cFR.y}
        ${cBR.x},${cBR.y}
        ${cBL.x},${cBL.y}
      " fill="rgba(180,180,180,0.35)" stroke="#555" stroke-width="1.1" stroke-dasharray="5,3"/>`;
      // Лёгкая тень в углу выреза для глубины
      svg += `<polygon points="
        ${cFL.x},${cFL.y}
        ${cFR.x},${cFR.y}
        ${cBR.x},${cBR.y}
        ${cBL.x},${cBL.y}
      " fill="rgba(0,0,0,0.12)" stroke="none"/>`;
    }

    // === НАКЛАДНАЯ — белая «таблетка» на верхней плоскости + пунктирные 3D-линии вверх ===
    if (sinkType === 'overlay') {
      // Тень основания раковины на столешнице
      svg += `<polygon points="
        ${cFL.x + 1},${cFL.y + 2}
        ${cFR.x + 1},${cFR.y + 2}
        ${cBR.x + 1},${cBR.y + 2}
        ${cBL.x + 1},${cBL.y + 2}
      " fill="rgba(0,0,0,0.18)" stroke="none"/>`;
      // Белый контур раковины (схематично)
      svg += `<polygon points="
        ${cFL.x},${cFL.y}
        ${cFR.x},${cFR.y}
        ${cBR.x},${cBR.y}
        ${cBL.x},${cBL.y}
      " fill="#ffffff" stroke="${STROKE}" stroke-width="1.2"/>`;
      // Внутренняя «чаша» — тонкая рамка с серым полем
      const inset = Math.min(sinkW, sinkD) * 0.08;
      const iFL = projectTop(sx0 + inset, sd0 + inset*0.7);
      const iFR = projectTop(sx1 - inset, sd0 + inset*0.7);
      const iBR = projectTop(sx1 - inset, sd1 - inset*0.7);
      const iBL = projectTop(sx0 + inset, sd1 - inset*0.7);
      svg += `<polygon points="
        ${iFL.x},${iFL.y}
        ${iFR.x},${iFR.y}
        ${iBR.x},${iBR.y}
        ${iBL.x},${iBL.y}
      " fill="#e8e8e8" stroke="#888" stroke-width="0.7"/>`;

      // === Пунктирная 3D-проекция вверх (показ объёма как на чертеже) ===
      const upH = sinkExtrudeUp; // высота "поднятого" контура
      const dashStyle = '3,2';
      const dashStroke = '#555';
      // Поднятые углы — это те же 4 угла основания, смещённые вверх на upH
      const tFL = { x: cFL.x, y: cFL.y - upH };
      const tFR = { x: cFR.x, y: cFR.y - upH };
      const tBR = { x: cBR.x, y: cBR.y - upH };
      const tBL = { x: cBL.x, y: cBL.y - upH };
      // 4 вертикальные линии-пунктиры от основания вверх
      svg += `<line x1="${cFL.x}" y1="${cFL.y}" x2="${tFL.x}" y2="${tFL.y}" stroke="${dashStroke}" stroke-width="0.8" stroke-dasharray="${dashStyle}"/>`;
      svg += `<line x1="${cFR.x}" y1="${cFR.y}" x2="${tFR.x}" y2="${tFR.y}" stroke="${dashStroke}" stroke-width="0.8" stroke-dasharray="${dashStyle}"/>`;
      svg += `<line x1="${cBR.x}" y1="${cBR.y}" x2="${tBR.x}" y2="${tBR.y}" stroke="${dashStroke}" stroke-width="0.8" stroke-dasharray="${dashStyle}"/>`;
      svg += `<line x1="${cBL.x}" y1="${cBL.y}" x2="${tBL.x}" y2="${tBL.y}" stroke="${dashStroke}" stroke-width="0.8" stroke-dasharray="${dashStyle}"/>`;
      // Верхний контур-пунктир (соединяет поднятые углы — показывает верх раковины)
      svg += `<polygon points="
        ${tFL.x},${tFL.y}
        ${tFR.x},${tFR.y}
        ${tBR.x},${tBR.y}
        ${tBL.x},${tBL.y}
      " fill="none" stroke="${dashStroke}" stroke-width="0.9" stroke-dasharray="${dashStyle}"/>`;
    }

    // === ОТВЕРСТИЕ ПОД СМЕСИТЕЛЬ — кружок пунктиром на столешнице ===
    if (tapHole === 'yes') {
      let holeCenter;
      if (sinkType) {
        // С раковиной — отверстие за её задним краем
        const holeXFlat = sinkCenterFlat;
        const holeDepthFlat = Math.min(D * 0.92, sinkDepthCenterFlat + sinkD/2 + D * 0.08);
        holeCenter = projectTop(holeXFlat, holeDepthFlat);
      } else {
        // Без раковины — посередине задней зоны
        holeCenter = projectTop(W / 2, D * 0.85);
      }
      const holeR = Math.max(4, Math.min(W, D) * 0.025);
      // Внешний пунктирный контур
      svg += `<ellipse cx="${holeCenter.x}" cy="${holeCenter.y}" rx="${holeR}" ry="${holeR * 0.55}"
        fill="none" stroke="#444" stroke-width="1.1" stroke-dasharray="3,2"/>`;
      // Маленькая тёмная точка в центре (метка)
      svg += `<circle cx="${holeCenter.x}" cy="${holeCenter.y}" r="0.9" fill="#444"/>`;
    }

    svg += `</svg>`;
    return svg;
  }

  // Раковина (отдельная) — пунктирная схема, вид сверху
  function svgSink3D(params) {
    const { mountType, w_mm, d_mm } = params;
    const W = scaleDim(w_mm, 160, 280, 300, 800);
    const D = scaleDim(d_mm, 90, 160, 300, 600);
    const padL = 20, padT = 24;
    const totalW = W + padL*2;
    const totalH = D + padT + 36;
    const x0 = padL, y0 = padT;

    let svg = `<svg viewBox="0 0 ${totalW} ${totalH}" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:280px;">`;

    svg += `<rect x="${x0 - 4}" y="${y0 - 4}" width="${W + 8}" height="${D + 8}" rx="2" fill="#fafaf8" stroke="#d8d4cc" stroke-width="0.8"/>`;

    const dashColor = '#444';
    const dashStyle = mountType === 'integrated' ? '4,3' : '5,3';
    svg += `<rect x="${x0}" y="${y0}" width="${W}" height="${D}" rx="3" fill="none" stroke="${dashColor}" stroke-width="1.4" stroke-dasharray="${dashStyle}"/>`;
    svg += `<circle cx="${x0 + W/2}" cy="${y0 + D/2}" r="6" fill="none" stroke="${dashColor}" stroke-width="1" stroke-dasharray="2,1.5"/>`;

    let label = mountType === 'integrated' ? 'Интегрированная (вид сверху)' : 'Накладная (вид сверху)';
    if (w_mm && d_mm) label += ` · ${w_mm}×${d_mm} мм`;
    svg += `<text x="${totalW/2}" y="${totalH-12}" text-anchor="middle" font-size="11" fill="#777" font-family="Manrope,sans-serif">${label}</text>`;
    svg += `</svg>`;
    return svg;
  }

  // Контур зеркала Т-Вуд — оцифрованные точки реального изделия (с фото).
  // Координаты нормированы к bounding-box [-1, +1] × [-1, +1] (центр в 0,0).
  // Точки идут по часовой стрелке. SVG-путь строится через Catmull-Rom-Bezier — кривая
  // проходит через КАЖДУЮ точку с C1-непрерывностью, что даёт точное соответствие фото.
  const TWOOD_CONTOUR = [
      [-0.6706,-0.9996],
      [-0.5563,-0.9797],
      [-0.4420,-0.9592],
      [-0.3277,-0.9341],
      [-0.2134,-0.9159],
      [-0.0914,-0.9019],
      [+0.0305,-0.9009],
      [+0.1448,-0.9060],
      [+0.2667,-0.9240],
      [+0.3810,-0.9458],
      [+0.4953,-0.9702],
      [+0.6097,-0.9931],
      [+0.7316,-0.9888],
      [+0.8459,-0.9866],
      [+0.9450,-0.9476],
      [+0.9792,-0.8659],
      [+0.9757,-0.7797],
      [+0.9367,-0.7043],
      [+0.8840,-0.6240],
      [+0.8432,-0.5481],
      [+0.8007,-0.4673],
      [+0.8002,-0.3833],
      [+0.8327,-0.3004],
      [+0.8862,-0.2250],
      [+0.9351,-0.1442],
      [+0.9867,-0.0688],
      [+0.9955,+0.0120],
      [+0.9660,+0.0928],
      [+0.9082,+0.1736],
      [+0.8670,+0.2490],
      [+0.8189,+0.3297],
      [+0.8040,+0.4105],
      [+0.8230,+0.4945],
      [+0.8640,+0.5721],
      [+0.9145,+0.6529],
      [+0.9526,+0.7329],
      [+0.9756,+0.8145],
      [+0.9678,+0.8980],
      [+0.9019,+0.9652],
      [+0.7925,+0.9977],
      [+0.6706,+0.9956],
      [+0.5487,+0.9799],
      [+0.4344,+0.9644],
      [+0.3277,+0.9287],
      [+0.2134,+0.9067],
      [+0.0914,+0.9009],
      [-0.0305,+0.8981],
      [-0.1448,+0.9032],
      [-0.2667,+0.9152],
      [-0.3810,+0.9434],
      [-0.4877,+0.9669],
      [-0.6066,+0.9868],
      [-0.7240,+0.9998],
      [-0.8459,+0.9870],
      [-0.9406,+0.9383],
      [-0.9720,+0.8575],
