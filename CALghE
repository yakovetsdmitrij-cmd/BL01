        if (this.widthInput.value) details.article = `РК-${typeCode}-${this.widthInput.value}`;
      }
      else if (this.kind==='mirror') {
        // Коллекция
        const cKey = this.collectionSelect ? this.collectionSelect.value : '';
        details.collection = (cKey && typeof collections !== 'undefined' && collections[cKey])
          ? collections[cKey].name : '';
        details.shape=this.shapeSelect.options[this.shapeSelect.selectedIndex]?.text;
        details.width=this.widthInput.value;
        details.height=this.heightInput.value;
        details.light = this.lightSelect && this.lightSelect.value==='led'
          ? `LED-подсветка (${this.lightTempSelect.value}K)`
          : 'Нет';
        // Отделка (если показана для коллекции — Бланка / Авалон)
        if (this.finishRow && this.finishRow.style.display !== 'none' && this.finishType && this.finishType.value) {
          const fKey = this.finishType.value;
          const ftypeText = this.finishType.options[this.finishType.selectedIndex]?.text || '';
          if (fKey === 'paint_custom') {
            const customCode = this.finishCustomName ? this.finishCustomName.value.trim() : '';
            details.finish = `Свой цвет покраски — ${customCode || 'артикул не указан'}`;
          } else {
            const colorRoot = document.getElementById(`${this.idp}-finish-color-dd`);
            const colorLabel = colorRoot ? colorRoot.querySelector('.atlas-dd-label') : null;
            const colorText = (colorLabel && this.finishColorDD && this.finishColorDD.getValue())
              ? colorLabel.textContent.trim() : '';
            details.finish = `${ftypeText}${colorText ? ' - ' + colorText : ''}`;
          }
        }
        // Окантовка/фурнитура (для Авалона) — добавляем к отделке
        if (this.trimRow && this.trimRow.style.display !== 'none' && this.trimDD) {
          const trimVal = this.trimDD.getValue() || 'gold';
          const trimText = trimVal === 'silver' ? 'Серебро' : 'Золото';
          details.finish = (details.finish ? details.finish + '; ' : '') + `Окантовка: ${trimText}`;
        }
        // Т-Вуд: внешний + внутренний слои
        if (this.twoodMirrorBlock && this.twoodMirrorBlock.style.display !== 'none') {
          const matMap = {
            paint_glossy: 'Покраска глянец',
            paint_matte:  'Покраска мат',
            veneer:       'Шпон',
            paint_custom: 'Свой цвет (RAL/NCS)'
          };
          const fmtLayer = (matSel, colorDD, colorRoot, customName) => {
            if (!matSel || !matSel.value) return '';
            const matName = matMap[matSel.value] || matSel.value;
            if (matSel.value === 'paint_custom') {
              const code = customName ? customName.value.trim() : '';
              return `${matName} — ${code || 'артикул не указан'}`;
            }
            const colorVal = colorDD ? colorDD.getValue() : '';
            if (!colorVal) return matName;
            const labelEl = colorRoot ? colorRoot.querySelector('.atlas-dd-label') : null;
            const colorText = labelEl ? labelEl.textContent.trim() : colorVal;
            return `${matName} - ${colorText}`;
          };
          const outRoot = document.getElementById(`${this.idp}-twood-out-color-dd`);
          const inRoot  = document.getElementById(`${this.idp}-twood-in-color-dd`);
          const outDesc = fmtLayer(this.twoodOutMat, this.twoodOutColorDD, outRoot, this.twoodOutCustomName);
          const inDesc  = fmtLayer(this.twoodInMat,  this.twoodInColorDD,  inRoot,  this.twoodInCustomName);
          const parts = [];
          if (outDesc) parts.push(`Внешний: ${outDesc}`);
          if (inDesc)  parts.push(`Внутренний: ${inDesc}`);
          if (parts.length) details.finish = parts.join('; ');
        }
        // Артикул зеркала: {ПРЕФИКС}-M{номер формы}-{ШxВ}
        // Номер формы: 01=Прямоугольное, 02=Овальное, 03=Круглое
        const shapeIndex = this.shapeSelect.selectedIndex;
        const shapeNum = shapeIndex > 0 ? String(shapeIndex).padStart(2, '0') : '00';
        const prefix = (cKey && typeof COLLECTION_PREFIXES !== 'undefined' && COLLECTION_PREFIXES[cKey])
          ? COLLECTION_PREFIXES[cKey] : null;
        if (prefix && shapeNum !== '00' && this.widthInput.value && this.heightInput.value) {
          details.article = `${prefix}-M${shapeNum}-${this.widthInput.value}x${this.heightInput.value}`;
        }
      }
      else if (this.kind==='dops') { let ops=[]; if(this.handleCheck.checked)ops.push('Ручки'); if(this.illumCheck.checked)ops.push('Подсветка зеркал'); if(this.mountCheck.checked)ops.push('Монтажные комплекты'); details.options=ops.join(', '); }
      return details;
    }
  }

  // ФУНКЦИИ РАСЧЁТА
  function calcCountertop(idp) {
    const material=document.getElementById(`${idp}-material`);
    const thickness=document.getElementById(`${idp}-thickness`);
    const length=parseFloat(document.getElementById(`${idp}-length`).value);
    const depth=parseFloat(document.getElementById(`${idp}-depth`).value);
    if (!material.value||!thickness.value||isNaN(length)||isNaN(depth)||length<=0||depth<=0) return null;
    // Тип раковины обязателен — без него непонятно, какая работа (только вырез или вырез + клейка)
    // Это особенно важно при "раковине клиента", где наша раковина не выбрана.
    const sinkTypeSel = document.getElementById(`${idp}-sink-type`);
    if (!sinkTypeSel || !sinkTypeSel.value) return null;
    const area=(length*depth)/1e6;
    const mc=material.value==0?1.0:(material.value==1?1.3:1.8);
    const tc=parseFloat(thickness.options[thickness.selectedIndex]?.value)||1.0;
    // Цена раковины: для клиентской раковины (чекбокс) = 0, иначе — выбранная из списка
    const clientCheck = document.getElementById(`${idp}-client-sink-check`);
    const isClient = clientCheck && clientCheck.checked;
    const sinkExtra = isClient ? 0 : (parseFloat(document.getElementById(`${idp}-sink-model`)?.value)||0);
    // Стоимость работы по типу установки: накладная — только вырез, интегрированная — вырез + установка
    const sinkType = sinkTypeSel.value;
    const installFee = sinkType === 'integrated' ? 3500 : 1500;
    return 2500*area*mc*tc + sinkExtra + installFee;
  }
  function calcSink(idp) {
    const type=document.getElementById(`${idp}-mount-type`).value;
    const matPrice=parseFloat(document.getElementById(`${idp}-material`).value);
    const w=parseFloat(document.getElementById(`${idp}-width`).value);
    const d=parseFloat(document.getElementById(`${idp}-depth`).value);
    if (!type||isNaN(matPrice)||isNaN(w)||isNaN(d)||w<=0||d<=0) return null;
    return matPrice+(w*d)/1000*1.2;
  }
  function calcMirror(idp) {
    const sp=parseFloat(document.getElementById(`${idp}-shape`).value);
    const w=parseFloat(document.getElementById(`${idp}-width`).value);
    const h=parseFloat(document.getElementById(`${idp}-height`).value);
    const lightEl = document.getElementById(`${idp}-light`);
    const light = (lightEl && lightEl.value==='led') ? 3500 : 0;
    if (isNaN(sp)||isNaN(w)||isNaN(h)||w<=0||h<=0) return null;
    // Определяем активный материал отделки
    const finishTypeEl = document.getElementById(`${idp}-finish-type`);
    const finishRow = document.getElementById(`${idp}-finish-row`);
    const twoodBlock = document.getElementById(`${idp}-twood-mirror-block`);
    const twOutMat = document.getElementById(`${idp}-twood-out-mat`);
    const twInMat  = document.getElementById(`${idp}-twood-in-mat`);
    const twOutVal = (twOutMat && twOutMat.value) ? twOutMat.value : '';
    const twInVal  = (twInMat  && twInMat.value)  ? twInMat.value  : '';
    const ftVal    = (finishTypeEl && finishTypeEl.value) ? finishTypeEl.value : '';

    // Если отделка ВИДНА (требуется коллекцией) и материал НЕ выбран — цены нет.
    // Это работает для всех коллекций кроме «Зеркала без коллекций» (там finishRow скрыт).
    const finishRowVisible = !!(finishRow && finishRow.style.display !== 'none');
    const twoodBlockVisible = !!(twoodBlock && twoodBlock.style.display !== 'none');
    if (finishRowVisible && !ftVal) return null;
    if (twoodBlockVisible && (!twOutVal || !twInVal)) return null;
    // Для свой цвет (paint_custom) дополнительно проверим что введён артикул RAL/NCS
    if (ftVal === 'paint_custom') {
      const customNameEl = document.getElementById(`${idp}-finish-custom-name`);
      if (!customNameEl || !customNameEl.value.trim()) return null;
    }

    // Коэффициент материала: для Т-Вуд — СРЕДНЕЕ двух слоёв (каждый покрывает ~50% площади рамы),
    //   так что замена ЛЮБОГО слоя меняет итоговую цену.
    // Для остальных коллекций — материал из стандартного finishType.
    let matCoeff = 1.0;
    const isTwood = !!(twOutVal || twInVal);
    if (isTwood) {
      const outCoeff = twOutVal ? (mirrorMatCoeffs[twOutVal] || 1.0) : 1.0;
      const inCoeff  = twInVal  ? (mirrorMatCoeffs[twInVal]  || 1.0) : 1.0;
      matCoeff = (outCoeff + inCoeff) / 2;
    } else if (ftVal) {
      matCoeff = mirrorMatCoeffs[ftVal] || 1.0;
    }

    const areaSqm = (w * h) / 1e6;
    // Базовая цена зеркала: shape + площадь × 10800 ₽/м² (база −10%) × коэффициент материала
    const areaPrice = areaSqm * 10800 * matCoeff;
    // Цена цвета (для Бланки и других коллекций с отделкой) — берётся из hidden input цвета.
    const colorEl = document.getElementById(`${idp}-finish-color`);
    const finishPrice = colorEl ? (parseFloat(colorEl.value) || 0) : 0;
    // Доплата за свой цвет покраски (RAL/NCS)
    const customExtra = (ftVal === 'paint_custom') ? 5000 : 0;
    // Доплата за массив у Т-Вуд (100 000 ₽/м² за каждый слой — внешний и/или внутренний)
    let twoodMassivPrice = 0;
    if (twOutVal === 'veneer') twoodMassivPrice += areaSqm * 100000;
    if (twInVal  === 'veneer') twoodMassivPrice += areaSqm * 100000;
    return Math.round(sp + areaPrice + light + finishPrice + customExtra + twoodMassivPrice);
  }
  function calcDops(idp) {
    let t=0;
    if (document.getElementById(`${idp}-handle`)?.checked) t+=1500;
    if (document.getElementById(`${idp}-illumination`)?.checked) t+=2000;
    if (document.getElementById(`${idp}-mounting`)?.checked) t+=800;
    return t;
  }

  // ====== УПРАВЛЕНИЕ ИНСТАНСАМИ ======
  // Раковины в столешнице — общая модель
  const sinkModels = {
    overlay:    [{name:'АРТ-001 — Накладная керамика 600мм',price:4200},{name:'АРТ-002 — Накладная керамика 800мм',price:5100},{name:'АРТ-005 — Накладная керамогранит 600мм',price:6200},{name:'АРТ-006 — Накладная керамогранит 800мм',price:7500},{name:'АРТ-007 — Иск. камень накладная 600мм',price:3800},{name:'АРТ-008 — Иск. камень накладная 800мм',price:4600}],
    integrated: [{name:'АРТ-003 — Интегрированная керамика 600мм',price:5800},{name:'АРТ-004 — Интегрированная керамика 800мм',price:6900},{name:'АРТ-009 — Иск. камень интегр. 600мм',price:4500},{name:'АРТ-010 — Иск. камень интегр. 800мм',price:5400}]
  };

  // Создание нового инстанса панели
  function createInstance(kind) {
    const iid = nextIid++;
    const idp = `${kind}-${iid}`;
    const html = buildPanelHTML(kind, iid);
    const container = document.getElementById('panels-container');
    container.insertAdjacentHTML('beforeend', html);
    const panelEl = document.getElementById(`panel-${idp}`);

    let instance;
    if (kind === 'cabinet' || kind === 'penal') {
      instance = new ProductPanel(kind, iid);
    } else if (kind === 'countertop') {
      instance = new SimplePanel('countertop', () => calcCountertop(`countertop-${iid}`), iid);
    } else if (kind === 'sink') {
      instance = new SimplePanel('sink', () => calcSink(`sink-${iid}`), iid);
    } else if (kind === 'mirror') {
      instance = new SimplePanel('mirror', () => calcMirror(`mirror-${iid}`), iid);
    } else if (kind === 'dops') {
      instance = new SimplePanel('dops', () => calcDops(`dops-${iid}`), iid);
    }

    // Кнопка сброса
    panelEl.querySelector('.reset-panel-btn')?.addEventListener('click', () => {
      instance.reset();
      updateAll();
    });
    // Кнопка удаления
    panelEl.querySelector('.remove-panel-btn')?.addEventListener('click', () => {
      removeInstance(iid);
    });
    // Кнопка дублирования
    panelEl.querySelector('.dup-panel-btn')?.addEventListener('click', () => {
      duplicateInstance(iid);
    });

    instances.push({ kind, iid, instance, panelEl });
    resetOrderId(); // добавление позиции = изменение состава = новый заказ
    return instance;
  }

  // Дублировать позицию: создаём новую такого же типа и копируем все значения полей.
  function duplicateInstance(srcIid) {
    const src = instances.find(i => i.iid === srcIid);
    if (!src) return;
    document.getElementById('panels-container').classList.remove('single-panel');
    const newInst = createInstance(src.kind);
    const newRec = instances[instances.length - 1];
    const srcIdp = `${src.kind}-${srcIid}`;
    const dstIdp = `${newRec.kind}-${newRec.iid}`;
    const srcPanel = src.panelEl;
    const dstPanel = newRec.panelEl;

    // 1) Сначала обычные select и input (по совпадению id с заменой iid).
    //    Селекты копируем первыми и по порядку — чтобы отработали каскады (модель зависит от коллекции и т.д.)
    //    ВАЖНО: пропускаем поля внутри скрытых блоков (offsetParent===null), иначе активируются
    //    лишние служебные поля (например скрытая строка «Отделка» у коллекций, где её нет).
    const isVisible = (el) => el.offsetParent !== null;
    const copyField = (srcEl) => {
      if (!srcEl.id) return;
      if (!isVisible(srcEl)) return; // скрытое в оригинале — не трогаем в копии
      const dstId = srcEl.id.replace(`-${srcIid}`, `-${newRec.iid}`);
      const dstEl = dstPanel.querySelector('#' + CSS.escape(dstId));
      if (!dstEl) return;
      if (srcEl.type === 'checkbox' || srcEl.type === 'radio') {
        dstEl.checked = srcEl.checked;
      } else {
        dstEl.value = srcEl.value;
      }
      dstEl.dispatchEvent(new Event('change', { bubbles: true }));
      dstEl.dispatchEvent(new Event('input', { bubbles: true }));
    };
    // селекты по порядку
    srcPanel.querySelectorAll('select').forEach(copyField);
    // инпуты
    srcPanel.querySelectorAll('input').forEach(copyField);

    // 2) Кастомные цветовые дропдауны (.atlas-dd): копируем выбор, кликая по нужной опции
    //    в новой панели. Пропускаем скрытые (служебные) дропдауны.
    setTimeout(() => {
      const srcDds = srcPanel.querySelectorAll('.atlas-dd');
      srcDds.forEach(srcDd => {
        if (srcDd.offsetParent === null) return; // скрытый дропдаун — пропускаем
        const srcHidden = srcDd.querySelector('input[type="hidden"]');
        if (!srcHidden || !srcHidden.id || !srcHidden.value) return;
        const dstId = srcHidden.id.replace(`-${srcIid}`, `-${newRec.iid}`);
        const dstHidden = dstPanel.querySelector('#' + CSS.escape(dstId));
        if (!dstHidden) return;
        const dstDd = dstHidden.closest('.atlas-dd');
        if (!dstDd) return;
        // найти опцию с тем же value и кликнуть по ней
        const opt = dstDd.querySelector('.atlas-dd-option[data-value="' + CSS.escape(srcHidden.value) + '"]');
        if (opt) opt.click();
      });
      if (newInst && newInst.update) newInst.update();
      if (newInst && newInst.render) newInst.render();
      updateAll();
    }, 80);

    updateAll();
  }

  function removeInstance(iid) {
    const idx = instances.findIndex(i => i.iid === iid);
    if (idx === -1) return;
    const inst = instances[idx];
    inst.panelEl.remove();
    instances.splice(idx, 1);
    resetOrderId(); // удаление позиции = изменение состава = новый заказ
    // Пересчитываем сумму и кнопку PDF БЕЗ сброса просмотра у оставшихся позиций
    updateTotalSum();
    refreshPdfButton();
    // Если все удалены — на главную
    if (instances.length === 0) { returnToStart(); return; }
    // Если осталась одна позиция — вернуть центрирование (как при открытии одной)
    document.getElementById('panels-container').classList.toggle('single-panel', instances.length === 1);
  }

  function returnToStart() {
    instances.forEach(i => i.panelEl.remove());
    instances = [];
    nextIid = 1;
    selectionOrder = [];
    document.getElementById('start-screen').style.display='flex';
    document.getElementById('calculator-panels').style.display='none';
    document.querySelectorAll('.cat-check').forEach(cb=>{cb.checked=false;cb.closest('.category-card').classList.remove('active');});
    document.getElementById('panels-container').classList.remove('single-panel');
    document.getElementById('total-sum-block').style.display='none';
    window.scrollTo({top:0, behavior:'instant'});
  }

  function getTotalSum() {
    if (instances.length === 0) return null;
    let sum = 0;
    instances.forEach(({instance}) => {
      let t;
      if (typeof instance.getTotalPrice === 'function') t = instance.getTotalPrice();
      else if (typeof instance.calculate === 'function') t = instance.calculate();
      sum += (t !== null && t !== undefined ? t : 0);
    });
    return sum;
  }
  // Единая сборка спецификации позиции (используется при «Показать цену» и при PDF)
  function buildSlimItem(it){
    function colorDesc(x){
      var parts=[];
      if(x.elBodyMaterial) parts.push('Корпус: '+x.elBodyMaterial+(x.elBodyColor?(' '+x.elBodyColor):'')+(x.elBodyCustomCode?(' ['+x.elBodyCustomCode+']'):''));
      if(x.elFacadeColor) parts.push('Фасад: '+x.elFacadeColor);
      if(x.erMaterial) parts.push(x.erMaterial+(x.erColor?(' '+x.erColor):'')+(x.erCustomCode?(' ['+x.erCustomCode+']'):'')+(x.erFacadePattern?(', '+x.erFacadePattern):''));
      if(x.avMaterial) parts.push(x.avMaterial+(x.avColor?(' '+x.avColor):'')+(x.avCustomCode?(' ['+x.avCustomCode+']'):''));
      if(x.avTrim) parts.push('Окантовка: '+x.avTrim);
      if(x.vxMaterial) parts.push(x.vxMaterial+(x.vxColor?(' '+x.vxColor):'')+(x.vxCustomCode?(' ['+x.vxCustomCode+']'):'')+(x.vxFacadePattern?(', '+x.vxFacadePattern):''));
      if(x.twColor) parts.push(x.twColor);
      if(x.atBodyMaterial) parts.push('Корпус: '+x.atBodyMaterial+(x.atBodyColor?(' '+x.atBodyColor):'')+(x.atBodyCustomCode?(' ['+x.atBodyCustomCode+']'):''));
      if(x.atFacMaterial) parts.push('Фасад: '+x.atFacMaterial+(x.atFacColor?(' '+x.atFacColor):'')+(x.atFacCustomCode?(' ['+x.atFacCustomCode+']'):''));
      if(x.atFrameColor) parts.push('Рама: '+x.atFrameColor);
      return parts.join('; ');
    }
    return {
      type: it.type, collection: it.collection, model: it.model, article: it.article,
      width: it.width, depth: it.depth, height: it.height,
      finish: it.finish || '',
      spec: colorDesc(it),
      trim: it.trim || it.avTrim || '',
      light: it.light || '',
      mount: it.mount || '',
      shape: it.shape || '',
      fasades: it.fasades || '',
      price: it.price
    };
  }

