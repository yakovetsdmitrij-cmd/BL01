        if (isNaN(d) || d <= 0) missing.push('Глубина');
        if (isNaN(h) || h <= 0) missing.push('Высота');
        let reason = '';
        if (missing.length > 0) {
          reason = `Введите: ${missing.join(', ')}`;
        } else if (!isInRanges(w,this.currentModel.width)) {
          reason = `Ширина ${w} мм вне диапазона ${this.currentModel.width[0][0]}–${this.currentModel.width[0][1]} мм`;
        } else if (!isInRanges(d,this.currentModel.depth)) {
          reason = `Глубина ${d} мм вне диапазона ${this.currentModel.depth[0][0]}–${this.currentModel.depth[0][1]} мм`;
        } else if (!isInRanges(h,this.currentModel.height)) {
          reason = `Высота ${h} мм вне диапазона ${this.currentModel.height[0][0]}–${this.currentModel.height[0][1]} мм`;
        }
        this.resultDiv.innerHTML = reason ? `<div style="font-size:13px;color:#c87a00;">${reason}</div>` : '';
        return;
      }
      const recommended=Math.round(total*1.3);
      // Проверка обязательных полей (цвет/отделка/материал). Если не выбраны — подсказка.
      const missing = this.getMissingRequired();
      if (missing.length > 0) {
