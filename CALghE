    updateMirrorSchema() {
      const shapeText = this.shapeSelect.options[this.shapeSelect.selectedIndex]?.text || '';
      let shape = 'rect';
      if (shapeText.includes('Овальное')) shape='oval';
      else if (shapeText.includes('Круглое')) shape='circle';
      const hasLight = this.lightSelect && this.lightSelect.value==='led';
      const w_mm = parseFloat(this.widthInput.value);
      const h_mm = parseFloat(this.heightInput.value);
      const collection = this.collectionSelect ? this.collectionSelect.value : '';
      // Цвет полотна — определяется выбранной отделкой и цветом (и для покраски, и для шпона)
      let bodyColor = null;
      let isGlossy = false;
      let isVeneer = false;
      let isQuartz = false;
      const fKey = this.finishType ? this.finishType.value : '';
      const fColorVal = this.finishColorDD ? this.finishColorDD.getValue() : '';
      if (fKey && fKey !== 'paint_custom' && fColorVal) {
        const fin = (typeof resolveBodyMaterial === 'function') ? resolveBodyMaterial(fKey, fColorVal) : null;
        if (fin && fin.color) {
          bodyColor = fin.color;
          isGlossy = !!fin.isGlossy;
          isVeneer = (fKey === 'veneer');
          isQuartz = !!fin.isQuartz;
        }
      }
      // Окантовка (только для Авалона)
      let trimColor = null;
      if (this.trimDD && collection && COLLECTION_RENDER_STYLES[collection] === 'avalon') {
        trimColor = this.trimDD.getValue() || 'gold';
      }
      // Цветовая температура LED (используется для подсветки зеркала «Элемент»)
      const lightTemp = (this.lightTempSelect && hasLight) ? this.lightTempSelect.value : '2700';
      // Т-Вуд: два независимых слоя (внешний + внутренний). Resolveим цвета через resolveBodyMaterial.
      let twoodOuterColor = null, twoodInnerColor = null;
      let twoodOuterVeneer = false, twoodInnerVeneer = false;
      let twoodOuterGlossy = false, twoodInnerGlossy = false;
      if (collection && COLLECTION_RENDER_STYLES[collection] === 'twood') {
        const outMat = this.twoodOutMat ? this.twoodOutMat.value : '';
        const inMat  = this.twoodInMat  ? this.twoodInMat.value  : '';
        const outColorVal = this.twoodOutColorDD ? this.twoodOutColorDD.getValue() : '';
        const inColorVal  = this.twoodInColorDD  ? this.twoodInColorDD.getValue()  : '';
        if (outMat && outMat !== 'paint_custom' && outColorVal && typeof resolveBodyMaterial === 'function') {
          const fin = resolveBodyMaterial(outMat, outColorVal);
          if (fin && fin.color) {
            twoodOuterColor = fin.color;
            twoodOuterGlossy = !!fin.isGlossy;
            twoodOuterVeneer = (outMat === 'veneer');
          }
        }
        if (inMat && inMat !== 'paint_custom' && inColorVal && typeof resolveBodyMaterial === 'function') {
          const fin = resolveBodyMaterial(inMat, inColorVal);
          if (fin && fin.color) {
            twoodInnerColor = fin.color;
            twoodInnerGlossy = !!fin.isGlossy;
            twoodInnerVeneer = (inMat === 'veneer');
          }
        }
      }
      showSchema(`schema-${this.idp}`, svgMirror(shape, hasLight, w_mm, h_mm, {
        collection, bodyColor, isGlossy, isVeneer, isQuartz, trimColor, lightTemp,
        twoodOuterColor, twoodInnerColor,
        twoodOuterVeneer, twoodInnerVeneer,
        twoodOuterGlossy, twoodInnerGlossy
      }));
    }
    applyMirrorCollectionConstraints() {
      // Накладывает ограничения зеркала по коллекции.
      // Бланка: форма всегда "Прямоугольное", подсветки нет, добавляется поле "Отделка"+"Цвет".
      // Авалон: форма всегда "Прямоугольное", подсветки нет, отделка (только покраска) + окантовка золото/серебро.
      if (this.kind !== 'mirror' || !this.collectionSelect) return;
      const cKey = this.collectionSelect.value;
      const renderStyle = COLLECTION_RENDER_STYLES[cKey] || 'default';
      const lightCol = this.lightSelect ? this.lightSelect.closest('.col') : null;
      const lightTempCol = this.lightTempCol;
