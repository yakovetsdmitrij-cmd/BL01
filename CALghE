          // Если выбран тип установки — отображаем его, чтобы менеджер видел тип работы
          if (sinkTypeLabel) details.sinkLabel = sinkTypeLabel + ' — раковина клиента';
          else details.sinkLabel = 'Раковина клиента';
        } else if (sinkModelCt && sinkModelCt.selectedIndex > 0) {
          const txt = sinkModelCt.options[sinkModelCt.selectedIndex].text;
          details.sinkLabel = `${sinkTypeLabel} — ${txt}`;
