    " fill="${shadeColor}" fill-opacity="${shadeOpacity * 0.65}" stroke="#9a9a9a" stroke-width="0.6"/>`;
    svg += `<rect x="${x0 - overhangX}" y="${y0 + frontOverhangH}" width="${W + overhangX*2}" height="1"
      fill="rgba(0,0,0,0.18)" stroke="none"/>`;

    // ВЕРХНЯЯ ОКАНТОВКА (сразу под свесом)
    const upTrimY = y0 + frontOverhangH + 1;
    svg += `<rect x="${x0}" y="${upTrimY}" width="${W}" height="1.5" fill="${trim}" opacity="0.95"/>`;
    svg += `<polygon points="
      ${x0 + W},${upTrimY}
      ${x0 + W + dx},${upTrimY - dy}
      ${x0 + W + dx},${upTrimY - dy + 1.5}
      ${x0 + W},${upTrimY + 1.5}
    " fill="${trim}" opacity="0.95"/>`;

    // Правая грань тела (под окантовкой)
    const bodyTopY = upTrimY + 1.5;
    svg += `<polygon points="
      ${x0 + W},${bodyTopY}
      ${x0 + W + dx},${bodyTopY - dy}
      ${x0 + W + dx},${y0 + bodyH - dy}
      ${x0 + W},${y0 + bodyH}
    " fill="${shadeColor}" fill-opacity="${shadeOpacity * (facadeColor ? 0.65 : 1)}" stroke="#9a9a9a" stroke-width="0.8"/>`;

    // Передняя грань (полотно с филёнкой) — начинается под окантовкой
    const frontTopY = bodyTopY;
    const frontH = (y0 + bodyH) - frontTopY;
    svg += `<rect x="${x0}" y="${frontTopY}" width="${W}" height="${frontH}" fill="${baseColor}" fill-opacity="${opacity}" stroke="#9a9a9a" stroke-width="0.8"/>`;

    // ФИЛЁНКА на всём полотне пенала
    const filInsetX = Math.max(3, W * 0.08);
    const filInsetY = Math.max(4, frontH * 0.04);
    const filX = x0 + filInsetX;
    const filY = frontTopY + filInsetY;
    const filW = W - filInsetX * 2;
    const filH = frontH - filInsetY * 2;
    if (filW > 8 && filH > 12) {
      // ===== ДВОЙНАЯ ФИЛЁНКА (только линии, без затенения — чтобы цвет совпадал с корпусом) =====
      svg += `<rect x="${filX}" y="${filY}" width="${filW}" height="${filH}" rx="1.5"
        fill="none" stroke="rgba(0,0,0,0.45)" stroke-width="1.0"/>`;
      svg += `<path d="M ${filX+1} ${filY+filH-1} L ${filX+1} ${filY+1} L ${filX+filW-1} ${filY+1}"
        fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="0.7"/>`;
      const innerInset = Math.max(2, Math.min(filW, filH) * 0.06);
      if (filW - innerInset*2 > 4 && filH - innerInset*2 > 4) {
        const ix = filX + innerInset, iy = filY + innerInset;
        const iw = filW - innerInset*2, ih = filH - innerInset*2;
        svg += `<rect x="${ix}" y="${iy}" width="${iw}" height="${ih}" rx="1"
          fill="none" stroke="rgba(0,0,0,0.40)" stroke-width="0.8"/>`;
        svg += `<path d="M ${ix+0.7} ${iy+ih-0.7} L ${ix+0.7} ${iy+0.7} L ${ix+iw-0.7} ${iy+0.7}"
          fill="none" stroke="rgba(255,255,255,0.50)" stroke-width="0.6"/>`;
      }
    }

    // Глянцевый блик
    // Глянцевый блик отключён по запросу пользователя

    // Линии разделения фасадов
    const sepColor = 'rgba(0,0,0,0.35)';
    const sepW = 0.7;

    if (isGrid) {
      const cols = gridCols || 2;
      const rows = gridRows || 2;
      let colWs = [];
      if (gridColWidths && gridColWidths.length === cols) {
        const sumW = gridColWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
        if (sumW > 0) colWs = gridColWidths.map(v => (parseFloat(v)||0) / sumW * W);
      }
      if (colWs.length === 0) colWs = new Array(cols).fill(W / cols);
      let cx = x0;
      for (let i = 0; i < cols - 1; i++) {
        cx += colWs[i];
        svg += `<line x1="${cx}" y1="${frontTopY}" x2="${cx}" y2="${y0 + bodyH}" stroke="${sepColor}" stroke-width="${sepW}"/>`;
      }
      let rowHs = [];
      if (fasadeHeights && fasadeHeights.length === rows) {
        const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
        if (sumH > 0) rowHs = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * frontH);
      }
      if (rowHs.length === 0) rowHs = new Array(rows).fill(frontH / rows);
      let cy = frontTopY;
      for (let i = 0; i < rows - 1; i++) {
        cy += rowHs[i];
        svg += `<line x1="${x0}" y1="${cy}" x2="${x0 + W}" y2="${cy}" stroke="${sepColor}" stroke-width="${sepW}"/>`;
      }
    } else {
      // Один столбец, делится по высоте
      let heights = [];
      if (fasadeHeights && fasadeHeights.length === fasades) {
        const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
        if (sumH > 0) heights = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * frontH);
      }
      if (heights.length === 0) heights = new Array(fasades).fill(frontH / fasades);
      let cy = frontTopY;
      for (let i = 0; i < fasades - 1; i++) {
        cy += heights[i];
        svg += `<line x1="${x0}" y1="${cy}" x2="${x0 + W}" y2="${cy}" stroke="${sepColor}" stroke-width="${sepW}"/>`;
      }
    }

    // ЦОКОЛЬ + НИЖНЯЯ ОКАНТОВКА + СВЕС ДНА (симметрично верхней крышке)
    if (cokolH_p > 0) {
      const ckY = y0 + bodyH;
      const ckInsetX = Math.max(1, W * 0.012);
      const ckInsetD = Math.max(1, dx * 0.10);
      const ckInsetDy = Math.max(0.5, dy * 0.10);
      const ckX = x0 + ckInsetX;
      const ckW = W - ckInsetX * 2;
      const ckDx = dx - ckInsetD;
      const ckDy = dy - ckInsetDy;
      // 1. НИЖНЯЯ ОКАНТОВКА (сразу под корпусом)
      const trimY = ckY;
      svg += `<rect x="${x0}" y="${trimY}" width="${W}" height="1.5" fill="${trim}" opacity="0.95"/>`;
      svg += `<polygon points="
        ${x0 + W},${trimY}
        ${x0 + W + dx},${trimY - dy}
        ${x0 + W + dx},${trimY - dy + 1.5}
        ${x0 + W},${trimY + 1.5}
      " fill="${trim}" opacity="0.95"/>`;
      // 2. СВЕС ДНА — нижний свес меньше верхнего, лишь чуть выступает за корпус
      const botOverX = overhangX * 0.4;
      const botOverD = overhangD * 0.4;
      const bottomOverhangH = Math.max(4, H * 0.012);
      const ovY = trimY + 1.5;
      svg += `<rect x="${x0 - botOverX}" y="${ovY}" width="${W + botOverX*2}" height="${bottomOverhangH}"
        fill="${baseColor}" fill-opacity="${opacity * 0.95}" stroke="#9a9a9a" stroke-width="0.6"/>`;
      svg += `<polygon points="
        ${x0 + W + botOverX},${ovY}
        ${x0 + W + dx + botOverX + botOverD},${ovY - dy - botOverD}
        ${x0 + W + dx + botOverX + botOverD},${ovY - dy - botOverD + bottomOverhangH}
        ${x0 + W + botOverX},${ovY + bottomOverhangH}
      " fill="${shadeColor}" fill-opacity="${shadeOpacity * 0.65}" stroke="#9a9a9a" stroke-width="0.6"/>`;
      // 3. Тонкая тень под свесом
      svg += `<rect x="${x0 - botOverX}" y="${ovY + bottomOverhangH}" width="${W + botOverX*2}" height="1"
        fill="rgba(0,0,0,0.18)" stroke="none"/>`;
      // 4. Сам цоколь — утопленный, под свесом
      const cokolFrontY = ovY + bottomOverhangH + 1;
      const cokolFrontH = Math.max(3, cokolH_p - 1.5 - bottomOverhangH - 1);
      if (cokolFrontH > 0) {
        svg += `<rect x="${ckX}" y="${cokolFrontY}" width="${ckW}" height="${cokolFrontH}" fill="#3a3a3a" stroke="#9a9a9a" stroke-width="0.7"/>`;
        svg += `<polygon points="
          ${ckX + ckW},${cokolFrontY}
          ${ckX + ckW + ckDx},${cokolFrontY - ckDy}
          ${ckX + ckW + ckDx},${cokolFrontY + cokolFrontH - ckDy}
          ${ckX + ckW},${cokolFrontY + cokolFrontH}
        " fill="#2a2a2a" stroke="#9a9a9a" stroke-width="0.7"/>`;
      }
    } else {
      // Без цоколя — окантовка + свес дна (без цоколя)
      const trimY = y0 + bodyH;
      svg += `<rect x="${x0}" y="${trimY}" width="${W}" height="1.5" fill="${trim}" opacity="0.95"/>`;
      svg += `<polygon points="
        ${x0 + W},${trimY}
        ${x0 + W + dx},${trimY - dy}
        ${x0 + W + dx},${trimY - dy + 1.5}
        ${x0 + W},${trimY + 1.5}
      " fill="${trim}" opacity="0.95"/>`;
      const botOverX = overhangX * 0.4;
      const botOverD = overhangD * 0.4;
      const bottomOverhangH = Math.max(4, H * 0.012);
      const ovY = trimY + 1.5;
      svg += `<rect x="${x0 - botOverX}" y="${ovY}" width="${W + botOverX*2}" height="${bottomOverhangH}"
        fill="${baseColor}" fill-opacity="${opacity * 0.95}" stroke="#9a9a9a" stroke-width="0.6"/>`;
      svg += `<polygon points="
        ${x0 + W + botOverX},${ovY}
        ${x0 + W + dx + botOverX + botOverD},${ovY - dy - botOverD}
        ${x0 + W + dx + botOverX + botOverD},${ovY - dy - botOverD + bottomOverhangH}
        ${x0 + W + botOverX},${ovY + bottomOverhangH}
      " fill="${shadeColor}" fill-opacity="${shadeOpacity * 0.65}" stroke="#9a9a9a" stroke-width="0.6"/>`;
    }

    // Ножки — прямоугольные, отступ от края 50 мм. Ставятся от реального низа мебели (после свеса дна).
    if (hasLegs) {
      const bottomOverhangH = Math.max(4, H * 0.012);
      const legTopY = y0 + bodyH + 1.5 + bottomOverhangH;
      const legInset = (W / (w_mm || 600)) * 50;
      const legW = 11;
      [x0 + legInset, x0 + W - legInset - legW].forEach(lx => {
        svg += `<rect x="${lx}" y="${legTopY}" width="${legW}" height="${legH}" fill="${STROKE}" opacity="0.92"/>`;
      });
    }
    // Линия пола рисуется в начале (под тумбой) на уровне задней грани

    const fasadeLabel = fasades + ' ' + (fasades===1?'фасад':(fasades>=2 && fasades<=4)?'фасада':'фасадов');
    const mountLabel = isWall ? 'подвесной' : hasLegs ? 'напольный с ножками' : 'напольный (цоколь)';
    const trimLabel = trimColor === 'silver' ? 'серебро' : 'золото';
    // Подпись под фото убрана

    // Размерные стрелки
    // Размерные стрелки убраны

    svg += `</svg>`;
    return svg;
  }

  // ============================================================================
  // SVG ТУМБЫ — стиль "Элемент" (керамогранитные фасады в шпонированном/крашеном корпусе)
  // ============================================================================
  function svgCabinetElement(params) {
    const {
      fasades, mountType, w_mm, d_mm, h_mm,
      fasadeWidths, fasadeHeights, fasadeAxis,
      gridCols, gridRows, gridColWidths,
      mixedSingleColW, mixedTopH, mixedBottomH, mixedLeftW, mixedRightW, mixedCenterW,
      bodyColor, isBodyGlossy,        // цвет корпуса (шпон HEX или paint HEX)
      facadeColor                     // цвет керамогранита HEX
    } = params;
    const isWall = mountType === 'wall' || !mountType;
    const hasLegs = mountType === 'floor_legs';
    const isVertical = fasadeAxis === 'height';
    const isGridFasades = fasadeAxis === 'grid';
    const isMixed = fasadeAxis === 'mixed_1plus2' || fasadeAxis === 'mixed_2plus1';
    const isMixed3 = fasadeAxis === 'mixed_1plus2plus1';
    const SC = computeSmartScale(w_mm, d_mm, h_mm, {w:1500, d:500, h:600}, 220, 220);
    const W = SC.W_px;
    const H = SC.H_px;
    const D = SC.D_px * DEPTH_VISUAL_FACTOR;
    const dx = D * ISO_DX, dy = D * ISO_DY;
    const legH = hasLegs ? 22 : 0;
    const cokolH = (mountType === 'floor') ? 14 : 0;
    const bodyH = H - cokolH;
    const padL = 12, padT = 22;
    const totalW = W + dx + padL + 12;
    const totalH = H + dy + padT + legH + 8;
    const x0 = padL, y0 = padT + dy;

    const corpusColor = bodyColor || '#F1ECE0';
    const facColor = facadeColor || '#C8B493';

    // ЦАРГА — горизонтальная планка в цвет корпуса (30 мм реальных).
    // Переводим в пиксели через соотношение px/mm для высоты. Минимум 4 px чтобы было видно.
    const refH_mm = (h_mm && !isNaN(h_mm) && h_mm > 0) ? h_mm : 600;
    const TSARGA_MM = 30;
    const tsarga = Math.max(4, (H / refH_mm) * TSARGA_MM);

    let svg = `<svg viewBox="0 0 ${totalW} ${totalH}" xmlns="http://www.w3.org/2000/svg" style="width:auto;max-width:320px;max-height:320px;display:block;margin:0 auto;">`;
    svg += `<defs>
      <linearGradient id="elBodyGrad-${Math.random().toString(36).slice(2,8)}" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="rgba(255,255,255,0.06)"/>
        <stop offset="100%" stop-color="rgba(0,0,0,0.10)"/>
      </linearGradient>
    </defs>`;

    // Линия пола — рисуется ДО фигуры, перекроется телом тумбы
    if (mountType === 'floor' || mountType === 'floor_legs') {
      const fy = y0 + H + legH - dy;
      svg += `<line x1="${padL - 6}" y1="${fy}" x2="${totalW - 4}" y2="${fy}" stroke="#888" stroke-width="1.4"/>`;
    }
    // Тень только для подвесной
    if (isWall) {
      const shadowY = y0 + H + legH + 4;
      svg += `<ellipse cx="${x0 + W/2 + dx/2}" cy="${shadowY}" rx="${W/2.2}" ry="6" fill="rgba(0,0,0,0.14)"/>`;
    }

    // === Верхняя грань (крышка корпуса) ===
    svg += `<polygon points="
      ${x0},${y0}
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + dx},${y0 - dy}
    " fill="${corpusColor}" stroke="#9a9a9a" stroke-width="0.8"/>`;

    // === Правая боковая грань (тело корпуса) ===
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + bodyH - dy}
      ${x0 + W},${y0 + bodyH}
    " fill="${corpusColor}" stroke="#9a9a9a" stroke-width="0.8"/>`;
    // Лёгкое затемнение боковой грани (имитация поворота от света)
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + bodyH - dy}
      ${x0 + W},${y0 + bodyH}
    " fill="rgba(0,0,0,0.10)" stroke="none"/>`;

    // === Передняя грань корпуса (фон под фасадами) ===
    svg += `<rect x="${x0}" y="${y0}" width="${W}" height="${bodyH}" fill="${corpusColor}" stroke="#9a9a9a" stroke-width="0.8"/>`;

    // === ФАСАДЫ — керамогранитные плиты с зазором между ними (виден корпус) ===
    // + ЦАРГИ (планки в цвет корпуса) — сверху всегда; между рядами — для vertical/grid
    const inset = Math.max(2, Math.min(W, bodyH) * 0.018); // отступ от краёв корпуса
    const gap = Math.max(2, Math.min(W, bodyH) * 0.012);   // зазор между фасадами (виден корпус)
    const fInnerW = W - inset * 2;
    const fInnerH = bodyH - inset * 2;

    // Хелпер: рисует горизонтальную царгу на ширину фасадной зоны.
    // Сверху и снизу — тонкие тёмные щели на всю ширину между боковинами,
    // чтобы царга визуально была ОТДЕЛЬНОЙ горизонтальной планкой,
    // а не сливалась с боковинами в единую рамку.
    const drawTsarga = (ty, th) => {
      const gapH = 0.8;
      let s = '';
      // Тонкая тёмная щель сверху царги (на всю ширину между боковинами)
      s += `<rect x="${x0}" y="${ty}" width="${W}" height="${gapH}" fill="rgba(0,0,0,0.40)"/>`;
      // Сама царга (цвет корпуса)
      s += `<rect x="${x0 + inset}" y="${ty + gapH}" width="${fInnerW}" height="${th - gapH * 2}" fill="${corpusColor}" stroke="rgba(0,0,0,0.08)" stroke-width="0.5"/>`;
      // Тонкая тёмная щель снизу царги
      s += `<rect x="${x0}" y="${ty + th - gapH}" width="${W}" height="${gapH}" fill="rgba(0,0,0,0.40)"/>`;
      return s;
    };

    if (isMixed3) {
      // 1+2+1: 3 колонки (левая одинарная + центр с 2 фасадами + правая одинарная)
      const fasadeAreaX = x0 + inset;
      const fasadeAreaY = y0 + inset;
      const fasadeAreaW = fInnerW;
      const fasadeAreaH = fInnerH;
      const colGap = Math.max(2, fasadeAreaW * 0.012);
      const drawElFacade = (fx, fy, fw, fh) => {
        if (fw <= 0 || fh <= 0) return '';
        return renderCeramicPanel(fx, fy, fw, fh, facColor);
      };
      const thinGapPx = Math.max(2, gap);
      svg += renderTriColumnLayout({
        x0: fasadeAreaX, y0: fasadeAreaY, fInnerW: fasadeAreaW, fasadeAreaH: fasadeAreaH,
        w_mm, effH_mm: h_mm,
        leftW_mm: mixedLeftW || 0,
        rightW_mm: mixedRightW || 0,
        centerW_mm: mixedCenterW || 0,
        topH_mm: mixedTopH || 0,
        bottomH_mm: mixedBottomH || 0,
        gap: colGap,
        carga_px: thinGapPx,
        drawFacade: drawElFacade,
        drawCarga: null
      });
    } else if (isMixed) {
      // Смешанная компоновка: одна колонка-фасад + 2 фасада в широкой колонке
      const fasadeAreaX = x0 + inset;
      const fasadeAreaY = y0 + inset;
      const fasadeAreaW = fInnerW;
      const fasadeAreaH = fInnerH;
      const colGap = Math.max(2, fasadeAreaW * 0.012);
      const drawElFacade = (fx, fy, fw, fh) => {
        if (fw <= 0 || fh <= 0) return '';
        return renderCeramicPanel(fx, fy, fw, fh, facColor);
      };
      // Тонкий тёмный зазор между двумя широкими фасадами (как обычный gap, не полная царга),
      // чтобы не создавать иллюзию разделения одиночной колонки.
      const thinGapPx = Math.max(2, gap);
      svg += renderMixedFasadeLayout({
        x0: fasadeAreaX, y0: fasadeAreaY, fInnerW: fasadeAreaW, fasadeAreaH: fasadeAreaH,
        axis: fasadeAxis, w_mm, effH_mm: h_mm,
        singleColW_mm: mixedSingleColW || 0,
        topH_mm: mixedTopH || 0,
        bottomH_mm: mixedBottomH || 0,
        gap: colGap,
        carga_px: thinGapPx,
        drawFacade: drawElFacade,
        drawCarga: null  // null → renderMixedFasadeLayout нарисует обычную тёмную щель
      });
    } else if (isGridFasades) {
      const cols = gridCols || 2;
      const rows = gridRows || 2;
      // Верхняя царга
      svg += drawTsarga(y0 + inset, tsarga);
      // Доступная высота под фасады = fInnerH - верхняя_царга - (rows-1) царг между рядами
      const midTsargasTotal = (rows - 1) * tsarga;
      const fasadeAreaH = Math.max(10, fInnerH - tsarga - midTsargasTotal);
      let colWs = [];
      if (gridColWidths && gridColWidths.length === cols) {
        const sumW = gridColWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
        if (sumW > 0) colWs = gridColWidths.map(v => (parseFloat(v)||0) / sumW * fInnerW);
      }
      if (colWs.length === 0) colWs = new Array(cols).fill(fInnerW / cols);
      let rowHs = [];
      if (fasadeHeights && fasadeHeights.length === rows) {
        const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
        if (sumH > 0) rowHs = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * fasadeAreaH);
      }
      if (rowHs.length === 0) rowHs = new Array(rows).fill(fasadeAreaH / rows);
      let cx = x0 + inset;
      for (let col = 0; col < cols; col++) {
        const fw = colWs[col] - (col < cols - 1 ? gap : 0);
        let cy = y0 + inset + tsarga;  // первый ряд начинается под верхней царгой
        for (let row = 0; row < rows; row++) {
          svg += renderCeramicPanel(cx, cy, fw, rowHs[row], facColor);
          cy += rowHs[row];
          // Между рядами — царга на всю ширину (рисуем один раз, при первой колонке)
          if (row < rows - 1 && col === 0) {
            svg += drawTsarga(cy, tsarga);
          }
          cy += (row < rows - 1) ? tsarga : 0;
        }
        cx += colWs[col];
      }
    } else if (isVertical) {
      // Вертикальное деление (BL04 = 2 фасада друг над другом, BL12 и т.п.):
      // царга сверху + царги между фасадами
      svg += drawTsarga(y0 + inset, tsarga);
      const midTsargasTotal = (fasades - 1) * tsarga;
      const fasadeAreaH = Math.max(10, fInnerH - tsarga - midTsargasTotal);
      let heights = [];
      if (fasadeHeights && fasadeHeights.length === fasades) {
        const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
        if (sumH > 0) heights = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * fasadeAreaH);
      }
      if (heights.length === 0) heights = new Array(fasades).fill(fasadeAreaH / fasades);
      let cy = y0 + inset + tsarga;
      for (let i = 0; i < fasades; i++) {
        svg += renderCeramicPanel(x0 + inset, cy, fInnerW, heights[i], facColor);
        cy += heights[i];
        if (i < fasades - 1) {
          svg += drawTsarga(cy, tsarga);
          cy += tsarga;
        }
      }
    } else {
      // Горизонтальное деление (BL01-BL03: 1/2/3 фасада в один ряд):
      // только верхняя царга, между фасадами по ширине — обычный зазор корпуса
      svg += drawTsarga(y0 + inset, tsarga);
      const fasadeAreaH = Math.max(10, fInnerH - tsarga);
      let widths = [];
      if (fasadeWidths && fasadeWidths.length === fasades) {
        const sumW = fasadeWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
        if (sumW > 0) widths = fasadeWidths.map(v => (parseFloat(v)||0) / sumW * fInnerW);
      }
      if (widths.length === 0) widths = new Array(fasades).fill(fInnerW / fasades);
      let cx = x0 + inset;
      for (let i = 0; i < fasades; i++) {
        const fw = widths[i] - (i < fasades - 1 ? gap : 0);
        svg += renderCeramicPanel(cx, y0 + inset + tsarga, fw, fasadeAreaH, facColor);
        cx += widths[i];
      }
    }

    // === ЦОКОЛЬ (того же материала что и корпус) ===
    if (cokolH > 0) {
      const ckY = y0 + bodyH;
      const ckInsetX = Math.max(1, W * 0.012);
      const ckInsetD = Math.max(1, dx * 0.10);
      const ckInsetDy = Math.max(0.5, dy * 0.10);
      const ckX = x0 + ckInsetX;
      const ckW = W - ckInsetX * 2;
      const ckDx = dx - ckInsetD;
      const ckDy = dy - ckInsetDy;
      // Цоколь = корпусный цвет, чуть темнее (тень из-за выреза)
      svg += `<rect x="${ckX}" y="${ckY}" width="${ckW}" height="${cokolH}" fill="${corpusColor}" stroke="#9a9a9a" stroke-width="0.7"/>`;
      svg += `<rect x="${ckX}" y="${ckY}" width="${ckW}" height="${cokolH}" fill="rgba(0,0,0,0.25)" stroke="none"/>`;
      svg += `<polygon points="
        ${ckX + ckW},${ckY}
        ${ckX + ckW + ckDx},${ckY - ckDy}
        ${ckX + ckW + ckDx},${ckY + cokolH - ckDy}
        ${ckX + ckW},${ckY + cokolH}
      " fill="${corpusColor}" stroke="#9a9a9a" stroke-width="0.7"/>`;
      svg += `<polygon points="
        ${ckX + ckW},${ckY}
        ${ckX + ckW + ckDx},${ckY - ckDy}
        ${ckX + ckW + ckDx},${ckY + cokolH - ckDy}
        ${ckX + ckW},${ckY + cokolH}
      " fill="rgba(0,0,0,0.40)" stroke="none"/>`;
    }

    // === Ножки — прямоугольные, от низа корпуса. Отступ от края 50 мм. ===
    if (hasLegs) {
      const legInset = (W / (w_mm || 1500)) * 50;
      const legW = 9;
      [x0 + legInset, x0 + W - legInset - legW].forEach(lx => {
        svg += `<rect x="${lx}" y="${y0 + bodyH}" width="${legW}" height="${legH}" fill="#1a1a1a" opacity="0.92"/>`;
      });
    }

    svg += `</svg>`;
    return svg;
  }

  // Хелпер: рисует керамогранитную плиту с лёгкой текстурой и тенью по краю
  function renderCeramicPanel(x, y, w, h, color) {
    if (w <= 0 || h <= 0) return '';
    let s = '';
    // Основа — керамогранит
    s += `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${color}" stroke="rgba(0,0,0,0.35)" stroke-width="0.6"/>`;
    // Лёгкий вертикальный градиент (имитация природного рисунка камня)
    s += `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="url(#elPanelShade)" opacity="0.22"/>`;
    // Тонкая тень по верху и левому краю — даёт глубину "плиты"
    s += `<rect x="${x}" y="${y}" width="${w}" height="0.8" fill="rgba(0,0,0,0.18)"/>`;
    s += `<rect x="${x}" y="${y}" width="0.8" height="${h}" fill="rgba(0,0,0,0.18)"/>`;
    return s;
  }

  // ============================================================================
  // SVG ПЕНАЛА — стиль "Элемент"
  // ============================================================================
  function svgPenalElement(params) {
    const {
      fasades, mountType, w_mm, d_mm, h_mm,
      fasadeHeights, fasadeAxis,
      gridCols, gridRows, gridColWidths,
      hingeSide,
      bodyColor, isBodyGlossy,
      facadeColor
    } = params;
    const isWall = mountType === 'wall' || !mountType;
    const hasLegs = mountType === 'floor_legs';
    const isGrid = fasadeAxis === 'grid';

    const SC = computeSmartScale(w_mm, d_mm, h_mm, {w:600, d:400, h:1500}, 220, 220);
    const W = SC.W_px;
    const H = SC.H_px;
    const D = SC.D_px * DEPTH_VISUAL_FACTOR;
    const dx = D * ISO_DX, dy = D * ISO_DY;
    const legH = hasLegs ? 18 : 0;
    const cokolH_p = (mountType === 'floor') ? 12 : 0;
    const bodyH = H - cokolH_p;
    const padL = 12, padT = 18;
    const totalW = W + dx + padL + 12;
    const totalH = H + dy + padT + legH + 8;
    const x0 = padL, y0 = padT + dy;

    const corpusColor = bodyColor || '#F1ECE0';
    const facColor = facadeColor || '#C8B493';

    // ЦАРГА — планка в цвет корпуса (30 мм). В пенале только МЕЖДУ фасадами.
    const refH_mm = (h_mm && !isNaN(h_mm) && h_mm > 0) ? h_mm : 1500;
    const TSARGA_MM = 30;
    const tsarga = Math.max(3, (H / refH_mm) * TSARGA_MM);

    let svg = `<svg viewBox="0 0 ${totalW} ${totalH}" xmlns="http://www.w3.org/2000/svg" style="width:auto;max-width:240px;max-height:240px;display:block;margin:0 auto;">`;
    svg += `<defs>
      <linearGradient id="elPanelShade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="rgba(255,255,255,0.10)"/>
        <stop offset="50%" stop-color="rgba(255,255,255,0)"/>
        <stop offset="100%" stop-color="rgba(0,0,0,0.10)"/>
      </linearGradient>
    </defs>`;

    if (mountType === 'floor' || mountType === 'floor_legs') {
      const fy = y0 + H + legH - dy;
      svg += `<line x1="${padL - 6}" y1="${fy}" x2="${totalW - 4}" y2="${fy}" stroke="#888" stroke-width="1.4"/>`;
    }
    if (isWall) {
      const shadowY = y0 + H + legH + 4;
      svg += `<ellipse cx="${x0 + W/2 + dx/2}" cy="${shadowY}" rx="${W/1.6}" ry="5" fill="rgba(0,0,0,0.14)"/>`;
    }

    // Верхняя грань
    svg += `<polygon points="
      ${x0},${y0}
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + dx},${y0 - dy}
    " fill="${corpusColor}" stroke="#9a9a9a" stroke-width="0.7"/>`;

    // Правая грань
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + bodyH - dy}
      ${x0 + W},${y0 + bodyH}
    " fill="${corpusColor}" stroke="#9a9a9a" stroke-width="0.7"/>`;
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + bodyH - dy}
      ${x0 + W},${y0 + bodyH}
    " fill="rgba(0,0,0,0.10)" stroke="none"/>`;

    // Передняя грань (фон под фасадами)
    svg += `<rect x="${x0}" y="${y0}" width="${W}" height="${bodyH}" fill="${corpusColor}" stroke="#9a9a9a" stroke-width="0.7"/>`;

    // Фасады
    const inset = Math.max(2, Math.min(W, bodyH) * 0.02);
    const gap = Math.max(2, Math.min(W, bodyH) * 0.012);
    const fInnerW = W - inset * 2;
    const fInnerH = bodyH - inset * 2;

    // Хелпер для пенала: царга с тонкими тёмными щелями сверху/снизу,
    // чтобы НЕ сливалась с боковинами в единую рамку.
    const drawTsarga = (ty, th) => {
      const gapH = 0.7;
      let s = '';
      s += `<rect x="${x0}" y="${ty}" width="${W}" height="${gapH}" fill="rgba(0,0,0,0.40)"/>`;
      s += `<rect x="${x0 + inset}" y="${ty + gapH}" width="${fInnerW}" height="${th - gapH * 2}" fill="${corpusColor}" stroke="rgba(0,0,0,0.08)" stroke-width="0.5"/>`;
      s += `<rect x="${x0}" y="${ty + th - gapH}" width="${W}" height="${gapH}" fill="rgba(0,0,0,0.40)"/>`;
      return s;
    };

    if (isGrid) {
      // Сетка (BL12 = 2×2): царга между верхним и нижним рядом
      const cols = gridCols || 2;
      const rows = gridRows || 2;
      const midTsargasTotal = (rows - 1) * tsarga;
      const fasadeAreaH = Math.max(10, fInnerH - midTsargasTotal);
      let colWs = [];
      if (gridColWidths && gridColWidths.length === cols) {
        const sumW = gridColWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
        if (sumW > 0) colWs = gridColWidths.map(v => (parseFloat(v)||0) / sumW * fInnerW);
      }
      if (colWs.length === 0) colWs = new Array(cols).fill(fInnerW / cols);
      let rowHs = [];
      if (fasadeHeights && fasadeHeights.length === rows) {
        const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
        if (sumH > 0) rowHs = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * fasadeAreaH);
      }
      if (rowHs.length === 0) rowHs = new Array(rows).fill(fasadeAreaH / rows);
      let cx = x0 + inset;
      for (let col = 0; col < cols; col++) {
        const fw = colWs[col] - (col < cols - 1 ? gap : 0);
        let cy = y0 + inset;
        for (let row = 0; row < rows; row++) {
          svg += renderCeramicPanel(cx, cy, fw, rowHs[row], facColor);
          cy += rowHs[row];
          if (row < rows - 1 && col === 0) {
            svg += drawTsarga(cy, tsarga);
          }
          cy += (row < rows - 1) ? tsarga : 0;
        }
        cx += colWs[col];
      }
    } else {
      // Вертикальные фасады (один столбец, BL10/BL11/BL12):
      // царги между фасадами (если их > 1)
      const midTsargasTotal = (fasades - 1) * tsarga;
      const fasadeAreaH = Math.max(10, fInnerH - midTsargasTotal);
      let heights = [];
      if (fasadeHeights && fasadeHeights.length === fasades) {
        const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
        if (sumH > 0) heights = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * fasadeAreaH);
      }
      if (heights.length === 0) heights = new Array(fasades).fill(fasadeAreaH / fasades);
      let cy = y0 + inset;
      for (let i = 0; i < fasades; i++) {
        svg += renderCeramicPanel(x0 + inset, cy, fInnerW, heights[i], facColor);
        cy += heights[i];
        if (i < fasades - 1) {
          svg += drawTsarga(cy, tsarga);
          cy += tsarga;
        }
      }
    }

    // Цоколь
    if (cokolH_p > 0) {
      const ckY = y0 + bodyH;
      const ckInsetX = Math.max(1, W * 0.012);
      const ckInsetD = Math.max(1, dx * 0.10);
      const ckInsetDy = Math.max(0.5, dy * 0.10);
      const ckX = x0 + ckInsetX;
      const ckW = W - ckInsetX * 2;
      const ckDx = dx - ckInsetD;
      const ckDy = dy - ckInsetDy;
      svg += `<rect x="${ckX}" y="${ckY}" width="${ckW}" height="${cokolH_p}" fill="${corpusColor}" stroke="#9a9a9a" stroke-width="0.6"/>`;
      svg += `<rect x="${ckX}" y="${ckY}" width="${ckW}" height="${cokolH_p}" fill="rgba(0,0,0,0.25)" stroke="none"/>`;
      svg += `<polygon points="
        ${ckX + ckW},${ckY}
        ${ckX + ckW + ckDx},${ckY - ckDy}
        ${ckX + ckW + ckDx},${ckY + cokolH_p - ckDy}
        ${ckX + ckW},${ckY + cokolH_p}
      " fill="${corpusColor}" stroke="#9a9a9a" stroke-width="0.6"/>`;
      svg += `<polygon points="
        ${ckX + ckW},${ckY}
        ${ckX + ckW + ckDx},${ckY - ckDy}
        ${ckX + ckW + ckDx},${ckY + cokolH_p - ckDy}
        ${ckX + ckW},${ckY + cokolH_p}
      " fill="rgba(0,0,0,0.40)" stroke="none"/>`;
    }

    if (hasLegs) {
      const legInset = (W / (w_mm || 600)) * 50;
      const legW = 11;
      [x0 + legInset, x0 + W - legInset - legW].forEach(lx => {
        svg += `<rect x="${lx}" y="${y0 + bodyH}" width="${legW}" height="${legH}" fill="#1a1a1a" opacity="0.92"/>`;
      });
    }

    svg += `</svg>`;
    return svg;
  }

  // ============================================================================
  // SVG ТУМБЫ И ПЕНАЛА — стиль "Эриадор"
  //  - Единая коробка ОДНОГО ЦВЕТА (выбранного пользователем)
  //  - Тонкие тёмные щели разделяют ФАСАД от боковин по бокам (и снизу для тумб без цоколя)
  //  - ЦАРГИ (полосы цвета корпуса) сверху и между фасадами по высоте — как у Элемента
  //  - Крышка точно по габариту корпуса, БЕЗ свеса
  //  - Передние вертикальные рёбра имеют лёгкое скругление (блик/тень)
  // ============================================================================

  // Помощник: основная геометрия Эриадора (тумба или пенал).
  // opts.kind = 'cabinet' | 'penal'  — управляет наличием верхней царги.
  // opts.modelArticle — артикул модели (для определения нужны ли средние царги: BL04 → 2 ряда, BL05 → grid)
  // opts.fasadeRender(fX, fY, fW, fH) — колбэк рендера фасадов в выделенной зоне.
  function renderEridatorBody(opts) {
    const {
      x0, y0, W, H, dx, dy,
      bodyColor, sideRatio, refH_mm,
      cokolH, kind,
      hasTopCarga,         // true для тумбы (всегда верхняя царга)
      hasMiddleCargas,     // true если фасады разделены по высоте (тогда между ними царги)
      cargaCount,          // сколько средних царг (rows - 1)
      fasadeRender,
      strokeColor
    } = opts;

    let svg = '';
    const sideW = Math.max(6, W * sideRatio);
    const sideR = Math.max(1.5, Math.min(sideW * 0.5, 4));
    const lipY = Math.max(2, H * 0.014);
    const gapColor = 'rgba(0,0,0,0.40)';
    const edgeShadow = 'rgba(0,0,0,0.13)';
    const edgeHilite = 'rgba(255,255,255,0.18)';
    // Высота царги — реальные 30 мм (как у Элемента)
    const cargaH = Math.max(4, (H / refH_mm) * 30);

    // === 1. ОСНОВНОЕ ТЕЛО КОРПУСА ===
    svg += `<rect x="${x0}" y="${y0}" width="${W}" height="${H}"
      fill="${bodyColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;
    // Правая боковая глубина в перспективе
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + H - dy}
      ${x0 + W},${y0 + H}
    " fill="${bodyColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + H - dy}
      ${x0 + W},${y0 + H}
    " fill="rgba(0,0,0,0.18)" stroke="none"/>`;

    // === 2. ЗОНА ФАСАДОВ (между боковинами и царгой/цоколем) ===
    const fasadeX0 = x0 + sideW + 1.2;
    const fasadeX1 = x0 + W - sideW - 1.2;
    const fasadeAreaW = fasadeX1 - fasadeX0;
    const fasadeTopY = y0 + (hasTopCarga ? cargaH : 0);
    const fasadeBotY = y0 + H - cokolH;
    const fasadeAreaH = fasadeBotY - fasadeTopY;

    // === 3. ТЁМНЫЕ ЩЕЛИ ПО БОКАМ ФАСАДА ===
    // Идут от самого верха корпуса (от крышки) до самого низа корпуса (через нижнюю царгу).
    // Это разделяет царги (и верхнюю, и нижнюю) от боковин — они НЕ образуют единую рамку с боковинами,
    // а "висят" между ними как отдельные горизонтальные планки.
    const sideGapTop = y0;
    const sideGapBot = y0 + H;
    const sideGapH = sideGapBot - sideGapTop;
    // Левая щель
    svg += `<rect x="${x0 + sideW}" y="${sideGapTop}" width="1.2" height="${sideGapH}"
      fill="${gapColor}"/>`;
    // Правая щель
    svg += `<rect x="${x0 + W - sideW - 1.2}" y="${sideGapTop}" width="1.2" height="${sideGapH}"
      fill="${gapColor}"/>`;

    // === 4. ВЕРХНЯЯ ЦАРГА (только если hasTopCarga = true) ===
    // У тумб всегда есть, у пеналов нет (по умолчанию у Элемента).
    // Это полоса цвета корпуса между крышкой и верхним фасадом — отделена тонкими щелями сверху и снизу.
    if (hasTopCarga) {
      // Тонкая щель сверху царги (между крышкой и царгой)
      svg += `<rect x="${fasadeX0}" y="${y0}" width="${fasadeAreaW}" height="0.8"
        fill="${gapColor}"/>`;
      // Тонкая щель снизу царги (между царгой и верхним фасадом)
      svg += `<rect x="${fasadeX0}" y="${fasadeTopY - 0.8}" width="${fasadeAreaW}" height="0.8"
        fill="${gapColor}"/>`;
    } else {
      // Без верхней царги — просто тёмная щель между крышкой и верхним фасадом
      const gapTopH = Math.max(1, H * 0.008);
      svg += `<rect x="${fasadeX0}" y="${y0}" width="${fasadeAreaW}" height="${gapTopH}"
        fill="${gapColor}"/>`;
    }

    // === 5. СКРУГЛЕНИЕ ПЕРЕДНИХ ВЕРТИКАЛЬНЫХ РЁБЕР (лёгкое) ===
    svg += `<rect x="${x0}" y="${y0}" width="${sideR}" height="${H}"
      fill="${edgeHilite}"/>`;
    svg += `<rect x="${x0 + W - sideR}" y="${y0}" width="${sideR}" height="${H}"
      fill="${edgeShadow}"/>`;

    // === 6. ФАСАДЫ (с возможными средними царгами через колбэк) ===
    // Эффективная зона для фасадов = fasadeAreaH минус щели сверху от царги (если она есть)
    const fasadeEffTopY = hasTopCarga ? fasadeTopY : fasadeTopY + Math.max(1, H * 0.008);
    const fasadeEffH = fasadeBotY - fasadeEffTopY;
    if (fasadeEffH > 4 && fasadeAreaW > 4) {
      svg += fasadeRender(fasadeX0, fasadeEffTopY, fasadeAreaW, fasadeEffH, cargaH);
    }

    // === 7. НИЖНЯЯ ЦАРГА (только при mountType='floor', "напольная с цоколем") ===
    // Симметрично верхней царге: полоса цвета корпуса, отделена тонкими тёмными щелями
    // сверху и снизу — но только в пределах самой царги, чтобы боковая вертикальная щель
    // была видна по бокам царги (царга НЕ сливается с боковинами в рамку).
    if (cokolH > 0) {
      // Тонкая щель сверху царги — только над самой царгой (между внутренних краёв)
      svg += `<rect x="${fasadeX0}" y="${fasadeBotY}" width="${fasadeAreaW}" height="0.8"
        fill="${gapColor}"/>`;
      // Сама царга (цвет корпуса)
      svg += `<rect x="${fasadeX0}" y="${fasadeBotY + 0.8}" width="${fasadeAreaW}" height="${cokolH - 1.6}"
        fill="${bodyColor}" stroke="rgba(0,0,0,0.08)" stroke-width="0.5"/>`;
      // Тонкая щель снизу царги
      svg += `<rect x="${fasadeX0}" y="${fasadeBotY + cokolH - 0.8}" width="${fasadeAreaW}" height="0.8"
        fill="${gapColor}"/>`;
    }

    // === 8. КРЫШКА (точно по габариту корпуса, без свеса) ===
    const topY = y0 - lipY;
    // Передняя грань крышки (тонкая полоса)
    svg += `<rect x="${x0}" y="${topY}" width="${W}" height="${lipY}"
      fill="${bodyColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;
    // Верхняя грань крышки (в перспективе)
    svg += `<polygon points="
      ${x0},${topY}
      ${x0 + W},${topY}
      ${x0 + W + dx},${topY - dy}
      ${x0 + dx},${topY - dy}
    " fill="${bodyColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;
    // Правая грань крышки (с глубиной)
    svg += `<polygon points="
      ${x0 + W},${topY}
      ${x0 + W + dx},${topY - dy}
      ${x0 + W + dx},${topY - dy + lipY}
      ${x0 + W},${topY + lipY}
    " fill="${bodyColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;
    svg += `<polygon points="
      ${x0 + W},${topY}
      ${x0 + W + dx},${topY - dy}
      ${x0 + W + dx},${topY - dy + lipY}
      ${x0 + W},${topY + lipY}
    " fill="rgba(0,0,0,0.18)" stroke="none"/>`;

    return svg;
  }

  // ============================================================================
  // svgCabinetEridator
  // ============================================================================
  function svgCabinetEridator(params) {
    const {
      fasades, mountType, w_mm, d_mm, h_mm,
      fasadeWidths, fasadeHeights, fasadeAxis,
      gridCols, gridRows, gridColWidths,
      mixedSingleColW, mixedTopH, mixedBottomH, mixedLeftW, mixedRightW, mixedCenterW,
      bodyColor, isBodyGlossy,
      facadePattern
    } = params;
    const isWall = mountType === 'wall' || !mountType;
    const hasLegs = mountType === 'floor_legs';
    const onFloor = mountType === 'floor';
    const isVertical = fasadeAxis === 'height';
    const isGridFasades = fasadeAxis === 'grid';
    const isMixed = fasadeAxis === 'mixed_1plus2' || fasadeAxis === 'mixed_2plus1';
    const isMixed3 = fasadeAxis === 'mixed_1plus2plus1';

    const SC = computeSmartScale(w_mm, d_mm, h_mm, {w:1500, d:500, h:600}, 240, 240);
    const W = SC.W_px;
    const H = SC.H_px;
    const D = SC.D_px * DEPTH_VISUAL_FACTOR;
    const dx = D * ISO_DX, dy = D * ISO_DY;
    const legH = hasLegs ? 22 : 0;
    const padL = 16, padT = 28;
    const totalW = W + dx + padL * 2;
    const totalH = H + dy + padT + legH + 12;
    const x0 = padL, y0 = padT + dy;

    const corpusColor = bodyColor || '#F1ECE0';
    const strokeColor = '#5a4f56';

    const refH_mm = (h_mm && !isNaN(h_mm) && h_mm > 0) ? h_mm : 600;
    const cokolH = onFloor ? Math.max(8, (H / refH_mm) * 50) : 0;

    let svg = `<svg viewBox="0 0 ${totalW} ${totalH}" xmlns="http://www.w3.org/2000/svg" style="width:auto;max-width:300px;max-height:300px;display:block;margin:0 auto;">`;

    if (onFloor || hasLegs) {
      const fy = y0 + H + legH - dy;
      svg += `<line x1="${padL - 6}" y1="${fy}" x2="${totalW - 4}" y2="${fy}" stroke="#888" stroke-width="1.4"/>`;
    }
    if (isWall) {
      const shadowY = y0 + H + 4;
      svg += `<ellipse cx="${x0 + W/2 + dx/2}" cy="${shadowY}" rx="${W/2.2}" ry="6" fill="rgba(0,0,0,0.14)"/>`;
    }

    // Колбэк рендера фасадов с царгами цвета корпуса между рядами
    const fasadeRender = (fX, fY, fW, fH, cargaH) => {
      let s = '';
      // Тонкая щель между колонками (внутри одного ряда)
      const drawColGap = (cx, cy, ch) => {
        const colGap = Math.max(1.5, fW * 0.008);
        return `<rect x="${cx}" y="${cy}" width="${colGap}" height="${ch}" fill="rgba(0,0,0,0.40)"/>`;
      };
      // Царга между рядами (полоса цвета корпуса с тонкими щелями сверху и снизу)
      const drawRowCarga = (rX, rY, rW) => {
        let r = '';
        r += `<rect x="${rX}" y="${rY}" width="${rW}" height="0.8" fill="rgba(0,0,0,0.40)"/>`;
        r += `<rect x="${rX}" y="${rY + cargaH - 0.8}" width="${rW}" height="0.8" fill="rgba(0,0,0,0.40)"/>`;
        return r;
      };

      if (isMixed3) {
        const colGap = Math.max(1.5, fW * 0.008);
        const drawCargaForMixed = (cx, cy, cw, ch) => {
          let r = '';
          r += `<rect x="${cx}" y="${cy}" width="${cw}" height="0.8" fill="rgba(0,0,0,0.40)"/>`;
          r += `<rect x="${cx}" y="${cy}" width="${cw}" height="${ch}" fill="${corpusColor}" stroke="rgba(0,0,0,0.10)" stroke-width="0.5"/>`;
          r += `<rect x="${cx}" y="${cy + ch - 0.8}" width="${cw}" height="0.8" fill="rgba(0,0,0,0.40)"/>`;
          return r;
        };
        s += renderTriColumnLayout({
          x0: fX, y0: fY, fInnerW: fW, fasadeAreaH: fH,
          w_mm, effH_mm: h_mm,
          leftW_mm: mixedLeftW || 0,
          rightW_mm: mixedRightW || 0,
          centerW_mm: mixedCenterW || 0,
          topH_mm: mixedTopH || 0,
          bottomH_mm: mixedBottomH || 0,
          gap: colGap,
          carga_px: cargaH,
          drawFacade: (fx, fy, fw, fh) => renderEridatorFacade(fx, fy, fw, fh, corpusColor, facadePattern, isBodyGlossy),
          drawCarga: drawCargaForMixed
        });
      } else if (isMixed) {
        // Смешанная компоновка: 1 колонка-фасад + 2 фасада в широкой колонке
        const colGap = Math.max(1.5, fW * 0.008);
        const drawCargaForMixed = (cx, cy, cw, ch) => {
          let r = '';
          r += `<rect x="${cx}" y="${cy}" width="${cw}" height="0.8" fill="rgba(0,0,0,0.40)"/>`;
          r += `<rect x="${cx}" y="${cy}" width="${cw}" height="${ch}" fill="${corpusColor}" stroke="rgba(0,0,0,0.10)" stroke-width="0.5"/>`;
          r += `<rect x="${cx}" y="${cy + ch - 0.8}" width="${cw}" height="0.8" fill="rgba(0,0,0,0.40)"/>`;
          return r;
        };
        s += renderMixedFasadeLayout({
          x0: fX, y0: fY, fInnerW: fW, fasadeAreaH: fH,
          axis: fasadeAxis, w_mm, effH_mm: h_mm,
          singleColW_mm: mixedSingleColW || 0,
          topH_mm: mixedTopH || 0,
          bottomH_mm: mixedBottomH || 0,
          gap: colGap,
          carga_px: cargaH,
          drawFacade: (fx, fy, fw, fh) => renderEridatorFacade(fx, fy, fw, fh, corpusColor, facadePattern, isBodyGlossy),
          drawCarga: drawCargaForMixed
        });
      } else if (isGridFasades) {
        const cols = gridCols || 2;
        const rows = gridRows || 2;
        const totalCarga = cargaH * (rows - 1);
        const usableH = fH - totalCarga;
        let rowHs = [];
        if (fasadeHeights && fasadeHeights.length === rows) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) rowHs = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (rowHs.length === 0) rowHs = new Array(rows).fill(usableH / rows);
        let colWs = [];
        if (gridColWidths && gridColWidths.length === cols) {
          const sumW = gridColWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumW > 0) colWs = gridColWidths.map(v => (parseFloat(v)||0) / sumW * fW);
        }
        if (colWs.length === 0) colWs = new Array(cols).fill(fW / cols);
        const colGap = Math.max(1.5, fW * 0.008);
        let cy = fY;
        for (let row = 0; row < rows; row++) {
          let cx = fX;
          for (let col = 0; col < cols; col++) {
            const fw = colWs[col] - (col < cols - 1 ? colGap : 0);
            s += renderEridatorFacade(cx, cy, fw, rowHs[row], corpusColor, facadePattern, isBodyGlossy);
            if (col < cols - 1) {
              s += drawColGap(cx + fw, cy, rowHs[row]);
            }
            cx += colWs[col];
          }
          cy += rowHs[row];
          if (row < rows - 1) {
            s += drawRowCarga(fX, cy, fW);
            cy += cargaH;
          }
        }
      } else if (isVertical) {
        const totalCarga = cargaH * (fasades - 1);
        const usableH = fH - totalCarga;
        let heights = [];
        if (fasadeHeights && fasadeHeights.length === fasades) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) heights = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (heights.length === 0) heights = new Array(fasades).fill(usableH / fasades);
        let cy = fY;
        for (let i = 0; i < fasades; i++) {
          s += renderEridatorFacade(fX, cy, fW, heights[i], corpusColor, facadePattern, isBodyGlossy);
          cy += heights[i];
          if (i < fasades - 1) {
            s += drawRowCarga(fX, cy, fW);
            cy += cargaH;
          }
        }
      } else {
        let widths = [];
        if (fasadeWidths && fasadeWidths.length === fasades) {
          const sumW = fasadeWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumW > 0) widths = fasadeWidths.map(v => (parseFloat(v)||0) / sumW * fW);
        }
        if (widths.length === 0) widths = new Array(fasades).fill(fW / fasades);
        const colGap = Math.max(1.5, fW * 0.008);
        let cx = fX;
        for (let i = 0; i < fasades; i++) {
          const fw = widths[i] - (i < fasades - 1 ? colGap : 0);
          s += renderEridatorFacade(cx, fY, fw, fH, corpusColor, facadePattern, isBodyGlossy);
          if (i < fasades - 1) {
            s += drawColGap(cx + fw, fY, fH);
          }
          cx += widths[i];
        }
      }
      return s;
    };

    svg += renderEridatorBody({
      x0, y0, W, H, dx, dy,
      bodyColor: corpusColor,
      sideRatio: 0.05,
      refH_mm,
      cokolH,
      kind: 'cabinet',
      hasTopCarga: true,           // у тумбы ВСЕГДА верхняя царга (как у Элемента)
      fasadeRender,
      strokeColor
    });

    if (hasLegs) {
      const legInset = (W / (w_mm || 1500)) * 50;
      const legW = 9;
      [x0 + legInset, x0 + W - legInset - legW].forEach(lx => {
        svg += `<rect x="${lx}" y="${y0 + H}" width="${legW}" height="${legH}" fill="#1a1a1a" opacity="0.92"/>`;
      });
    }

    svg += `</svg>`;
    return svg;
  }

  function renderEridatorFacade(x, y, w, h, color, pattern, isGlossy) {
    if (w <= 0 || h <= 0) return '';
    let s = '';
    s += `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${color}" stroke="rgba(0,0,0,0.20)" stroke-width="0.4"/>`;
    if (pattern && pattern !== 'flat') {
      s += renderFacadePattern(x, y, w, h, pattern);
    }
    return s;
  }

  function renderFacadePattern(x, y, w, h, pattern) {
    let s = '';
    const darkLine = 'rgba(0,0,0,0.42)';
    const lightLine = 'rgba(255,255,255,0.18)';
    if (pattern === 'narrow_rail') {
      const step = Math.max(2, w * 0.022);
      for (let cx = x + step; cx < x + w; cx += step) {
        s += `<line x1="${cx}" y1="${y + 1}" x2="${cx}" y2="${y + h - 1}" stroke="${darkLine}" stroke-width="0.7"/>`;
        s += `<line x1="${cx + 0.5}" y1="${y + 1}" x2="${cx + 0.5}" y2="${y + h - 1}" stroke="${lightLine}" stroke-width="0.5"/>`;
      }
    } else if (pattern === 'wide_rail') {
      const step = Math.max(6, w * 0.07);
      for (let cx = x + step; cx < x + w - 1; cx += step) {
        s += `<line x1="${cx}" y1="${y + 1}" x2="${cx}" y2="${y + h - 1}" stroke="${darkLine}" stroke-width="1.2"/>`;
        s += `<line x1="${cx + 1}" y1="${y + 1}" x2="${cx + 1}" y2="${y + h - 1}" stroke="${lightLine}" stroke-width="0.7"/>`;
      }
    } else if (pattern === 'fine_wave') {
      const step = Math.max(4, w * 0.05);
      for (let cx = x + step/2; cx < x + w; cx += step) {
        s += `<line x1="${cx}" y1="${y + 1}" x2="${cx}" y2="${y + h - 1}" stroke="${darkLine}" stroke-width="0.8"/>`;
        s += `<line x1="${cx + step*0.45}" y1="${y + 2}" x2="${cx + step*0.45}" y2="${y + h - 2}" stroke="${lightLine}" stroke-width="0.5"/>`;
      }
    } else if (pattern === 'trapezoid') {
      const step = Math.max(6, w * 0.065);
      for (let cx = x + step; cx < x + w - 1; cx += step) {
        s += `<line x1="${cx}" y1="${y + 1}" x2="${cx}" y2="${y + h - 1}" stroke="${darkLine}" stroke-width="1"/>`;
        const center = cx - step/2;
        s += `<line x1="${center}" y1="${y + 2}" x2="${center}" y2="${y + h - 2}" stroke="${lightLine}" stroke-width="0.7"/>`;
      }
    } else if (pattern === 'rhombus') {
      // 3D-ромбы (мини-пирамидки): каждый ромб поделён на 4 треугольные грани от центра к углам,
      // с разной освещённостью — это создаёт эффект выпуклости (свет слева-сверху).
      // Все ромбы аккуратно вписаны в фасад через clipPath чтобы не вылезали за края.

      // Уникальный id для clipPath (одинаковый для всех ромбов одного фасада)
      const clipId = 'erRombClip-' + Math.random().toString(36).slice(2, 8);
      // Inset от краёв фасада — небольшая рамка, в которой будут ромбы
      const pad = Math.max(3, Math.min(w, h) * 0.04);
      const innerX = x + pad;
      const innerY = y + pad;
      const innerW = w - pad * 2;
      const innerH = h - pad * 2;
      if (innerW <= 6 || innerH <= 6) return s;

      // Размер одного ромба — старается быть пропорциональным фасаду
      // Цель: 6-9 ромбов в ряд по горизонтали, 4-7 рядов по вертикали
      const targetCols = Math.max(4, Math.min(10, Math.round(innerW / 22)));
      const stepX = innerW / targetCols;
      // Высота ряда чуть меньше ширины ромба чтобы пропорция была "узкий ромб" как на фото
      const stepY = stepX * 0.85;
      // Количество рядов так чтобы влезало целое число и сохранялась шахматка
      const rows = Math.max(3, Math.round(innerH / stepY));
      const stepYAdj = innerH / rows;

      // clipPath по границе фасада с inset
      s += `<defs><clipPath id="${clipId}"><rect x="${innerX}" y="${innerY}" width="${innerW}" height="${innerH}"/></clipPath></defs>`;
      // Группа всех ромбов с обрезкой по clipPath
      s += `<g clip-path="url(#${clipId})">`;

      // Цвета 4 граней пирамидки — оттенки от светлого (свет слева-сверху) до тёмного (тень снизу-справа)
      const faceTL = 'rgba(255,255,255,0.42)';   // верхне-левая — самая яркая
      const faceTR = 'rgba(255,255,255,0.16)';   // верхне-правая — слегка светлая
      const faceBL = 'rgba(0,0,0,0.18)';         // нижне-левая — слегка тёмная
      const faceBR = 'rgba(0,0,0,0.42)';         // нижне-правая — самая тёмная (в тени)
      const seamColor = 'rgba(0,0,0,0.30)';      // тёмная "впадина" по швам между ромбами

      // Полуширины и полувысоты ромбов
      const halfW = stepX * 0.5;
      const halfH = stepYAdj * 0.5;

      // Расширяем диапазон на 1 ромб с каждой стороны — clipPath обрежет
      for (let row = -1; row <= rows + 1; row++) {
        const cy = innerY + row * stepYAdj + halfH;
        const offset = (row % 2 === 0) ? 0 : halfW;
        for (let col = -1; col <= targetCols + 1; col++) {
          const cx = innerX + col * stepX + offset + halfW;
          // Точки ромба: top, right, bot, left + центр (вершина пирамидки)
          const tx = cx,            ty = cy - halfH;
          const rx = cx + halfW,    ry = cy;
          const bx = cx,            by = cy + halfH;
          const lx = cx - halfW,    ly = cy;
          // Центральная точка чуть смещена вверх-влево чтобы вершина пирамидки выглядела "приподнятой к свету"
          const ccx = cx, ccy = cy;
          // Четыре треугольные грани от центра к 4 сторонам
          // Верхне-левая грань: центр - top - left
          s += `<polygon points="${ccx},${ccy} ${tx},${ty} ${lx},${ly}" fill="${faceTL}" stroke="${seamColor}" stroke-width="0.35"/>`;
          // Верхне-правая грань: центр - top - right
          s += `<polygon points="${ccx},${ccy} ${tx},${ty} ${rx},${ry}" fill="${faceTR}" stroke="${seamColor}" stroke-width="0.35"/>`;
          // Нижне-левая грань: центр - bot - left
          s += `<polygon points="${ccx},${ccy} ${bx},${by} ${lx},${ly}" fill="${faceBL}" stroke="${seamColor}" stroke-width="0.35"/>`;
          // Нижне-правая грань: центр - bot - right
          s += `<polygon points="${ccx},${ccy} ${bx},${by} ${rx},${ry}" fill="${faceBR}" stroke="${seamColor}" stroke-width="0.35"/>`;
        }
      }

      s += `</g>`;
    }
    return s;
  }

  // ============================================================================
  // svgPenalEridator (БЕЗ верхней царги, средние царги между фасадами есть)
  // ============================================================================
  function svgPenalEridator(params) {
    const {
      fasades, mountType, w_mm, d_mm, h_mm,
      fasadeHeights, fasadeAxis,
      gridCols, gridRows, gridColWidths,
      bodyColor, isBodyGlossy,
      facadePattern
    } = params;
    const isWall = mountType === 'wall' || !mountType;
    const onFloor = mountType === 'floor';
    const hasLegs = mountType === 'floor_legs';
    const isGrid = fasadeAxis === 'grid';

    const SC = computeSmartScale(w_mm, d_mm, h_mm, {w:600, d:400, h:1500}, 240, 240);
    const W = SC.W_px;
    const H = SC.H_px;
    const D = SC.D_px * DEPTH_VISUAL_FACTOR;
    const dx = D * ISO_DX, dy = D * ISO_DY;
    const legH = hasLegs ? 18 : 0;
    const padL = 14, padT = 22;
    const totalW = W + dx + padL * 2;
    const totalH = H + dy + padT + legH + 12;
    const x0 = padL, y0 = padT + dy;

    const corpusColor = bodyColor || '#F1ECE0';
    const strokeColor = '#5a4f56';
    const refH_mm = (h_mm && !isNaN(h_mm) && h_mm > 0) ? h_mm : 1500;
    const cokolH_p = onFloor ? Math.max(6, (H / refH_mm) * 50) : 0;

    let svg = `<svg viewBox="0 0 ${totalW} ${totalH}" xmlns="http://www.w3.org/2000/svg" style="width:auto;max-width:240px;max-height:240px;display:block;margin:0 auto;">`;

    if (onFloor || hasLegs) {
      const fy = y0 + H + legH - dy;
      svg += `<line x1="${padL - 6}" y1="${fy}" x2="${totalW - 4}" y2="${fy}" stroke="#888" stroke-width="1.4"/>`;
    }
    if (isWall) {
      const shadowY = y0 + H + 4;
      svg += `<ellipse cx="${x0 + W/2 + dx/2}" cy="${shadowY}" rx="${W/1.6}" ry="5" fill="rgba(0,0,0,0.14)"/>`;
    }

    const fasadeRender = (fX, fY, fW, fH, cargaH) => {
      let s = '';
      const drawColGap = (cx, cy, ch) => {
        const colGap = Math.max(1.5, fW * 0.008);
        return `<rect x="${cx}" y="${cy}" width="${colGap}" height="${ch}" fill="rgba(0,0,0,0.40)"/>`;
      };
      const drawRowCarga = (rX, rY, rW) => {
        let r = '';
        r += `<rect x="${rX}" y="${rY}" width="${rW}" height="0.8" fill="rgba(0,0,0,0.40)"/>`;
        r += `<rect x="${rX}" y="${rY + cargaH - 0.8}" width="${rW}" height="0.8" fill="rgba(0,0,0,0.40)"/>`;
        return r;
      };

      if (isGrid) {
        const cols = gridCols || 2;
        const rows = gridRows || 2;
        const totalCarga = cargaH * (rows - 1);
        const usableH = fH - totalCarga;
        let rowHs = [];
        if (fasadeHeights && fasadeHeights.length === rows) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) rowHs = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (rowHs.length === 0) rowHs = new Array(rows).fill(usableH / rows);
        let colWs = [];
        if (gridColWidths && gridColWidths.length === cols) {
          const sumW = gridColWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumW > 0) colWs = gridColWidths.map(v => (parseFloat(v)||0) / sumW * fW);
        }
        if (colWs.length === 0) colWs = new Array(cols).fill(fW / cols);
        const colGap = Math.max(1.5, fW * 0.008);
        let cy = fY;
        for (let row = 0; row < rows; row++) {
          let cx = fX;
          for (let col = 0; col < cols; col++) {
            const fw = colWs[col] - (col < cols - 1 ? colGap : 0);
            s += renderEridatorFacade(cx, cy, fw, rowHs[row], corpusColor, facadePattern, isBodyGlossy);
            if (col < cols - 1) {
              s += drawColGap(cx + fw, cy, rowHs[row]);
            }
            cx += colWs[col];
          }
          cy += rowHs[row];
          if (row < rows - 1) {
            s += drawRowCarga(fX, cy, fW);
            cy += cargaH;
          }
        }
      } else {
        // Пенал — фасады по высоте
        const totalCarga = cargaH * (fasades - 1);
        const usableH = fH - totalCarga;
        let heights = [];
        if (fasadeHeights && fasadeHeights.length === fasades) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) heights = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (heights.length === 0) heights = new Array(fasades).fill(usableH / fasades);
        let cy = fY;
        for (let i = 0; i < fasades; i++) {
          s += renderEridatorFacade(fX, cy, fW, heights[i], corpusColor, facadePattern, isBodyGlossy);
          cy += heights[i];
          if (i < fasades - 1) {
            s += drawRowCarga(fX, cy, fW);
            cy += cargaH;
          }
        }
      }
      return s;
    };

    svg += renderEridatorBody({
      x0, y0, W, H, dx, dy,
      bodyColor: corpusColor,
      sideRatio: 0.03,
      refH_mm,
      cokolH: cokolH_p,
      kind: 'penal',
      hasTopCarga: false,        // у пенала НЕТ верхней царги (как у Элемента)
      fasadeRender,
      strokeColor
    });

    if (hasLegs) {
      const legInset = (W / (w_mm || 600)) * 50;
      const legW = 11;
      [x0 + legInset, x0 + W - legInset - legW].forEach(lx => {
        svg += `<rect x="${lx}" y="${y0 + H}" width="${legW}" height="${legH}" fill="#1a1a1a" opacity="0.92"/>`;
      });
    }

    svg += `</svg>`;
    return svg;
  }

    // ============================================================================
  // SVG ТУМБЫ И ПЕНАЛА — стиль "Авалон"
  //  - Классический корпус с металлической окантовкой сверху и снизу (золото/серебро)
  //  - Фасады с двойной рамкой-фрезеровкой по периметру
  //  - Большие круглые ручки-кольца в центре каждого фасада (в цвет окантовки)
  //  - Точёные конические ножки с металлическими наконечниками (опционально)
  //  - 3 типа установки: Подвесная / На точёных ножках / Напольная (без цоколя)
  // ============================================================================

  // Хелпер: один фасад Авалона — плита с двойной рамкой и кольцевой ручкой
  function renderAvalonFacade(x, y, w, h, color, trim, scaleRef) {
    if (w <= 0 || h <= 0) return '';
    let s = '';
    // Базовая плита
    s += `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${color}" stroke="rgba(0,0,0,0.22)" stroke-width="0.5"/>`;
    // Если задан scaleRef — он используется как "опорный размер" вместо min(w,h),
    // чтобы рамки/ручки получились одного физического размера во всех фасадах одной тумбы.
    const refSize = (scaleRef && scaleRef > 0) ? scaleRef : Math.min(w, h);
    // === Двойная рамка-фрезеровка по периметру ===
    if (w > 16 && h > 16) {
      // Отступ рамки — пропорционален опорному размеру, но ограничен минимально/максимально по фасаду
      const outerInset = Math.max(3, Math.min(refSize * 0.07, Math.min(w, h) * 0.18));
      const fx = x + outerInset;
      const fy = y + outerInset;
      const fw = w - outerInset * 2;
      const fh = h - outerInset * 2;
      if (fw > 6 && fh > 6) {
        s += `<rect x="${fx}" y="${fy}" width="${fw}" height="${fh}"
          fill="none" stroke="${trim}" stroke-width="1.4" opacity="0.92"/>`;
        s += `<rect x="${fx + 0.7}" y="${fy + 0.7}" width="${fw - 1.4}" height="${fh - 1.4}"
          fill="none" stroke="rgba(0,0,0,0.30)" stroke-width="0.4"/>`;
        const innerStep = Math.max(2, refSize * 0.025);
        if (fw - innerStep * 2 > 4 && fh - innerStep * 2 > 4) {
          s += `<rect x="${fx + innerStep}" y="${fy + innerStep}"
            width="${fw - innerStep * 2}" height="${fh - innerStep * 2}"
            fill="none" stroke="${trim}" stroke-width="0.7" opacity="0.78"/>`;
        }
      }
    }
    // === Круглая ручка-кольцо в центре фасада ===
    // Размер привязан к scaleRef, но обрезан по фактическому фасаду чтобы не вылезала
    const ringR_ideal = Math.max(2.5, refSize * 0.10);
    const ringR_maxByFacade = Math.min(w, h) * 0.30;
    const r = Math.min(ringR_ideal, ringR_maxByFacade);
    const cx = x + w / 2;
    const cy = y + h / 2;
    if (r > 1.5) {
      s += `<circle cx="${cx + 0.6}" cy="${cy + 0.6}" r="${r}" fill="none" stroke="rgba(0,0,0,0.32)" stroke-width="${Math.max(1.2, r * 0.28)}"/>`;
      s += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${trim}" stroke-width="${Math.max(1.2, r * 0.28)}"/>`;
      s += `<path d="M ${cx - r * 0.6} ${cy - r * 0.5} A ${r} ${r} 0 0 1 ${cx + r * 0.2} ${cy - r * 0.95}"
        fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="${Math.max(0.6, r * 0.12)}"/>`;
    }
    return s;
  }

  // Helper для рисования общего корпуса Авалона (тумба + пенал)
  function renderAvalonBody(opts) {
    const {
      x0, y0, W, H, dx, dy,
      bodyColor, trim, refH_mm,
      onFloor, hasLegs,
      hasTopCarga,    // только тумба
      fasadeRender,
      strokeColor
    } = opts;

    let svg = '';
    // Высота окантовки и царги
    const trimH = Math.max(2, H * 0.014);
    const cargaH = Math.max(4, (H / refH_mm) * 30);
    const insetX = Math.max(3, W * 0.025);
    const fInnerW = W - insetX * 2;

    // === 1. ВЕРХНЯЯ ГРАНЬ (плоская крышка в перспективе) ===
    svg += `<polygon points="
      ${x0},${y0}
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + dx},${y0 - dy}
    " fill="${bodyColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;

    // === 2. ПРАВАЯ БОКОВАЯ ГРАНЬ (глубина) ===
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + H - dy}
      ${x0 + W},${y0 + H}
    " fill="${bodyColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;
    svg += `<polygon points="
      ${x0 + W},${y0}
      ${x0 + W + dx},${y0 - dy}
      ${x0 + W + dx},${y0 + H - dy}
      ${x0 + W},${y0 + H}
    " fill="rgba(0,0,0,0.18)" stroke="none"/>`;

    // === 3. ПЕРЕДНЯЯ ГРАНЬ КОРПУСА ===
    svg += `<rect x="${x0}" y="${y0}" width="${W}" height="${H}"
      fill="${bodyColor}" stroke="${strokeColor}" stroke-width="0.7"/>`;

    // === 4. ВЕРХНЯЯ ОКАНТОВКА — металлическая полоса (золото/серебро) сразу под крышкой ===
    const upperTrimY = y0 + 1;
    svg += `<rect x="${x0}" y="${upperTrimY}" width="${W}" height="${trimH}"
      fill="${trim}" opacity="0.95"/>`;
    // Боковая грань окантовки в перспективе
    svg += `<polygon points="
      ${x0 + W},${upperTrimY}
      ${x0 + W + dx},${upperTrimY - dy}
      ${x0 + W + dx},${upperTrimY - dy + trimH}
      ${x0 + W},${upperTrimY + trimH}
    " fill="${trim}" opacity="0.95"/>`;

    // === 5. ВЕРХНЯЯ ЦАРГА (только для тумбы — полоска корпуса под окантовкой перед фасадами) ===
    let fasadeTopY = upperTrimY + trimH + 1;
    if (hasTopCarga) {
      svg += `<rect x="${x0}" y="${fasadeTopY}" width="${W}" height="${cargaH}"
        fill="${bodyColor}" stroke="rgba(0,0,0,0.10)" stroke-width="0.5"/>`;
      fasadeTopY += cargaH;
    }

    // === 6. НИЖНЯЯ ОКАНТОВКА — металлическая полоса перед низом корпуса ===
    const lowerTrimY = y0 + H - trimH - 1;
    svg += `<rect x="${x0}" y="${lowerTrimY}" width="${W}" height="${trimH}"
      fill="${trim}" opacity="0.95"/>`;
    svg += `<polygon points="
      ${x0 + W},${lowerTrimY}
      ${x0 + W + dx},${lowerTrimY - dy}
      ${x0 + W + dx},${lowerTrimY - dy + trimH}
      ${x0 + W},${lowerTrimY + trimH}
    " fill="${trim}" opacity="0.95"/>`;

    const fasadeBotY = lowerTrimY - 1;
    const fasadeAreaH = fasadeBotY - fasadeTopY;
    const fasadeX0 = x0 + insetX;

    // === 7. ФАСАДЫ ===
    if (fasadeAreaH > 4 && fInnerW > 4) {
      svg += fasadeRender(fasadeX0, fasadeTopY, fInnerW, fasadeAreaH, cargaH);
    }

    return svg;
  }

  // Хелпер: точёная коническая ножка с металлическим наконечником (для Авалона)
  function renderAvalonLeg(lx, ly, legW, legH, trim) {
    // Точёная ножка — сверху шире, к низу сужается, наконечник — золотой/серебряный квадратик
    let s = '';
    // Тёмная вертикальная стойка (трапеция: широкая сверху, узкая снизу)
    const topW = legW;
    const botW = Math.max(2, legW * 0.45);
    const tipH = Math.max(2.5, legH * 0.16);  // высота металлического наконечника
    const woodH = legH - tipH;
    // Верхняя широкая часть (трапеция)
    const topX = lx;
    const topRightX = lx + topW;
    const botLeftX = lx + (topW - botW) / 2;
    const botRightX = botLeftX + botW;
    s += `<polygon points="
      ${topX},${ly}
      ${topRightX},${ly}
      ${botRightX},${ly + woodH}
      ${botLeftX},${ly + woodH}
    " fill="#3a2a1f" stroke="#1a1a1a" stroke-width="0.4" opacity="0.92"/>`;
    // Наконечник — металлический квадратик
    s += `<rect x="${botLeftX}" y="${ly + woodH}" width="${botW}" height="${tipH}"
      fill="${trim}" stroke="#1a1a1a" stroke-width="0.3" opacity="0.95"/>`;
    return s;
  }

  function svgCabinetAvalon(params) {
    const {
      fasades, mountType, w_mm, d_mm, h_mm,
      fasadeWidths, fasadeHeights, fasadeAxis,
      gridCols, gridRows, gridColWidths,
      mixedSingleColW, mixedTopH, mixedBottomH, mixedLeftW, mixedRightW, mixedCenterW,
      bodyColor, isBodyGlossy,
      trimColor
    } = params;
    const isWall = mountType === 'wall' || !mountType;
    const hasLegs = mountType === 'floor_legs';
    const onFloor = mountType === 'floor';
    const isVertical = fasadeAxis === 'height';
    const isGridFasades = fasadeAxis === 'grid';
    const isMixed = fasadeAxis === 'mixed_1plus2' || fasadeAxis === 'mixed_2plus1';
    const isMixed3 = fasadeAxis === 'mixed_1plus2plus1';

    const SC = computeSmartScale(w_mm, d_mm, h_mm, {w:1500, d:500, h:600}, 240, 240);
    const W = SC.W_px;
    const H = SC.H_px;
    const D = SC.D_px * DEPTH_VISUAL_FACTOR;
    const dx = D * ISO_DX, dy = D * ISO_DY;
    const legH = hasLegs ? Math.max(28, H * 0.45) : 0;  // высокие точёные ножки
    const padL = 16, padT = 28;
    const totalW = W + dx + padL * 2;
    const totalH = H + dy + padT + legH + 14;
    const x0 = padL, y0 = padT + dy;

    const corpusColor = bodyColor || '#F1ECE0';
    const strokeColor = '#5a4f56';
    const trim = TRIM_COLORS[trimColor] || TRIM_COLORS.gold;
    const refH_mm = (h_mm && !isNaN(h_mm) && h_mm > 0) ? h_mm : 600;
    // Опорный размер для рамок и колец-ручек: единый для всех фасадов на тумбе.
    // Берём минимум из (треть ширины) и (половина высоты) — это размер "среднего" фасада.
    const avalonScaleRef = Math.min(W * 0.32, H * 0.50);

    let svg = `<svg viewBox="0 0 ${totalW} ${totalH}" xmlns="http://www.w3.org/2000/svg" style="width:auto;max-width:300px;max-height:300px;display:block;margin:0 auto;">`;

    if (onFloor || hasLegs) {
      const fy = y0 + H + legH - dy;
      svg += `<line x1="${padL - 6}" y1="${fy}" x2="${totalW - 4}" y2="${fy}" stroke="#888" stroke-width="1.4"/>`;
    }
    if (isWall) {
      const shadowY = y0 + H + 4;
      svg += `<ellipse cx="${x0 + W/2 + dx/2}" cy="${shadowY}" rx="${W/2.2}" ry="6" fill="rgba(0,0,0,0.14)"/>`;
    }

    const fasadeRender = (fX, fY, fW, fH, cargaH) => {
      let s = '';
      const gap = Math.max(2, Math.min(fW, fH) * 0.012);
      if (isMixed3) {
        const drawCargaForMixed = (cx, cy, cw, ch) => {
          return `<rect x="${cx}" y="${cy}" width="${cw}" height="${ch}" fill="${corpusColor}" stroke="rgba(0,0,0,0.10)" stroke-width="0.5"/>`;
        };
        s += renderTriColumnLayout({
          x0: fX, y0: fY, fInnerW: fW, fasadeAreaH: fH,
          w_mm, effH_mm: h_mm,
          leftW_mm: mixedLeftW || 0,
          rightW_mm: mixedRightW || 0,
          centerW_mm: mixedCenterW || 0,
          topH_mm: mixedTopH || 0,
          bottomH_mm: mixedBottomH || 0,
          gap: gap,
          carga_px: cargaH,
          drawFacade: (fx, fy, fw, fh) => renderAvalonFacade(fx, fy, fw, fh, corpusColor, trim, avalonScaleRef),
          drawCarga: drawCargaForMixed
        });
      } else if (isMixed) {
        // Смешанная компоновка: 1 одиночная колонка + 2 фасада в широкой колонке
        const drawCargaForMixed = (cx, cy, cw, ch) => {
          return `<rect x="${cx}" y="${cy}" width="${cw}" height="${ch}" fill="${corpusColor}" stroke="rgba(0,0,0,0.10)" stroke-width="0.5"/>`;
        };
        s += renderMixedFasadeLayout({
          x0: fX, y0: fY, fInnerW: fW, fasadeAreaH: fH,
          axis: fasadeAxis, w_mm, effH_mm: h_mm,
          singleColW_mm: mixedSingleColW || 0,
          topH_mm: mixedTopH || 0,
          bottomH_mm: mixedBottomH || 0,
          gap: gap,
          carga_px: cargaH,
          drawFacade: (fx, fy, fw, fh) => renderAvalonFacade(fx, fy, fw, fh, corpusColor, trim, avalonScaleRef),
          drawCarga: drawCargaForMixed
        });
      } else if (isGridFasades) {
        const cols = gridCols || 2;
        const rows = gridRows || 2;
        const totalCarga = cargaH * (rows - 1);
        const usableH = fH - totalCarga;
        let rowHs = [];
        if (fasadeHeights && fasadeHeights.length === rows) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) rowHs = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (rowHs.length === 0) rowHs = new Array(rows).fill(usableH / rows);
        let colWs = [];
        if (gridColWidths && gridColWidths.length === cols) {
          const sumW = gridColWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumW > 0) colWs = gridColWidths.map(v => (parseFloat(v)||0) / sumW * fW);
        }
        if (colWs.length === 0) colWs = new Array(cols).fill(fW / cols);
        let cy = fY;
        for (let row = 0; row < rows; row++) {
          let cx = fX;
          for (let col = 0; col < cols; col++) {
            const fw = colWs[col] - (col < cols - 1 ? gap : 0);
            s += renderAvalonFacade(cx, cy, fw, rowHs[row], corpusColor, trim, avalonScaleRef);
            cx += colWs[col];
          }
          cy += rowHs[row];
          if (row < rows - 1) {
            // Царга между рядами (того же цвета корпуса)
            s += `<rect x="${fX}" y="${cy}" width="${fW}" height="${cargaH}"
              fill="${corpusColor}" stroke="rgba(0,0,0,0.10)" stroke-width="0.5"/>`;
            cy += cargaH;
          }
        }
      } else if (isVertical) {
        const totalCarga = cargaH * (fasades - 1);
        const usableH = fH - totalCarga;
        let heights = [];
        if (fasadeHeights && fasadeHeights.length === fasades) {
          const sumH = fasadeHeights.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumH > 0) heights = fasadeHeights.map(v => (parseFloat(v)||0) / sumH * usableH);
        }
        if (heights.length === 0) heights = new Array(fasades).fill(usableH / fasades);
        let cy = fY;
        for (let i = 0; i < fasades; i++) {
          s += renderAvalonFacade(fX, cy, fW, heights[i], corpusColor, trim, avalonScaleRef);
          cy += heights[i];
          if (i < fasades - 1) {
            s += `<rect x="${fX}" y="${cy}" width="${fW}" height="${cargaH}"
              fill="${corpusColor}" stroke="rgba(0,0,0,0.10)" stroke-width="0.5"/>`;
            cy += cargaH;
          }
        }
      } else {
        let widths = [];
        if (fasadeWidths && fasadeWidths.length === fasades) {
          const sumW = fasadeWidths.reduce((s,v)=>s+(parseFloat(v)||0),0);
          if (sumW > 0) widths = fasadeWidths.map(v => (parseFloat(v)||0) / sumW * fW);
        }
        if (widths.length === 0) widths = new Array(fasades).fill(fW / fasades);
        let cx = fX;
        for (let i = 0; i < fasades; i++) {
          const fw = widths[i] - (i < fasades - 1 ? gap : 0);
          s += renderAvalonFacade(cx, fY, fw, fH, corpusColor, trim, avalonScaleRef);
          cx += widths[i];
        }
      }
      return s;
    };

    svg += renderAvalonBody({
      x0, y0, W, H, dx, dy,
      bodyColor: corpusColor,
      trim,
      refH_mm,
      onFloor, hasLegs,
      hasTopCarga: true,   // у тумбы всегда верхняя царга
      fasadeRender,
      strokeColor
    });

    // Точёные конические ножки (опционально)
    if (hasLegs) {
      const legInset = (W / (w_mm || 1500)) * 50;
      const legW = Math.max(7, W * 0.025);
      [x0 + legInset, x0 + W - legInset - legW].forEach(lx => {
        svg += renderAvalonLeg(lx, y0 + H, legW, legH, trim);
      });
    }

    svg += `</svg>`;
    return svg;
  }

  function svgPenalAvalon(params) {
    const {
      fasades, mountType, w_mm, d_mm, h_mm,
      fasadeHeights, fasadeAxis,
      gridCols, gridRows, gridColWidths,
      bodyColor, isBodyGlossy,
      trimColor
    } = params;
    const isWall = mountType === 'wall' || !mountType;
    const onFloor = mountType === 'floor';
    const hasLegs = mountType === 'floor_legs';
    const isGrid = fasadeAxis === 'grid';

    const SC = computeSmartScale(w_mm, d_mm, h_mm, {w:600, d:400, h:1500}, 240, 240);
    const W = SC.W_px;
    const H = SC.H_px;
