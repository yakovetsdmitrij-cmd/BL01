    svg += `<polygon points="${x0 + W},${y0} ${x0 + W + dx},${y0 - dy} ${x0 + W + dx},${y0 + H - dy} ${x0 + W},${y0 + H}" fill="rgba(0,0,0,0.20)" stroke="none"/>`;
