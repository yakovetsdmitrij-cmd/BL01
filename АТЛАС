try{ if(d.met!=null) p.setMetallicFactor(d.met); }catch(e){}
try{ if(d.rgh!=null) p.setRoughnessFactor(d.rgh); }catch(e){}
try{ if(p.baseColorTexture && d.bc!==undefined) p.baseColorTexture.setTexture(d.bc); }catch(e){}
try{ if(p.metallicRoughnessTexture && d.mr!==undefined) p.metallicRoughnessTexture.setTexture(d.mr); }catch(e){}
try{ if(m.normalTexture && d.nrm!==undefined) m.normalTexture.setTexture(d.nrm); }catch(e){}
}

// белая текстура-заглушка материала (из модели) — нужна, чтобы не терять UV-привязку
function phTex(m){ var d=DEF[defKey(m)]; return d?d.bc:undefined; }
// ---- покраска (эмаль): плоский цвет ----
function paint(re, hex, rough, dropMetalMaps){
matchMats(re).forEach(function(m){
var p=m.pbrMetallicRoughness; if(!p) return;
if(dropMetalMaps){
// рамка: снимаем все металл-текстуры
try{ if(p.baseColorTexture) p.baseColorTexture.setTexture(null); }catch(e){}
try{ if(p.metallicRoughnessTexture) p.metallicRoughnessTexture.setTexture(null); }catch(e){}
try{ if(m.normalTexture) m.normalTexture.setTexture(null); }catch(e){}
} else {
// корпус/фасад: НЕ обнуляем текстуру (иначе теряется UV) — ставим белую заглушку
var ph=phTex(m);
try{ if(p.baseColorTexture && ph!==undefined) p.baseColorTexture.setTexture(ph); }catch(e){}
}
try{ p.setBaseColorFactor(hex); }catch(e){}
try{ p.setMetallicFactor(0); }catch(e){}
try{ p.setRoughnessFactor(rough); }catch(e){}
});
}
// ---- шпон: текстура дерева (белый множитель, чтобы цвет был истинным) ----
function veneer(re, tex, rough){
matchMats(re).forEach(function(m){
var p=m.pbrMetallicRoughness; if(!p) return;
try{ p.setMetallicFactor(0); }catch(e){}
try{ p.setRoughnessFactor(rough!=null?rough:0.55); }catch(e){}
viewer.createTexture(encURL(tex)).then(function(t){
try{ p.baseColorTexture.setTexture(t); }catch(e){}
try{ p.setBaseColorFactor('#ffffff'); }catch(e){}
}).catch(function(){});
});
}
// ---- зеркало (для фасада): не обнуляем текстуру, ставим белую заглушку ----
function mirror(re){
matchMats(re).forEach(function(m){
var p=m.pbrMetallicRoughness; if(!p) return;
var ph=phTex(m);
try{ if(p.baseColorTexture && ph!==undefined) p.baseColorTexture.setTexture(ph); }catch(e){}
try{ p.setBaseColorFactor('#eef1f4'); }catch(e){}
try{ p.setMetallicFactor(1); }catch(e){}
try{ p.setRoughnessFactor(0.02); }catch(e){}
});
}
// ---- рамка: возврат к чёрному металлу (из дефолтов модели) ----
