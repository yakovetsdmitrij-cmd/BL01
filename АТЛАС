modal.querySelector('.mv-modal__title').textContent = title || '';
mv.setAttribute('src', url);
try{ mv.cameraOrbit='-22deg 74deg auto'; mv.fieldOfView='auto'; }catch(e){}
modal.classList.add('open');
modal.setAttribute('aria-hidden','false');
document.body.style.overflow = 'hidden';
}
function closeModelViewer(){
var modal = document.getElementById('mvModal');
var mv = document.getElementById('mvViewer');
modal.classList.remove('open');
modal.setAttribute('aria-hidden','true');
mv.removeAttribute('src'); // выгружаем модель
if(window.__mvReset) window.__mvReset(); // сброс выбранных материалов и меню
document.body.style.overflow = '';
}
