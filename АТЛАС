// ---- столешница: керамогранит ----
function applyTop(sw, rotate){
matchMats(TOP_RE).forEach(function(m){
var p=m.pbrMetallicRoughness; if(!p) return;
viewer.createTexture(encURL(sw.tex)).then(function(t){
try{ p.baseColorTexture.setTexture(t); }catch(e){}
try{ p.baseColorTexture.texture.sampler.setRotation(rotate ? Math.PI/2 : 0); }catch(e){} // керамогранит — портрет, повернуть; кварц — уже горизонтальный
try{ p.setBaseColorFactor('#ffffff'); }catch(e){}
}).catch(function(){});
});
}
// ---- antr: фиксированный антрацит ----
function setAntr(){
matchMats(ANTR_RE).forEach(function(m){
var p=m.pbrMetallicRoughness; if(!p) return;
try{ if(p.baseColorTexture) p.baseColorTexture.setTexture(null); }catch(e){}
try{ p.setBaseColorFactor(ANTHRACITE); }catch(e){}
try{ p.setMetallicFactor(0); }catch(e){}
try{ p.setRoughnessFactor(0.5); }catch(e){}
});
}

