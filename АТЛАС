<script>
// Превью-карточки AT: корпус и фасад — эмаль (Sea Shell), antr — антрацит.
// Рамку (black metal) и столешницу (cer) НЕ трогаем — показываем как в модели.
(function(){
var BODY_HEX = '#e7ddd0';       // G/M (24) Sea Shell
var ANTHR = '#293133';          // антрацит
var GLASS = '#eef1f4';          // зеркальное стекло
var CORPUS_RE=/^g\/m8$/i, FACADE_RE=/^g\/m-?f$/i, ANTR_RE=/^antr$/i;
var MIRROR_RE=/mirror|зеркал|a{5,}/i;   // зеркальное стекло (BL-M/EL-M/AT-M)
var FRAME_ENAMEL=/^g\/m1$/i;            // эмалевая рамка зеркала BL-M
var GAP_RE=/gap|зазор|\.0\d+$/i;        // зазор
function styleThumb(mv){
var model = mv.model; if(!model) return;
if(/-M\.glb/i.test(mv.getAttribute('src')||mv.src||'')) return; // зеркала запечены — показываем как есть
(model.materials||[]).forEach(function(m){
var nm=m.name||'', p=m.pbrMetallicRoughness; if(!p) return;
if(MIRROR_RE.test(nm)){                         // стекло — зеркальное (одинаково во всех коллекциях)
try{ if(p.baseColorTexture) p.baseColorTexture.setTexture(null); }catch(e){}
try{ if(m.normalTexture) m.normalTexture.setTexture(null); }catch(e){}
try{ if(p.metallicRoughnessTexture) p.metallicRoughnessTexture.setTexture(null); }catch(e){}
try{ p.setBaseColorFactor(GLASS); }catch(e){}
try{ p.setMetallicFactor(1); }catch(e){}
try{ p.setRoughnessFactor(0.02); }catch(e){}
return;
}
if(/^cer/i.test(nm) || /^black metal/i.test(nm) || CORPUS_RE.test(nm) || FACADE_RE.test(nm)){  // корпус/фасад/столешница/рамка — родной вид модели, НЕ трогаем
return;
}
if(GAP_RE.test(nm)){                             // зазор — мягкая тень
try{ if(p.baseColorTexture) p.baseColorTexture.setTexture(null); }catch(e){}
try{ p.setBaseColorFactor('#868079'); }catch(e){}
try{ p.setMetallicFactor(0); }catch(e){}
try{ p.setRoughnessFactor(0.55); }catch(e){}
return;
}
if(ANTR_RE.test(nm)){
try{ if(p.baseColorTexture) p.baseColorTexture.setTexture(null); }catch(e){}
try{ p.setBaseColorFactor(ANTHR); }catch(e){}
try{ p.setMetallicFactor(0); }catch(e){}
try{ p.setRoughnessFactor(0.5); }catch(e){}
return;
}
// black metal (рамка AT-M) и cer (столешница) — оставляем как есть (запечено в модели)
});
}
function hook(mv){
if(mv.__styled) return; mv.__styled = true;
if(mv.model) styleThumb(mv);
mv.addEventListener('load', function(){ styleThumb(mv); });
}
function run(){ document.querySelectorAll('model-viewer.mr3d-thumb').forEach(hook); }
if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', run); }
else { run(); }
})();

</script>
<script>
(function(){
  function build(){
    var pal=document.getElementById('mvSwatches'); if(!pal) return;
    if(pal.querySelector('.mv-ralwrap')) return;
    var dims=pal.querySelector('.mv-dims'); if(!dims) return;
    var wrap=document.createElement('div');
    wrap.className='mv-ralwrap'; wrap.style.paddingTop='8px';
    var lb=document.createElement('div');
    lb.className='mv-dims-lbl'; lb.textContent='Свой цвет — код RAL или NCS';
    var inp=document.createElement('input');
    inp.type='text'; inp.id='mvRal'; inp.className='mv-contact';
    inp.style.marginTop='0'; inp.autocomplete='off'; inp.maxLength=60;
    inp.placeholder='Укажите код';
    wrap.appendChild(lb); wrap.appendChild(inp);
    dims.parentNode.insertBefore(wrap, dims);
  }
  build(); setInterval(build,1200);
  var of=window.fetch;
  window.fetch=function(u,o){
    try{
      if(o && typeof o.body==='string' && o.body.charAt(0)==='{'){
        var el=document.getElementById('mvRal');
        var v=el&&el.value?el.value.trim():'';
        if(v){
          var d=JSON.parse(o.body);
          d['Свой цвет (RAL/NCS)']=v;
          var o2={}; for(var k in o) o2[k]=o[k];
          o2.body=JSON.stringify(d); o=o2;
        }
      }
    }catch(e){}
    return of.call(this,u,o);
  };
  var mv=document.getElementById('mvViewer');
  if(mv){
    new MutationObserver(function(){
      if(!mv.getAttribute('src')){ var el=document.getElementById('mvRal'); if(el) el.value=''; }
    }).observe(mv,{attributes:true,attributeFilter:['src']});
  }
})();
</script></body>
