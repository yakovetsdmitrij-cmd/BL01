var GOLD_HEX = '#c9a44c';      // золото по умолчанию
var GAP_RE   = /gap|зазор|\.0\d+$/i;                       // зазор/торец
var MIRROR_RE= /mirror|зеркал|a{5,}/i;                     // зеркало (на будущее)
var TRIM_RE  = /^(gold|leggold)$/i;                        // молдинг/ручки/наконечники ножек
var SKIP_RE  = /cer|marble|мрамор|glass|стекл|black metal/i; // столешница/стекло/чёрный металл — как в GLB
function styleThumb(mv){
var model = mv.model; if(!model) return;
var isMir = (model.materials||[]).some(function(m){ return MIRROR_RE.test(m.name||''); });
(model.materials || []).forEach(function(m){
var nm = m.name || '';
var p = m.pbrMetallicRoughness; if(!p) return;
if(MIRROR_RE.test(nm)){                       // зеркальное стекло (единый вид во всех коллекциях)
try{ if(p.baseColorTexture) p.baseColorTexture.setTexture(null); }catch(e){} try{ if(m.normalTexture) m.normalTexture.setTexture(null); }catch(e){} try{ if(p.metallicRoughnessTexture) p.metallicRoughnessTexture.setTexture(null); }catch(e){} try{ p.setBaseColorFactor('#eef1f4'); }catch(e){} try{ p.setMetallicFactor(1); }catch(e){} try{ p.setRoughnessFactor(0.02); }catch(e){}
return;
}
if(isMir) return;                             // у зеркал рамка/молдинг — как запечено (единый кремовый)
if(TRIM_RE.test(nm)){                          // молдинг + ручки + наконечники ножек — золото
try{ if(p.baseColorTexture) p.baseColorTexture.setTexture(null); }catch(e){} try{ p.setBaseColorFactor(GOLD_HEX); }catch(e){} try{ p.setMetallicFactor(1); }catch(e){} try{ p.setRoughnessFactor(0.06); }catch(e){}
return;
}
if(SKIP_RE.test(nm)) return;                  // столешница — как в GLB
if(GAP_RE.test(nm)){                           // зазор — цвет корпуса, слегка затемнён (мягкая тень)
try{ if(p.baseColorTexture) p.baseColorTexture.setTexture(null); }catch(e){}
try{ p.setBaseColorFactor('#868079'); }catch(e){}
try{ p.setMetallicFactor(0); }catch(e){}
try{ p.setRoughnessFactor(0.55); }catch(e){}
return;
}
// корпус и стойки ножек (Leg) — эмаль Sea Shell
try{ if(p.baseColorTexture) p.baseColorTexture.setTexture(null); }catch(e){}
try{ p.setBaseColorFactor(BODY_HEX); }catch(e){}
try{ p.setMetallicFactor(0); }catch(e){}
try{ p.setRoughnessFactor(BODY_ROUGH); }catch(e){}
});
}
function hook(mv){
if(mv.__styled) return; mv.__styled = true;
if(mv.model) styleThumb(mv);
mv.addEventListener('load', function(){ styleThumb(mv); });
}
function run(){ document.querySelectorAll('model-viewer.mr3d-thumb').forEach(hook); }
if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', run); }
else { run(); }
})();
</script>
</body>
</html>
